<Window x:Class="SmartPOS.LicenseTool.Gui.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RoboVAI POS License Tool" Height="560" Width="820"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="RoboVAI POS License Tool" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="Generate offline activation codes (keep the private key secret)." Opacity="0.8" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Generate Activation Code" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Private Key" VerticalAlignment="Center" Margin="0,0,10,10"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="PrivateKeyBox" Height="28" Margin="0,0,10,10"/>
                    <Button Grid.Row="0" Grid.Column="2" Content="Browse" Height="28" Padding="12,0" Margin="0,0,0,10" Click="OnBrowsePrivateKey"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Customer" VerticalAlignment="Center" Margin="0,0,10,10"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="CustomerBox" Height="28" Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Device ID" VerticalAlignment="Center" Margin="0,0,10,10"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="DeviceIdBox" Height="28" Margin="0,0,10,10"/>
                    <Button Grid.Row="2" Grid.Column="2" Content="Paste" Height="28" Padding="12,0" Margin="0,0,0,10" Click="OnPasteDeviceId"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Duration" VerticalAlignment="Center" Margin="0,0,10,10"/>
                    <ComboBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" x:Name="DurationBox" Height="28" Margin="0,0,0,10" SelectionChanged="OnDurationChanged"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Custom Days" VerticalAlignment="Center" Margin="0,0,10,10"/>
                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="CustomDaysBox" Height="28" Margin="0,0,10,10" IsEnabled="False"/>
                    <Button Grid.Row="4" Grid.Column="2" Content="14" Height="28" Padding="12,0" Margin="0,0,0,10" Click="OnSet14Days" IsEnabled="False" x:Name="Set14Button"/>

                    <Button Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Content="Generate Code" Height="34" Margin="0,6,0,10" Click="OnGenerate"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Result" VerticalAlignment="Top" Margin="0,0,10,0"/>
                    <TextBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" x:Name="TokenBox" Height="120" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

                    <StackPanel Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <TextBlock x:Name="ExpiryText" VerticalAlignment="Center" Opacity="0.8" Margin="0,0,12,0"/>
                        <Button Content="Copy" Width="100" Height="30" Click="OnCopy"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="Keys (One Time)" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Output Folder" VerticalAlignment="Center" Margin="0,0,10,10"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="KeyOutDirBox" Height="28" Margin="0,0,10,10"/>
                    <Button Grid.Row="0" Grid.Column="2" Content="Browse" Height="28" Padding="12,0" Margin="0,0,0,10" Click="OnBrowseKeyOutDir"/>

                    <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Content="Generate Keys" Height="34" Margin="0,6,0,10" Click="OnGenerateKeys"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Notes" VerticalAlignment="Top" Margin="0,0,10,0"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Height="120" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True">
Keep `smartpos-license-private.pem` secret.
Do NOT ship it to customers.
If you lose it, you can't regenerate old licenses.
                    </TextBox>

                    <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" x:Name="StatusText" Foreground="DarkGreen" TextWrapping="Wrap"/>
                </Grid>
            </GroupBox>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Close" Width="110" Height="32" Click="OnClose"/>
        </StackPanel>
    </Grid>
</Window>

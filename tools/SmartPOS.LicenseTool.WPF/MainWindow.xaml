<Window x:Class="SmartPOS.LicenseTool.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RoboVAI POS - License Tool"
        Height="620"
        Width="820"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="أداة توليد أكواد التفعيل (Offline)"
                       FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="تُولّد كود مُوقّع رقمياً للعميل بناءً على Device ID والمدة."
                       Opacity="0.8"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <!-- Login Panel -->
            <Border x:Name="LoginPanel" CornerRadius="12" BorderBrush="#DDDDDD" BorderThickness="1" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="تسجيل دخول" FontSize="16" FontWeight="SemiBold"/>

                    <StackPanel Grid.Row="1" Margin="0,12,0,0">
                        <TextBlock Text="Email"/>
                        <TextBox x:Name="EmailBox" />
                        <TextBlock Text="Password"/>
                        <PasswordBox x:Name="PasswordBox"/>

                        <TextBlock x:Name="LoginError" Foreground="DarkRed" Visibility="Collapsed" TextWrapping="Wrap"/>

                        <Button Content="دخول" Click="Login_Click" Width="140" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Generator Panel -->
            <Border x:Name="GeneratorPanel" Visibility="Collapsed" CornerRadius="12" BorderBrush="#DDDDDD" BorderThickness="1" Padding="18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="بيانات العميل" FontSize="16" FontWeight="SemiBold"/>

                        <TextBlock Text="اسم العميل"/>
                        <TextBox x:Name="CustomerBox"/>

                        <TextBlock Text="Device ID"/>
                        <DockPanel>
                            <TextBox x:Name="DeviceIdBox" DockPanel.Dock="Right"/>
                            <Button Content="لصق" Click="PasteDeviceId_Click" Width="90" Margin="10,0,0,12"/>
                        </DockPanel>

                        <TextBlock Text="ملف الـ Private Key (PEM)"/>
                        <DockPanel>
                            <TextBox x:Name="PrivateKeyPathBox" IsReadOnly="True" DockPanel.Dock="Right"/>
                            <Button Content="اختيار" Click="BrowseKey_Click" Width="90" Margin="10,0,0,12"/>
                        </DockPanel>

                        <TextBlock Text="المدة"/>
                        <StackPanel>
                            <RadioButton x:Name="MonthlyRadio" Content="شهر" IsChecked="True"/>
                            <RadioButton x:Name="SixRadio" Content="6 شهور"/>
                            <RadioButton x:Name="YearlyRadio" Content="سنة"/>
                            <RadioButton x:Name="TrialRadio" Content="تجربة 14 يوم"/>
                            <DockPanel Margin="0,6,0,0">
                                <RadioButton x:Name="CustomDaysRadio" Content="أيام مخصصة" DockPanel.Dock="Right"/>
                                <TextBox x:Name="CustomDaysBox" Width="120" Margin="10,0,0,12" Text="14"/>
                            </DockPanel>
                        </StackPanel>

                        <TextBlock x:Name="GenError" Foreground="DarkRed" Visibility="Collapsed" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ExpiryInfo" Opacity="0.85" TextWrapping="Wrap"/>

                        <Button Content="توليد الكود" Click="Generate_Click" Height="36"/>
                        <Button Content="تسجيل خروج" Click="Logout_Click" Width="140" HorizontalAlignment="Left"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="كود التفعيل" FontSize="16" FontWeight="SemiBold"/>
                        <TextBox x:Name="CodeBox" Height="360" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="نسخ" Click="CopyCode_Click" Width="120"/>
                            <Button Content="مسح" Click="Clear_Click" Width="120" Margin="10,6,0,0"/>
                        </StackPanel>

                        <TextBlock Text="ملاحظة: لا تُرسل ملف الـ private key لأي عميل." Opacity="0.75" Margin="0,12,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>

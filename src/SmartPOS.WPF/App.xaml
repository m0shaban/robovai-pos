<Application x:Class="SmartPOS.WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:SmartPOS.WPF.Converters">
        <Application.Resources>
                <ResourceDictionary>
                        <ResourceDictionary.MergedDictionaries>
                                <!-- Material Design -->
                                <materialDesign:BundledTheme BaseTheme="Dark"
                                                             PrimaryColor="Blue"
                                                             SecondaryColor="DeepPurple"/>
                                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml"/>
                        </ResourceDictionary.MergedDictionaries>

                        <!-- Converters -->
                        <converters:BoolToStatusConverter x:Key="BoolToStatusConverter"/>
                        <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
                        <converters:BoolNegationConverter x:Key="BoolNegationConverter"/>
                        <converters:BoolNegationConverter x:Key="InverseBooleanConverter"/>
                        <converters:BoolNegationConverter x:Key="InverseBoolConverter"/>
                        <converters:StockToColorConverter x:Key="StockToColorConverter"/>
                        <converters:StockToTextConverter x:Key="StockToTextConverter"/>
                        <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
                        <converters:ExpenseCategoryToArabicConverter x:Key="ExpenseCategoryToArabicConverter"/>
                        <converters:UnitTypeToArabicConverter x:Key="UnitTypeToArabicConverter"/>
                        <converters:OrderTypeToArabicConverter x:Key="OrderTypeToArabicConverter"/>
                        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
                        <converters:NullToStringConverter x:Key="NullToStringConverter"/>
                        <converters:EqualityMultiConverter x:Key="EqualityMultiConverter"/>
                        <converters:DifferenceToColorConverter x:Key="DifferenceToColorConverter"/>
                        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
                        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
                        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>

                        <!-- Animations -->
                        <Storyboard x:Key="FadeInAnimation">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0"
                                                 To="1"
                                                 Duration="0:0:0.4"/>
                        </Storyboard>

                        <Storyboard x:Key="SlideInAnimation">
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                 From="50"
                                                 To="0"
                                                 Duration="0:0:0.3"/>
                        </Storyboard>

                        <!-- ============================================ -->
                        <!-- Al‑Atmani 2026 (Dark • Glass • Bento • Touch) -->
                        <!-- ============================================ -->

                        <!-- Core Colors -->
                        <Color x:Key="AlAtmani.DeepSpaceBlue">#0B1120</Color>
                        <Color x:Key="AlAtmani.ElectricCyan">#3B82F6</Color>
                        <Color x:Key="AlAtmani.Surface">#1E293B</Color>
                        <Color x:Key="AlAtmani.Surface2">#334155</Color>
                        <Color x:Key="AlAtmani.TextPrimary">#F3F4F6</Color>
                        <Color x:Key="AlAtmani.TextSecondary">#9CA3AF</Color>
                        <Color x:Key="AlAtmani.Border">#374151</Color>

                        <!-- Material Design Root Dynamic Defaults -->
                        <SolidColorBrush x:Key="MaterialDesignPaper" Color="#1E293B"/>
                        <SolidColorBrush x:Key="MaterialDesignBackground" Color="#0B1120"/>
                        <SolidColorBrush x:Key="MaterialDesignCardBackground" Color="#1E293B"/>
                        <SolidColorBrush x:Key="MaterialDesignBody" Color="#F3F4F6"/>

                        <!-- Brushes -->
                        <SolidColorBrush x:Key="AlAtmani.BackgroundBrush"
                                         Color="{StaticResource AlAtmani.DeepSpaceBlue}"/>
                        <SolidColorBrush x:Key="AlAtmani.SurfaceBrush"
                                         Color="{StaticResource AlAtmani.Surface}"/>
                        <SolidColorBrush x:Key="AlAtmani.Surface2Brush"
                                         Color="{StaticResource AlAtmani.Surface2}"/>
                        <SolidColorBrush x:Key="AlAtmani.AccentBrush"
                                         Color="{StaticResource AlAtmani.ElectricCyan}"/>
                        <SolidColorBrush x:Key="AlAtmani.TextPrimaryBrush"
                                         Color="{StaticResource AlAtmani.TextPrimary}"/>
                        <SolidColorBrush x:Key="AlAtmani.TextSecondaryBrush"
                                         Color="{StaticResource AlAtmani.TextSecondary}"/>
                        <SolidColorBrush x:Key="AlAtmani.BorderBrush"
                                         Color="{StaticResource AlAtmani.Border}"/>

                        <!-- Compatibility: legacy MaterialDesign/SpaceTheme hue brushes -->
                        <SolidColorBrush x:Key="PrimaryHueMidBrush"
                                         Color="{StaticResource AlAtmani.ElectricCyan}"/>
                        <SolidColorBrush x:Key="PrimaryHueLightBrush"
                                         Color="{StaticResource AlAtmani.ElectricCyan}"/>
                        <SolidColorBrush x:Key="PrimaryHueDarkBrush"
                                         Color="#1D4ED8"/>

                        <SolidColorBrush x:Key="SecondaryHueMidBrush"
                                         Color="{StaticResource AlAtmani.ElectricCyan}"/>
                        <SolidColorBrush x:Key="SecondaryHueLightBrush"
                                         Color="{StaticResource AlAtmani.ElectricCyan}"/>
                        <SolidColorBrush x:Key="SecondaryHueDarkBrush"
                                         Color="#1D4ED8"/>

                        <!-- Acrylic / Glass (visual approximation of blur) -->
                        <SolidColorBrush x:Key="AlAtmani.AcrylicBrush"
                                         Color="#1E293B"
                                         Opacity="0.92"/>
                        <SolidColorBrush x:Key="AlAtmani.AcrylicBrushStrong"
                                         Color="#0F172A"
                                         Opacity="0.96"/>
                        <SolidColorBrush x:Key="AlAtmani.AcrylicBorderBrush"
                                         Color="#374151"/>

                        <!-- Glow Effects -->
                        <DropShadowEffect x:Key="AlAtmani.CyanGlow"
                                          x:Shared="False"
                                          Color="#10B981"
                                          BlurRadius="20"
                                          ShadowDepth="0"
                                          Opacity="0.35"/>

                        <!-- New Gradients -->
                        <LinearGradientBrush x:Key="AlAtmani.DeepGradientOverlay" StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="#000F172A" Offset="0"/>
                            <GradientStop Color="#DF0F172A" Offset="0.6"/>
                            <GradientStop Color="#FF0F172A" Offset="1"/>
                        </LinearGradientBrush>

                        <!-- Global Base Styles -->
                        <Style TargetType="TextBlock"
                               x:Key="HeaderText">
                                <Setter Property="FontSize"
                                        Value="28"/>
                                <Setter Property="FontWeight"
                                        Value="Bold"/>
                                <Setter Property="Margin"
                                        Value="0,0,0,16"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource AlAtmani.TextPrimaryBrush}"/>
                        </Style>

                        <Style TargetType="TextBlock"
                               x:Key="SubHeaderText">
                                <Setter Property="FontSize"
                                        Value="20"/>
                                <Setter Property="FontWeight"
                                        Value="SemiBold"/>
                                <Setter Property="Margin"
                                        Value="0,0,0,12"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource AlAtmani.TextPrimaryBrush}"/>
                        </Style>

                        <Style TargetType="TextBlock"
                               x:Key="StatLabel">
                                <Setter Property="FontSize"
                                        Value="14"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource AlAtmani.TextSecondaryBrush}"/>
                        </Style>

                        <Style TargetType="TextBlock"
                               x:Key="StatValue">
                                <Setter Property="FontSize"
                                        Value="28"/>
                                <Setter Property="FontWeight"
                                        Value="Bold"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource AlAtmani.AccentBrush}"/>
                        </Style>

                        <!-- Typography helpers (Al‑Atmani overrides) -->
                        <Style x:Key="AlAtmani.HeaderText"
                               TargetType="TextBlock"
                               BasedOn="{StaticResource HeaderText}">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource AlAtmani.TextPrimaryBrush}"/>
                        </Style>

                        <Style x:Key="AlAtmani.SubHeaderText"
                               TargetType="TextBlock"
                               BasedOn="{StaticResource SubHeaderText}">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource AlAtmani.TextPrimaryBrush}"/>
                        </Style>

                        <!-- Glass Card -->
                        <Style x:Key="AlAtmani.GlassCard"
                               TargetType="materialDesign:Card">
                                <Setter Property="Background"
                                        Value="{DynamicResource AlAtmani.SurfaceBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource AlAtmani.TextPrimaryBrush}"/>
                                <Setter Property="UniformCornerRadius"
                                        Value="20"/>
                                <Setter Property="Padding"
                                        Value="20"/>
                                <Setter Property="Margin"
                                        Value="0,0,0,14"/>
                                <Setter Property="BorderBrush"
                                        Value="{DynamicResource AlAtmani.BorderBrush}"/>
                                <Setter Property="BorderThickness"
                                        Value="1"/>
                                <Setter Property="materialDesign:ElevationAssist.Elevation"
                                        Value="Dp2"/>
                                <Setter Property="RenderTransform">
                                        <Setter.Value>
                                                <ScaleTransform/>
                                        </Setter.Value>
                                </Setter>
                                <Setter Property="RenderTransformOrigin"
                                        Value="0.5,0.5"/>
                                <Style.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                                <Setter Property="materialDesign:ElevationAssist.Elevation"
                                                         Value="Dp4"/>
                                                <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                                <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                                         To="1.008"
                                                                                         Duration="0:0:0.12"/>
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                                         To="1.008"
                                                                                         Duration="0:0:0.12"/>
                                                                </Storyboard>
                                                        </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                                <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                                         To="1.0"
                                                                                         Duration="0:0:0.12"/>
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                                         To="1.0"
                                                                                         Duration="0:0:0.12"/>
                                                                </Storyboard>
                                                        </BeginStoryboard>
                                                </Trigger.ExitActions>
                                        </Trigger>
                                </Style.Triggers>
                        </Style>

                        <!-- Acrylic Sidebar / Popup Surface -->
                        <Style x:Key="AlAtmani.AcrylicSurface"
                               TargetType="Border">
                                <Setter Property="Background"
                                        Value="{DynamicResource AlAtmani.SurfaceBrush}"/>
                                <Setter Property="BorderBrush"
                                        Value="{DynamicResource AlAtmani.BorderBrush}"/>
                                <Setter Property="BorderThickness"
                                        Value="1"/>
                                <Setter Property="CornerRadius"
                                        Value="20"/>
                                <Setter Property="Padding"
                                        Value="16"/>
                        </Style>

                        <!-- Soft Button -->
                        <Style x:Key="AlAtmani.SoftButton"
                               TargetType="Button"
                               BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                <Setter Property="Height"
                                        Value="46"/>
                                <Setter Property="FontSize"
                                        Value="15"/>
                                <Setter Property="FontWeight"
                                        Value="SemiBold"/>
                                <Setter Property="Cursor"
                                        Value="Hand"/>
                                <Setter Property="Padding"
                                        Value="18,0"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource AlAtmani.TextPrimaryBrush}"/>
                                <Setter Property="Background"
                                        Value="{DynamicResource AlAtmani.Surface2Brush}"/>
                                <Setter Property="BorderBrush"
                                        Value="{DynamicResource AlAtmani.BorderBrush}"/>
                                <Setter Property="BorderThickness"
                                        Value="1"/>
                                <Setter Property="materialDesign:ButtonAssist.CornerRadius"
                                        Value="16"/>
                                <Setter Property="materialDesign:ElevationAssist.Elevation"
                                        Value="Dp2"/>
                                <Setter Property="RenderTransform">
                                        <Setter.Value>
                                                <ScaleTransform/>
                                        </Setter.Value>
                                </Setter>
                                <Setter Property="RenderTransformOrigin"
                                        Value="0.5,0.5"/>
                                <Style.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                                <Setter Property="materialDesign:ElevationAssist.Elevation"
                                                         Value="Dp4"/>
                                                <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                                <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                                         To="1.02"
                                                                                         Duration="0:0:0.12"/>
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                                         To="1.02"
                                                                                         Duration="0:0:0.12"/>
                                                                </Storyboard>
                                                        </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                                <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                                         To="1.0"
                                                                                         Duration="0:0:0.12"/>
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                                         To="1.0"
                                                                                         Duration="0:0:0.12"/>
                                                                </Storyboard>
                                                        </BeginStoryboard>
                                                </Trigger.ExitActions>
                                        </Trigger>
                                </Style.Triggers>
                        </Style>

                        <!-- Toolbar / Icon Button (Prevents Icon Clipping) -->
                        <Style x:Key="AlAtmani.ToolButton"
                               TargetType="Button"
                               BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                <Setter Property="Height" Value="48"/>
                                <Setter Property="Width" Value="48"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Foreground" Value="{DynamicResource AlAtmani.TextPrimaryBrush}"/>
                                <Setter Property="Background" Value="{DynamicResource AlAtmani.Surface2Brush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AlAtmani.BorderBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="14"/>
                                <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp1"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>

                        <!-- Checkout Button (Massive + glowing) -->
                        <Style x:Key="AlAtmani.CheckoutButton"
                               TargetType="Button"
                               BasedOn="{StaticResource AlAtmani.SoftButton}">
                                <Setter Property="Height"
                                        Value="76"/>
                                <Setter Property="FontSize"
                                        Value="22"/>
                                <Setter Property="FontWeight"
                                        Value="Bold"/>
                                <Setter Property="materialDesign:ButtonAssist.CornerRadius"
                                        Value="20"/>
                                <Setter Property="Background">
                                        <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0"
                                                                     EndPoint="1,1">
                                                         <GradientStop Color="#10B981"
                                                                       Offset="0"/>
                                                         <GradientStop Color="#059669"
                                                                       Offset="1"/>
                                                </LinearGradientBrush>
                                        </Setter.Value>
                                </Setter>
                                <Setter Property="BorderBrush"
                                        Value="#34D399"/>
                                <Setter Property="Foreground"
                                        Value="White"/>
                                <Setter Property="Effect"
                                        Value="{StaticResource AlAtmani.CyanGlow}"/>
                        </Style>

                        <!-- Modern Button Style (compat alias for Al‑Atmani) -->
                        <Style x:Key="ModernButton"
                               TargetType="Button"
                               BasedOn="{StaticResource AlAtmani.SoftButton}">
                                <Setter Property="Height"
                                        Value="45"/>
                                <Setter Property="FontSize"
                                        Value="15"/>
                                <Setter Property="FontWeight"
                                        Value="SemiBold"/>
                                <Setter Property="Padding"
                                        Value="18,0"/>
                                <Setter Property="materialDesign:ButtonAssist.CornerRadius"
                                        Value="16"/>
                        </Style>

                        <!-- Global DataGrid Scaling for UI/UX -->
                        <Style TargetType="DataGrid" BasedOn="{StaticResource MaterialDesignDataGrid}">
                                <Setter Property="RowHeight" Value="52"/>
                                <Setter Property="FontSize" Value="15"/>
                                <Setter Property="ColumnHeaderHeight" Value="44"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                        </Style>

                        <!-- Modern Card Style (compat alias for Al‑Atmani) -->
                        <Style x:Key="ModernCard"
                               TargetType="materialDesign:Card"
                               BasedOn="{StaticResource AlAtmani.GlassCard}">
                                <Setter Property="Padding"
                                        Value="20"/>
                                <Setter Property="Margin"
                                        Value="0,0,0,14"/>
                        </Style>

                </ResourceDictionary>
        </Application.Resources>
</Application>

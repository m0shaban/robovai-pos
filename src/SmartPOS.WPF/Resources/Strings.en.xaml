<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!-- Layout FlowDirection -->
    <FlowDirection x:Key="AppFlowDirection">LeftToRight</FlowDirection>
    <HorizontalAlignment x:Key="AppHeaderAlignment">Left</HorizontalAlignment>
    <HorizontalAlignment x:Key="AppReverseHeaderAlignment">Right</HorizontalAlignment>

    <!-- App Identity -->
    <system:String x:Key="Loc_AppSubtitle">Point of Sale &amp; Store Management System</system:String>
    <system:String x:Key="Loc_AppVersion">v6.0 PRO</system:String>

    <!-- Navigation Menu (Sidebar) -->
    <system:String x:Key="Loc_NavDashboard">Dashboard</system:String>
    <system:String x:Key="Loc_NavPOS">Point of Sale (POS)</system:String>
    <system:String x:Key="Loc_NavSessions">Sessions Management</system:String>
    <system:String x:Key="Loc_NavShifts">Shifts Management</system:String>
    <system:String x:Key="Loc_NavInvoices">Invoices &amp; Sales</system:String>
    <system:String x:Key="Loc_NavReturns">Returns &amp; Refunds</system:String>
    <system:String x:Key="Loc_NavPurchases">Purchases</system:String>
    <system:String x:Key="Loc_NavExpenses">Expenses</system:String>
    <system:String x:Key="Loc_NavProducts">Products</system:String>
    <system:String x:Key="Loc_NavStockAudit">Stock Audit</system:String>
    <system:String x:Key="Loc_NavCategories">Categories</system:String>
    <system:String x:Key="Loc_NavSuppliers">Suppliers</system:String>
    <system:String x:Key="Loc_NavCustomers">Customers</system:String>
    <system:String x:Key="Loc_NavLoyalty">Loyalty Points</system:String>
    <system:String x:Key="Loc_NavReports">Reports</system:String>
    <system:String x:Key="Loc_NavUsers">Users Management</system:String>
    <system:String x:Key="Loc_NavAuditLog">Activity Log</system:String>
    <system:String x:Key="Loc_NavSettings">Settings</system:String>
    <system:String x:Key="Loc_NavFeatures">System Features</system:String>
    <system:String x:Key="Loc_NavLogout">Logout</system:String>
    <system:String x:Key="Loc_NavCloseApp">Exit App</system:String>

    <!-- Header Actions & Controls (Top Bar) -->
    <system:String x:Key="Loc_Notifications">Notifications</system:String>
    <system:String x:Key="Loc_Settings">Settings</system:String>
    <system:String x:Key="Loc_ThemeToggle">Toggle Theme (Dark / Light / System)</system:String>
    <system:String x:Key="Loc_ZoomOut">Zoom Out</system:String>
    <system:String x:Key="Loc_ZoomIn">Zoom In</system:String>
    <system:String x:Key="Loc_ZoomReset">Reset Zoom (100%)</system:String>
    <system:String x:Key="Loc_Minimize">Minimize</system:String>
    <system:String x:Key="Loc_RestoreMaximize">Maximize / Restore</system:String>
    <system:String x:Key="Loc_Close">Close</system:String>

    <!-- Language Names -->
    <system:String x:Key="Loc_LanguageArabic">العربية (Arabic)</system:String>
    <system:String x:Key="Loc_LanguageEnglish">English</system:String>
    <system:String x:Key="Loc_LanguageSelectTitle">Interface Language</system:String>
    <system:String x:Key="Loc_LanguageSelectDesc">Select the entire system UI language with automatic layout direction switching (RTL for Arabic / LTR for English)</system:String>

    <!-- Common Words & Actions -->
    <system:String x:Key="Loc_Save">Save</system:String>
    <system:String x:Key="Loc_Cancel">Cancel</system:String>
    <system:String x:Key="Loc_Add">Add New</system:String>
    <system:String x:Key="Loc_Edit">Edit</system:String>
    <system:String x:Key="Loc_Delete">Delete</system:String>
    <system:String x:Key="Loc_Search">Search...</system:String>
    <system:String x:Key="Loc_Print">Print</system:String>
    <system:String x:Key="Loc_Export">Export</system:String>
    <system:String x:Key="Loc_Total">Total</system:String>
    <system:String x:Key="Loc_SubTotal">Subtotal</system:String>
    <system:String x:Key="Loc_Discount">Discount</system:String>
    <system:String x:Key="Loc_Tax">Tax</system:String>
    <system:String x:Key="Loc_Paid">Paid</system:String>
    <system:String x:Key="Loc_Remaining">Remaining</system:String>
    <system:String x:Key="Loc_Quantity">Quantity</system:String>
    <system:String x:Key="Loc_Price">Price</system:String>
    <system:String x:Key="Loc_Barcode">Barcode</system:String>
    <system:String x:Key="Loc_Status">Status</system:String>
    <system:String x:Key="Loc_Date">Date</system:String>
    <system:String x:Key="Loc_Active">Active</system:String>
    <system:String x:Key="Loc_Inactive">Inactive</system:String>
    <system:String x:Key="Loc_ConfirmCloseTitle">Confirm Exit</system:String>
    <system:String x:Key="Loc_ConfirmCloseMessage">Are you sure you want to close the application?</system:String>
    <system:String x:Key="Loc_ConfirmLogoutTitle">Logout</system:String>
    <system:String x:Key="Loc_ConfirmLogoutMessage">Do you want to log out and return to the login screen?</system:String>
</ResourceDictionary>

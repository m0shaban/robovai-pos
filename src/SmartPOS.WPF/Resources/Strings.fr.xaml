    <system:String x:Key="Loc_53bc7a84">Programme de fidélisation et de récompenses clients</system:String>
    <system:String x:Key="Loc_b5e76142">Les points de fidélité sont automatiquement calculés à chaque achat, les clients sont classés en niveaux (Argent, Or, Platine) et les points sont échangés contre des remises instantanées.</system:String>
    <system:String x:Key="Loc_a6cc947c">Gestion des achats et des fournisseurs</system:String>
    <system:String x:Key="Loc_9dd3e44d">Enregistrez les bons de commande, suivez les paiements et les dettes des fournisseurs, augmentez automatiquement les stocks et mettez à jour le coût moyen d&apos;achat.</system:String>
    <system:String x:Key="Loc_576d8a05">Retours de factures partiels et complets</system:String>

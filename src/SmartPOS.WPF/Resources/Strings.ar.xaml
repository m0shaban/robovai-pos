    <system:String x:Key="Loc_Barcode">الباركود</system:String>
    <system:String x:Key="Loc_Status">الحالة</system:String>
    <system:String x:Key="Loc_Date">التاريخ</system:String>
    <system:String x:Key="Loc_Active">نشط</system:String>
    <system:String x:Key="Loc_Inactive">معطل</system:String>
    <system:String x:Key="Loc_ConfirmCloseTitle">تأكيد الإغلاق</system:String>
    <system:String x:Key="Loc_ConfirmCloseMessage">هل أنت متأكد من إغلاق البرنامج؟</system:String>
    <system:String x:Key="Loc_ConfirmLogoutTitle">تسجيل الخروج</system:String>
    <system:String x:Key="Loc_ConfirmLogoutMessage">هل تريد تسجيل الخروج والعودة لشاشة الدخول؟</system:String>
</ResourceDictionary>

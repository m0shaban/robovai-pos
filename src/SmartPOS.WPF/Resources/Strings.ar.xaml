    <system:String x:Key="Loc_ZoomOut">تصغير الواجهة (Zoom Out)</system:String>
    <system:String x:Key="Loc_ZoomIn">تكبير الواجهة (Zoom In)</system:String>
    <system:String x:Key="Loc_ZoomReset">إعادة ضبط حجم الواجهة (100%)</system:String>
    <system:String x:Key="Loc_Minimize">تصغير</system:String>
    <system:String x:Key="Loc_RestoreMaximize">تكبير / استعادة</system:String>
    <system:String x:Key="Loc_Close">إغلاق</system:String>

    <!-- Language Names -->
    <system:String x:Key="Loc_LanguageArabic">العربية (Arabic)</system:String>
    <system:String x:Key="Loc_LanguageEnglish">الإنجليزية (English)</system:String>

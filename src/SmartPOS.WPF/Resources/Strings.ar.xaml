<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!-- Layout FlowDirection -->
    <FlowDirection x:Key="AppFlowDirection">RightToLeft</FlowDirection>
    <HorizontalAlignment x:Key="AppHeaderAlignment">Right</HorizontalAlignment>
    <HorizontalAlignment x:Key="AppReverseHeaderAlignment">Left</HorizontalAlignment>

    <!-- App Identity -->
    <system:String x:Key="Loc_AppSubtitle">نظام نقاط البيع وإدارة المتاجر المتكامل</system:String>
    <system:String x:Key="Loc_AppVersion">v6.0 PRO</system:String>

    <!-- Navigation Menu (القائمة الجانبية) -->
    <system:String x:Key="Loc_NavDashboard">لوحة المعلومات</system:String>
    <system:String x:Key="Loc_NavPOS">نقطة البيع (POS)</system:String>
    <system:String x:Key="Loc_NavSessions">إدارة الجلسات</system:String>
    <system:String x:Key="Loc_NavShifts">إدارة الورديات</system:String>
    <system:String x:Key="Loc_NavInvoices">الفواتير</system:String>
    <system:String x:Key="Loc_NavReturns">المرتجعات</system:String>
    <system:String x:Key="Loc_NavPurchases">المشتريات</system:String>
    <system:String x:Key="Loc_NavExpenses">المصروفات</system:String>
    <system:String x:Key="Loc_NavProducts">المنتجات</system:String>
    <system:String x:Key="Loc_NavStockAudit">جرد المخزون</system:String>
    <system:String x:Key="Loc_NavCategories">الأقسام</system:String>
    <system:String x:Key="Loc_NavSuppliers">الموردين</system:String>
    <system:String x:Key="Loc_NavCustomers">العملاء</system:String>
    <system:String x:Key="Loc_NavLoyalty">نقاط الولاء</system:String>
    <system:String x:Key="Loc_NavReports">التقارير</system:String>
    <system:String x:Key="Loc_NavUsers">إدارة المستخدمين</system:String>
    <system:String x:Key="Loc_NavAuditLog">سجل النشاط</system:String>
    <system:String x:Key="Loc_NavSettings">الإعدادات</system:String>
    <system:String x:Key="Loc_NavFeatures">مميزات البرنامج</system:String>
    <system:String x:Key="Loc_NavLogout">تسجيل الخروج</system:String>
    <system:String x:Key="Loc_NavCloseApp">إغلاق البرنامج</system:String>

    <!-- Header Actions & Controls (الشريط العلوي) -->
    <system:String x:Key="Loc_Notifications">الإشعارات</system:String>
    <system:String x:Key="Loc_Settings">الإعدادات</system:String>

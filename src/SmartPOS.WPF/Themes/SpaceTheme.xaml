<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

        <!-- 🎨 Primary Color Brushes for Material Design -->
        <SolidColorBrush x:Key="PrimaryHueMidBrush"
                        Color="#00BCD4"/>
        <SolidColorBrush x:Key="PrimaryHueLightBrush"
                        Color="#80DEEA"/>
        <SolidColorBrush x:Key="PrimaryHueDarkBrush"
                        Color="#0097A7"/>

        <!-- 🎨 Secondary Color Brushes for Material Design -->
        <SolidColorBrush x:Key="SecondaryHueMidBrush"
                        Color="#FF2E97"/>
        <SolidColorBrush x:Key="SecondaryHueLightBrush"
                        Color="#FF7DBB"/>
        <SolidColorBrush x:Key="SecondaryHueDarkBrush"
                        Color="#C4006A"/>

        <!-- 🌟 Material Design Shadow Effects -->
        <DropShadowEffect x:Key="MaterialDesignShadowDepth1"
                          BlurRadius="5"
                          ShadowDepth="1"
                          Direction="270"
                          Color="#000000"
                          Opacity="0.26"/>

        <DropShadowEffect x:Key="MaterialDesignShadowDepth2"
                          BlurRadius="8"
                          ShadowDepth="2"
                          Direction="270"
                          Color="#000000"
                          Opacity="0.26"/>

        <DropShadowEffect x:Key="MaterialDesignShadowDepth3"
                          BlurRadius="14"
                          ShadowDepth="4"
                          Direction="270"
                          Color="#000000"
                          Opacity="0.26"/>

        <!-- �🌌 Space Theme Colors -->
        <Color x:Key="SpaceBlack">#0A0E27</Color>
        <Color x:Key="SpaceDeep">#1A1F3A</Color>
        <Color x:Key="SpaceGray">#2C3454</Color>

        <!-- Neon Colors -->
        <Color x:Key="NeonCyan">#00E5FF</Color>
        <Color x:Key="NeonPurple">#B24BF3</Color>
        <Color x:Key="NeonPink">#FF2E97</Color>
        <Color x:Key="NeonGreen">#39FF14</Color>
        <Color x:Key="NeonOrange">#FF6B35</Color>
        <Color x:Key="NeonBlue">#00F0FF</Color>

        <!-- Brushes -->
        <SolidColorBrush x:Key="SpaceBlackBrush"
                         Color="{StaticResource SpaceBlack}"/>
        <SolidColorBrush x:Key="SpaceDeepBrush"
                         Color="{StaticResource SpaceDeep}"/>
        <SolidColorBrush x:Key="SpaceGrayBrush"
                         Color="{StaticResource SpaceGray}"/>
        <SolidColorBrush x:Key="NeonCyanBrush"
                         Color="{StaticResource NeonCyan}"/>
        <SolidColorBrush x:Key="NeonPurpleBrush"
                         Color="{StaticResource NeonPurple}"/>
        <SolidColorBrush x:Key="NeonPinkBrush"
                         Color="{StaticResource NeonPink}"/>
        <SolidColorBrush x:Key="NeonGreenBrush"
                         Color="{StaticResource NeonGreen}"/>

        <!-- Gradient Brushes -->
        <LinearGradientBrush x:Key="SpaceGradient"
                             StartPoint="0,0"
                             EndPoint="1,1">
                <GradientStop Color="#0A0E27"
                              Offset="0"/>
                <GradientStop Color="#1A1F3A"
                              Offset="0.5"/>
                <GradientStop Color="#2C3454"
                              Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="NeonGradient"
                             StartPoint="0,0"
                             EndPoint="1,1">
                <GradientStop Color="#00E5FF"
                              Offset="0"/>
                <GradientStop Color="#B24BF3"
                              Offset="0.5"/>
                <GradientStop Color="#FF2E97"
                              Offset="1"/>
        </LinearGradientBrush>

        <!-- 🔮 Glassmorphism Card -->
        <Style x:Key="GlassCard"
               TargetType="Border">
                <Setter Property="Background">
                        <Setter.Value>
                                <SolidColorBrush Color="#1A1F3A"
                                                 Opacity="0.4"/>
                        </Setter.Value>
                </Setter>
                <Setter Property="BorderBrush">
                        <Setter.Value>
                                <LinearGradientBrush StartPoint="0,0"
                                                     EndPoint="1,1">
                                        <GradientStop Color="#00E5FF"
                                                      Offset="0"/>
                                        <GradientStop Color="#B24BF3"
                                                      Offset="1"/>
                                </LinearGradientBrush>
                        </Setter.Value>
                </Setter>
                <Setter Property="BorderThickness"
                        Value="1"/>
                <Setter Property="CornerRadius"
                        Value="20"/>
                <Setter Property="Padding"
                        Value="25"/>
                <Setter Property="Effect">
                        <Setter.Value>
                                <DropShadowEffect Color="#00E5FF"
                                                  BlurRadius="30"
                                                  ShadowDepth="0"
                                                  Opacity="0.3"/>
                        </Setter.Value>
                </Setter>
        </Style>

        <!-- 🎮 Neon Button -->
        <Style x:Key="NeonButton"
               TargetType="Button">
                <Setter Property="Background"
                        Value="Transparent"/>
                <Setter Property="Foreground"
                        Value="White"/>
                <Setter Property="FontSize"
                        Value="16"/>
                <Setter Property="FontWeight"
                        Value="Bold"/>
                <Setter Property="Height"
                        Value="70"/>
                <Setter Property="Cursor"
                        Value="Hand"/>
                <Setter Property="Template">
                        <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                        <Border x:Name="border"
                                                Background="{TemplateBinding Background}"
                                                BorderThickness="2"
                                                CornerRadius="15">
                                                <Border.BorderBrush>
                                                        <LinearGradientBrush StartPoint="0,0"
                                                                             EndPoint="1,1">
                                                                <GradientStop Color="#00E5FF"
                                                                              Offset="0"/>
                                                                <GradientStop Color="#B24BF3"
                                                                              Offset="1"/>
                                                        </LinearGradientBrush>
                                                </Border.BorderBrush>
                                                <Border.Effect>
                                                        <DropShadowEffect x:Name="glow"
                                                                          Color="#00E5FF"
                                                                          BlurRadius="20"
                                                                          ShadowDepth="0"
                                                                          Opacity="0.6"/>
                                                </Border.Effect>
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver"
                                                         Value="True">
                                                        <Trigger.EnterActions>
                                                                <BeginStoryboard>
                                                                        <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetName="glow"
                                                                                                 Storyboard.TargetProperty="BlurRadius"
                                                                                                 To="35"
                                                                                                 Duration="0:0:0.2"/>
                                                                                <DoubleAnimation Storyboard.TargetName="glow"
                                                                                                 Storyboard.TargetProperty="Opacity"
                                                                                                 To="1"
                                                                                                 Duration="0:0:0.2"/>
                                                                        </Storyboard>
                                                                </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                                <BeginStoryboard>
                                                                        <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetName="glow"
                                                                                                 Storyboard.TargetProperty="BlurRadius"
                                                                                                 To="20"
                                                                                                 Duration="0:0:0.2"/>
                                                                                <DoubleAnimation Storyboard.TargetName="glow"
                                                                                                 Storyboard.TargetProperty="Opacity"
                                                                                                 To="0.6"
                                                                                                 Duration="0:0:0.2"/>
                                                                        </Storyboard>
                                                                </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                </Trigger>
                                                <Trigger Property="IsPressed"
                                                         Value="True">
                                                        <Setter TargetName="border"
                                                                Property="Background">
                                                                <Setter.Value>
                                                                        <SolidColorBrush Color="#00E5FF"
                                                                                         Opacity="0.2"/>
                                                                </Setter.Value>
                                                        </Setter>
                                                </Trigger>
                                        </ControlTemplate.Triggers>
                                </ControlTemplate>
                        </Setter.Value>
                </Setter>
        </Style>

        <!-- 💳 Touch Button (Large for touchscreens) -->
        <Style x:Key="TouchButton"
               TargetType="Button"
               BasedOn="{StaticResource NeonButton}">
                <Setter Property="Height"
                        Value="80"/>
                <Setter Property="MinWidth"
                        Value="120"/>
                <Setter Property="Margin"
                        Value="8"/>
                <Setter Property="FontSize"
                        Value="18"/>
        </Style>

        <!-- 🎯 Product Card for Touch -->
        <Style x:Key="ProductTouchCard"
               TargetType="Border">
                <Setter Property="Background">
                        <Setter.Value>
                                <SolidColorBrush Color="#1A1F3A"
                                                 Opacity="0.6"/>
                        </Setter.Value>
                </Setter>
                <Setter Property="BorderBrush">
                        <Setter.Value>
                                <SolidColorBrush Color="#00E5FF"
                                                 Opacity="0.5"/>
                        </Setter.Value>
                </Setter>
                <Setter Property="BorderThickness"
                        Value="2"/>
                <Setter Property="CornerRadius"
                        Value="15"/>
                <Setter Property="Width"
                        Value="220"/>
                <Setter Property="Height"
                        Value="260"/>
                <Setter Property="Cursor"
                        Value="Hand"/>
                <Setter Property="Effect">
                        <Setter.Value>
                                <DropShadowEffect Color="#00E5FF"
                                                  BlurRadius="15"
                                                  ShadowDepth="0"
                                                  Opacity="0.4"/>
                        </Setter.Value>
                </Setter>
        </Style>

        <!-- 📝 Neon TextBox -->
        <Style x:Key="NeonTextBox"
               TargetType="TextBox">
                <Setter Property="Background"
                        Value="Transparent"/>
                <Setter Property="Foreground"
                        Value="White"/>
                <Setter Property="FontSize"
                        Value="16"/>
                <Setter Property="Height"
                        Value="60"/>
                <Setter Property="Padding"
                        Value="15,10"/>
                <Setter Property="BorderThickness"
                        Value="2"/>
                <Setter Property="BorderBrush">
                        <Setter.Value>
                                <SolidColorBrush Color="#00E5FF"
                                                 Opacity="0.6"/>
                        </Setter.Value>
                </Setter>
                <Setter Property="CaretBrush"
                        Value="#00E5FF"/>
                <Setter Property="Template">
                        <Setter.Value>
                                <ControlTemplate TargetType="TextBox">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="12">
                                                <Border.Effect>
                                                        <DropShadowEffect Color="#00E5FF"
                                                                          BlurRadius="10"
                                                                          ShadowDepth="0"
                                                                          Opacity="0.3"/>
                                                </Border.Effect>
                                                <ScrollViewer x:Name="PART_ContentHost"
                                                              Margin="{TemplateBinding Padding}"/>
                                        </Border>
                                </ControlTemplate>
                        </Setter.Value>
                </Setter>
        </Style>

        <!-- 📊 Stat Card with Neon Glow -->
        <Style x:Key="NeonStatCard"
               TargetType="Border">
                <Setter Property="Background">
                        <Setter.Value>
                                <LinearGradientBrush StartPoint="0,0"
                                                     EndPoint="1,1">
                                        <GradientStop Color="#1A1F3A"
                                                      Offset="0"/>
                                        <GradientStop Color="#2C3454"
                                                      Offset="1"/>
                                </LinearGradientBrush>
                        </Setter.Value>
                </Setter>
                <Setter Property="BorderThickness"
                        Value="1"/>
                <Setter Property="CornerRadius"
                        Value="18"/>
                <Setter Property="Padding"
                        Value="25"/>
                <Setter Property="Effect">
                        <Setter.Value>
                                <DropShadowEffect Color="#00E5FF"
                                                  BlurRadius="25"
                                                  ShadowDepth="0"
                                                  Opacity="0.4"/>
                        </Setter.Value>
                </Setter>
        </Style>

        <!-- 🎨 Text Styles -->
        <Style x:Key="NeonHeader"
               TargetType="TextBlock">
                <Setter Property="Foreground">
                        <Setter.Value>
                                <LinearGradientBrush StartPoint="0,0"
                                                     EndPoint="1,0">
                                        <GradientStop Color="#00E5FF"
                                                      Offset="0"/>
                                        <GradientStop Color="#B24BF3"
                                                      Offset="1"/>
                                </LinearGradientBrush>
                        </Setter.Value>
                </Setter>
                <Setter Property="FontSize"
                        Value="36"/>
                <Setter Property="FontWeight"
                        Value="Bold"/>
                <Setter Property="Effect">
                        <Setter.Value>
                                <DropShadowEffect Color="#00E5FF"
                                                  BlurRadius="20"
                                                  ShadowDepth="0"
                                                  Opacity="0.8"/>
                        </Setter.Value>
                </Setter>
        </Style>

        <Style x:Key="NeonSubHeader"
               TargetType="TextBlock">
                <Setter Property="Foreground"
                        Value="#00E5FF"/>
                <Setter Property="FontSize"
                        Value="24"/>
                <Setter Property="FontWeight"
                        Value="SemiBold"/>
                <Setter Property="Effect">
                        <Setter.Value>
                                <DropShadowEffect Color="#00E5FF"
                                                  BlurRadius="15"
                                                  ShadowDepth="0"
                                                  Opacity="0.6"/>
                        </Setter.Value>
                </Setter>
        </Style>

        <Style x:Key="NeonText"
               TargetType="TextBlock">
                <Setter Property="Foreground"
                        Value="White"/>
                <Setter Property="FontSize"
                        Value="16"/>
        </Style>

        <!-- 🌟 Pulse Animation for Important Elements -->
        <Storyboard x:Key="PulseAnimation"
                    RepeatBehavior="Forever">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)">
                        <LinearDoubleKeyFrame KeyTime="0:0:0"
                                              Value="0.4"/>
                        <LinearDoubleKeyFrame KeyTime="0:0:1"
                                              Value="1"/>
                        <LinearDoubleKeyFrame KeyTime="0:0:2"
                                              Value="0.4"/>
                </DoubleAnimationUsingKeyFrames>
        </Storyboard>

</ResourceDictionary>

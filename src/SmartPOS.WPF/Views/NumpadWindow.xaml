<Window x:Class="SmartPOS.WPF.Views.NumpadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{DynamicResource Loc_347c6ab8}"
        Width="380" MinWidth="300"
        Height="560" MinHeight="420"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI Variable, Segoe UI, Tahoma"
        FlowDirection="RightToLeft">

    <Window.Resources>
        <!-- Numpad Key Style -->
        <Style x:Key="NumpadKeyBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AlAtmani.Surface2Brush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AlAtmani.TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AlAtmani.BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource AlAtmani.SurfaceBrush}"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource AlAtmani.AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource AlAtmani.AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quick Qty Key Style -->
        <Style x:Key="QuickQtyBtn" TargetType="Button" BasedOn="{StaticResource NumpadKeyBtn}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AlAtmani.AccentBrush}"/>
        </Style>
    </Window.Resources>

    <!-- Outer Frame Container with Shadow -->
    <Grid Margin="10">
        <Border CornerRadius="16" Background="{DynamicResource AlAtmani.BackgroundBrush}"
                BorderBrush="{DynamicResource AlAtmani.BorderBrush}" BorderThickness="1.5">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="4" Opacity="0.45"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>   <!-- Title Bar -->
                    <RowDefinition Height="Auto"/> <!-- Selected Item Banner -->
                    <RowDefinition Height="Auto"/> <!-- Input Display -->
                    <RowDefinition Height="Auto"/> <!-- Quick Qty -->
                    <RowDefinition Height="*"/>    <!-- 3x4 Grid -->
                    <RowDefinition Height="Auto"/> <!-- Bottom Actions -->
                </Grid.RowDefinitions>

                <!-- Row 0: Custom Title Bar (Draggable) -->
                <Border Grid.Row="0" Background="{DynamicResource AlAtmani.SurfaceBrush}"
                        CornerRadius="14,14,0,0" BorderBrush="{DynamicResource AlAtmani.BorderBrush}"
                        BorderThickness="0,0,0,1" Padding="10,0"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="CalculatorVariant" Width="18" Height="18"
                                                     Foreground="{DynamicResource AlAtmani.AccentBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource Loc_b50be83a}" FontWeight="Bold" FontSize="12.5"
                                       Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Window Close Button -->
                        <Button HorizontalAlignment="Left" VerticalAlignment="Center"
                                Click="Close_Click" Width="28" Height="28"
                                Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="btnBg" CornerRadius="6" Background="Transparent">
                                        <TextBlock Text="✕" FontSize="12" FontWeight="Bold"
                                                   Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnBg" Property="Background" Value="#33FF3333"/>
                                            <Setter Property="Foreground" Value="#FF4444"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- Row 1: Selected Item Banner -->
                <Border Grid.Row="1" Background="{DynamicResource AlAtmani.Surface2Brush}"
                        CornerRadius="10" Padding="12,8" Margin="12,10,12,6"
                        BorderThickness="1" BorderBrush="{DynamicResource AlAtmani.BorderBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0" Kind="CartOutline" Width="18" Height="18"
                                                 VerticalAlignment="Center" Margin="0,0,8,0"
                                                 Foreground="{DynamicResource AlAtmani.AccentBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding SelectedCartItem.Name, TargetNullValue={DynamicResource Loc_NumpadSelectCartItem}, FallbackValue={DynamicResource Loc_NumpadSelectCartItem}}"
                                   FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Row 2: Input Display -->
                <Border Grid.Row="2" Background="{DynamicResource AlAtmani.SurfaceBrush}"
                        CornerRadius="10" Padding="14,8" Margin="12,4,12,8"
                        BorderThickness="1.5" BorderBrush="{DynamicResource AlAtmani.AccentBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding NumpadInput, FallbackValue='0'}"
                                   FontSize="26" FontWeight="Black"
                                   Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Command="{Binding NumpadBackspaceCommand}"
                                Width="34" Height="34" Margin="6,0,0,0"
                                Style="{StaticResource MaterialDesignIconButton}">
                            <materialDesign:PackIcon Kind="BackspaceOutline" Width="20" Height="20" Foreground="#FB7185"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Row 3: Quick Qty Buttons -->
                <UniformGrid Grid.Row="3" Rows="1" Margin="10,0,10,6">
                    <Button Style="{StaticResource QuickQtyBtn}" Command="{Binding NumpadAddQuickQtyCommand}" CommandParameter="1" Content="+1"/>
                    <Button Style="{StaticResource QuickQtyBtn}" Command="{Binding NumpadAddQuickQtyCommand}" CommandParameter="5" Content="+5"/>
                    <Button Style="{StaticResource QuickQtyBtn}" Command="{Binding NumpadAddQuickQtyCommand}" CommandParameter="10" Content="+10"/>
                    <Button Style="{StaticResource QuickQtyBtn}" Command="{Binding NumpadAddQuickQtyCommand}" CommandParameter="-1" Content="-1" Foreground="#FB7185"/>
                </UniformGrid>

                <!-- Row 4: 3x4 Standard Number Pad (FlowDirection=LeftToRight to ensure clean numerals) -->
                <UniformGrid Grid.Row="4" Columns="3" Rows="4" Margin="10,0,10,6" FlowDirection="LeftToRight">
                    <Button Style="{StaticResource NumpadKeyBtn}" Command="{Binding NumpadDigitCommand}" CommandParameter="7" Content="7"/>
                    <Button Style="{StaticResource NumpadKeyBtn}" Command="{Binding NumpadDigitCommand}" CommandParameter="8" Content="8"/>
                    <Button Style="{StaticResource NumpadKeyBtn}" Command="{Binding NumpadDigitCommand}" CommandParameter="9" Content="9"/>
                    <Button Style="{StaticResource NumpadKeyBtn}" Command="{Binding NumpadDigitCommand}" CommandParameter="4" Content="4"/>
                    <Button Style="{StaticResource NumpadKeyBtn}" Command="{Binding NumpadDigitCommand}" CommandParameter="5" Content="5"/>
                    <Button Style="{StaticResource NumpadKeyBtn}" Command="{Binding NumpadDigitCommand}" CommandParameter="6" Content="6"/>
                    <Button Style="{StaticResource NumpadKeyBtn}" Command="{Binding NumpadDigitCommand}" CommandParameter="1" Content="1"/>
                    <Button Style="{StaticResource NumpadKeyBtn}" Command="{Binding NumpadDigitCommand}" CommandParameter="2" Content="2"/>
                    <Button Style="{StaticResource NumpadKeyBtn}" Command="{Binding NumpadDigitCommand}" CommandParameter="3" Content="3"/>
                    <Button Style="{StaticResource NumpadKeyBtn}" Command="{Binding NumpadDigitCommand}" CommandParameter="00" Content="00" FontSize="16"/>
                    <Button Style="{StaticResource NumpadKeyBtn}" Command="{Binding NumpadDigitCommand}" CommandParameter="0" Content="0"/>
                    <Button Style="{StaticResource NumpadKeyBtn}" Command="{Binding NumpadDigitCommand}" CommandParameter="." Content="." FontSize="24" Foreground="{DynamicResource AlAtmani.AccentBrush}"/>
                </UniformGrid>

                <!-- Row 5: Apply / Action Buttons -->
                <Grid Grid.Row="5" Margin="12,4,12,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Background="{DynamicResource AlAtmani.AccentBrush}" Foreground="White"
                            Command="{Binding NumpadApplyQtyCommand}"
                            Content="{DynamicResource Loc_07f0e272}" Height="44" FontSize="13.5" FontWeight="Bold"
                            materialDesign:ButtonAssist.CornerRadius="8"/>
                    <Button Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding NumpadApplyPriceCommand}"
                            Content="{DynamicResource Loc_0082be33}" Height="44" Margin="6,0,0,0" FontSize="13.5" FontWeight="Bold"
                            materialDesign:ButtonAssist.CornerRadius="8"/>
                    <Button Grid.Column="2" Style="{StaticResource MaterialDesignOutlinedButton}"
                            BorderBrush="#FB7185" Foreground="#FB7185"
                            Command="{Binding NumpadClearCommand}"
                            Content="C" Width="44" Height="44" Margin="6,0,0,0" FontSize="16" FontWeight="Bold"
                            materialDesign:ButtonAssist.CornerRadius="8"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>

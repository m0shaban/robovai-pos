<Page x:Class="SmartPOS.WPF.Views.SuppliersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="{DynamicResource Loc_731c896c}"
      FontFamily="Segoe UI, Tahoma"
      FlowDirection="RightToLeft">

    <Grid Background="{DynamicResource AlAtmani.BackgroundBrush}"
          Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <materialDesign:Card Grid.Row="0"
                             Style="{StaticResource AlAtmani.GlassCard}">
            <DockPanel>
                <Border Background="#E8EAF6"
                        CornerRadius="12"
                        Padding="12"
                        DockPanel.Dock="Right"
                        Margin="0,0,16,0">
                    <materialDesign:PackIcon Kind="TruckDelivery"
                                             Width="36"
                                             Height="36"
                                             Foreground="#3F51B5"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Loc_1177672a}"
                               Style="{StaticResource AlAtmani.HeaderText}"
                               Margin="0"/>
                    <TextBlock Text="{DynamicResource Loc_b44f4e38}"
                               FontSize="13"
                               Foreground="#3F51B5"
                               Opacity="0.8"/>
                </StackPanel>
                
                <!-- Toolbar -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Command="{Binding LoadSuppliersCommand}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="{DynamicResource Loc_fd4458ee}"
                            Margin="0,0,16,0"
                            Foreground="#3F51B5">
                        <materialDesign:PackIcon Kind="Refresh" Width="24" Height="24"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </materialDesign:Card>

        <!-- Form (Visible only to Admin) -->
        <materialDesign:Card Grid.Row="1"
                             Padding="16"
                             Margin="0,0,0,16"
                             Style="{StaticResource AlAtmani.GlassCard}"
                             Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBox Grid.Column="0"
                         materialDesign:HintAssist.Hint="{DynamicResource Loc_h_ef7e0bdd}"
                         Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,12,12"/>

                <TextBox Grid.Column="1"
                         materialDesign:HintAssist.Hint="{DynamicResource Loc_h_491296a0}"
                         Text="{Binding FormContactPerson, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,12,12"/>

                <TextBox Grid.Column="2"
                         materialDesign:HintAssist.Hint="{DynamicResource Loc_h_0947ad57}"
                         Text="{Binding FormPhone, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,12"/>

                <TextBox Grid.Row="1"
                         Grid.Column="0"
                         materialDesign:HintAssist.Hint="{DynamicResource Loc_h_6dc65880}"
                         Text="{Binding FormAddress, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,12,0"/>

                <TextBox Grid.Row="1"
                         Grid.Column="1"
                         materialDesign:HintAssist.Hint="{DynamicResource Loc_h_2436aacc}"
                         Text="{Binding FormEmail, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,12,0"/>

                <CheckBox Grid.Row="1"
                          Grid.Column="2"
                          IsChecked="{Binding FormIsActive}"
                          Content="{DynamicResource Loc_c54beeb9}"
                          Style="{StaticResource MaterialDesignFilterChipPrimaryOutlineCheckBox}"
                          VerticalAlignment="Center"
                          Margin="0,0,12,0"
                          HorizontalAlignment="Left"/>

                <StackPanel Grid.Row="1"
                            Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="{DynamicResource Loc_871a087a}"
                            Style="{StaticResource AlAtmani.SoftButton}"
                            Width="100"
                            Height="45"
                            Command="{Binding SaveSupplierCommand}"
                            Margin="0,0,12,0"/>
                    <Button Content="{DynamicResource Loc_c590a35c}"
                            Style="{StaticResource AlAtmani.SoftButton}"
                            Width="100"
                            Height="45"
                            Command="{Binding ClearFormCommand}"/>
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <!-- Suppliers Grid -->
        <materialDesign:Card Grid.Row="2"
                             Style="{StaticResource AlAtmani.GlassCard}"
                             Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Search -->
                <Grid Grid.Row="0"
                      Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             materialDesign:HintAssist.Hint="{DynamicResource Loc_h_5621bfc6}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0,0,16,0"/>

                    <Button Grid.Column="1"
                            Content="{DynamicResource Loc_ab79fc14}"
                            Command="{Binding SearchCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"/>
                </Grid>

                <DataGrid Grid.Row="1"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          ItemsSource="{Binding Suppliers}"
                          SelectedItem="{Binding SelectedSupplier}"
                          SelectionMode="Single"
                          materialDesign:DataGridAssist.CellPadding="12"
                          materialDesign:DataGridAssist.ColumnHeaderPadding="12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource Loc_2e8b171b}"
                                            Binding="{Binding Name}"
                                            Width="2*"/>
                        <DataGridTextColumn Header="{DynamicResource Loc_54089823}"
                                            Binding="{Binding ContactPerson}"
                                            Width="*"/>
                        <DataGridTextColumn Header="{DynamicResource Loc_76f2f18e}"
                                            Binding="{Binding Phone}"
                                            Width="*"/>
                        <DataGridTextColumn Header="{DynamicResource Loc_6dc65880}"
                                            Binding="{Binding Address}"
                                            Width="2*"/>
                        <DataGridTextColumn Header="{DynamicResource Loc_dc18480e}"
                                            Binding="{Binding DebtAmount, StringFormat='{}{0:F2}'}"
                                            Width="*"/>
                                            
                        <!-- Status Indicator -->
                        <DataGridTemplateColumn Header="{DynamicResource Loc_1253eb56}" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12"
                                            Padding="12,4"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#E3F2FD"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                        <Setter Property="Background" Value="#FFEBEE"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontWeight="SemiBold" FontSize="12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="نشط"/>
                                                    <Setter Property="Foreground" Value="#1565C0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Text" Value="موقوف"/>
                                                            <Setter Property="Foreground" Value="#C62828"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="{DynamicResource Loc_901efe9b}"
                                                Width="130"
                                                Visibility="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center">
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                ToolTip="{DynamicResource Loc_759fdc24}"
                                                Width="34" Height="34" Margin="2,0"
                                                Command="{Binding DataContext.EditSupplierCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="Pencil" Width="20" Height="20" Foreground="{DynamicResource AlAtmani.AccentBrush}"/>
                                        </Button>
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                ToolTip="{DynamicResource Loc_3b9854e1}"
                                                Width="34" Height="34" Margin="2,0"
                                                Command="{Binding DataContext.DeleteSupplierCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="Delete" Width="20" Height="20" Foreground="#FB7185"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </materialDesign:Card>
    </Grid>
</Page>

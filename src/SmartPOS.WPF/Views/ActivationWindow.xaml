<Window x:Class="SmartPOS.WPF.Views.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{DynamicResource Loc_7cba30d4}"
        SizeToContent="Height"
        Width="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI, Tahoma"
        FlowDirection="RightToLeft"
        Loaded="ActivationWindow_Loaded">

    <Border Background="{StaticResource AlAtmani.AcrylicBrushStrong}"
            BorderBrush="{DynamicResource AlAtmani.AcrylicBorderBrush}"
            BorderThickness="1"
            CornerRadius="24"
            Margin="10"
            Effect="{StaticResource MaterialDesignShadowDepth2}">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,18">
                <materialDesign:PackIcon Kind="KeyVariant" Width="56" Height="56"
                                         Foreground="{DynamicResource AlAtmani.AccentBrush}"/>
                <TextBlock Text="{DynamicResource Loc_643cbea6}"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0"/>
                <TextBlock Text="{DynamicResource Loc_ae185afe}"
                           FontSize="13"
                           Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                <TextBlock Text="{DynamicResource Loc_6f526c61}" FontWeight="SemiBold"
                           Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}"/>
                <DockPanel Margin="0,6,0,0">
                    <TextBox x:Name="DeviceIdBox"
                             IsReadOnly="True"
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                             Text="{Binding DeviceId}"
                             FontSize="16"
                             Padding="10"
                             DockPanel.Dock="Right"/>
                    <Button Content="{DynamicResource Loc_eb32f766}"
                            Style="{StaticResource AlAtmani.SoftButton}"
                            Width="90"
                            Margin="10,0,0,0"
                            Click="CopyDeviceId_Click"/>
                </DockPanel>
            </StackPanel>

            <TextBox Grid.Row="2"
                     x:Name="CodeBox"
                     materialDesign:HintAssist.Hint="{DynamicResource Loc_h_52b83f9b}"
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     FontSize="14"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     MinHeight="90"
                     Margin="0,0,0,12"/>

            <StackPanel Grid.Row="3" Margin="0,0,0,10">
                <TextBlock Text="{Binding ExpiryLine}"
                           Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,6"/>
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Grid Grid.Row="4" Margin="0,12,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button Grid.Row="0"
                        Content="{DynamicResource Loc_84033585}"
                        Style="{StaticResource AlAtmani.SoftButton}"
                        Height="45"
                        FontSize="16"
                        FontWeight="Bold"
                        Background="{DynamicResource AlAtmani.AccentBrush}"
                        BorderBrush="{DynamicResource AlAtmani.AccentBrush}"
                        Foreground="{DynamicResource AlAtmani.BackgroundBrush}"
                        Click="Activate_Click"
                        Margin="0,0,0,10"/>

                <Button Grid.Row="1"
                        Content="{DynamicResource Loc_d5d2fe5a}"
                        Style="{StaticResource AlAtmani.SoftButton}"
                        Height="45"
                        FontSize="16"
                        Click="StartTrial_Click"
                        Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="2"
                           HorizontalAlignment="Center"
                           Margin="0,2,0,12"
                           Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}">
                        <Run Text="{DynamicResource Loc_4abf150e}"/>
                        <Hyperlink NavigateUri="https://robovai.tech" RequestNavigate="ActivationLink_RequestNavigate">robovai.tech</Hyperlink>
                    </TextBlock>

                    <Button Grid.Row="3"
                        Content="{DynamicResource Loc_60806661}"
                        Style="{StaticResource AlAtmani.SoftButton}"
                        Height="45"
                        FontSize="16"
                        Click="Exit_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>

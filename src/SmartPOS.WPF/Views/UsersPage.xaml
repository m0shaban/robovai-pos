<Page x:Class="SmartPOS.WPF.Views.UsersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:entities="clr-namespace:SmartPOS.Core.Entities;assembly=SmartPOS.Core"
      Title="إدارة المستخدمين"
      FontFamily="Segoe UI, Tahoma"
      FlowDirection="RightToLeft"
      Loaded="Page_Loaded">

    <Grid Background="{DynamicResource AlAtmani.BackgroundBrush}" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══════════════════ Header ══════════════════ -->
        <materialDesign:Card Grid.Row="0"
                             Style="{StaticResource AlAtmani.GlassCard}"
                             Margin="0,0,0,20">
            <DockPanel>
                <Border Background="{DynamicResource AlAtmani.Surface2Brush}"
                        CornerRadius="12" Padding="12"
                        DockPanel.Dock="Right" Margin="0,0,16,0">
                    <materialDesign:PackIcon Kind="AccountGroup"
                                             Width="36" Height="36"
                                             Foreground="{DynamicResource AlAtmani.AccentBrush}"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="إدارة المستخدمين والصلاحيات"
                               Style="{StaticResource AlAtmani.HeaderText}" Margin="0"/>
                    <TextBlock Text="إضافة وتعديل حسابات الموظفين وصلاحياتهم"
                               FontSize="13"
                               Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}"
                               Opacity="0.8"/>
                </StackPanel>
                
                <!-- Toolbar -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Command="{Binding LoadUsersCommand}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="تحديث البيانات"
                            Margin="0,0,16,0"
                            Foreground="{DynamicResource AlAtmani.AccentBrush}">
                        <materialDesign:PackIcon Kind="Refresh" Width="24" Height="24"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </materialDesign:Card>

        <!-- ══════════════════ Main Content ══════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*" MinWidth="340"/>
            </Grid.ColumnDefinitions>

            <!-- ── Left: Users List ── -->
            <materialDesign:Card Grid.Column="0"
                                 Style="{StaticResource AlAtmani.GlassCard}"
                                 Margin="0,0,16,0"
                                 Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- List header -->
                    <Border Grid.Row="0" Padding="16,12"
                            BorderBrush="{DynamicResource AlAtmani.BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <DockPanel>
                            <Button DockPanel.Dock="Left"
                                    Style="{StaticResource AlAtmani.SoftButton}"
                                    HorizontalAlignment="Left"
                                    Height="36" Padding="12,0"
                                    Command="{Binding ClearFormCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="AccountPlus" Width="16" Height="16"
                                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="مستخدم جديد" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            
                            <TextBox materialDesign:HintAssist.Hint="بحث بالاسم أو المعرف..."
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Padding="8,6"
                                     Margin="16,0,0,0"
                                     materialDesign:TextFieldAssist.HasClearButton="True"
                                     VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <!-- Users ListView -->
                    <ListView Grid.Row="1"
                              ItemsSource="{Binding Users}"
                              SelectedItem="{Binding SelectedUser}"
                              Background="Transparent"
                              BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="8,4"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border x:Name="Bd"
                                                    CornerRadius="12"
                                                    Background="{DynamicResource AlAtmani.SurfaceBrush}"
                                                    BorderBrush="{DynamicResource AlAtmani.BorderBrush}"
                                                    BorderThickness="1"
                                                    Padding="12">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush"
                                                            Value="{DynamicResource AlAtmani.AccentBrush}"/>
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource AlAtmani.Surface2Brush}"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource AlAtmani.Surface2Brush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Avatar circle with first letter -->
                                    <Border Grid.Column="0"
                                            Width="44" Height="44"
                                            CornerRadius="22"
                                            Background="{DynamicResource AlAtmani.AccentBrush}"
                                            Margin="0,0,12,0">
                                        <TextBlock Text="{Binding FullName[0]}"
                                                   FontSize="20" FontWeight="Bold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Name, Username, Role badge -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FullName}"
                                                   FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Text="{Binding Username}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}"
                                                       Margin="0,0,8,0"/>
                                            <!-- Role badge -->
                                            <Border CornerRadius="4" Padding="6,2"
                                                    Background="{DynamicResource AlAtmani.Surface2Brush}">
                                                <TextBlock FontSize="11"
                                                           Foreground="{DynamicResource AlAtmani.AccentBrush}"
                                                           Text="{Binding Role}"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Active status dot -->
                                    <Ellipse Grid.Column="2"
                                             Width="10" Height="10"
                                             Margin="8,0"
                                             VerticalAlignment="Center"
                                             Fill="{Binding IsActive, Converter={StaticResource BoolToColorConverter}}"/>

                                    <!-- Action buttons -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">

                                        <!-- Edit -->
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                Width="32" Height="32"
                                                ToolTip="تعديل بيانات المستخدم"
                                                Command="{Binding DataContext.SelectUserCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="Pencil" Width="16" Height="16"
                                                                     Foreground="{DynamicResource AlAtmani.AccentBrush}"/>
                                        </Button>

                                        <!-- Reset Password — PackIcon "KeyVariant" is correct for MDI -->
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                Width="34" Height="34" Margin="2,0"
                                                ToolTip="إعادة تعيين كلمة المرور"
                                                Command="{Binding DataContext.ResetPasswordCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="KeyVariant" Width="18" Height="18"
                                                                     Foreground="#F59E0B"/>
                                        </Button>

                                        <!-- Toggle Active/Inactive -->
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                Width="34" Height="34" Margin="2,0"
                                                ToolTip="{Binding IsActive, Converter={StaticResource BoolToStatusConverter}}"
                                                Command="{Binding DataContext.ToggleUserActiveCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="AccountOff" Width="18" Height="18"
                                                                     Foreground="#FB7185"/>
                                        </Button>
                                        
                                        <!-- Delete -->
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                Width="34" Height="34" Margin="2,0"
                                                ToolTip="حذف المستخدم"
                                                Command="{Binding DataContext.DeleteUserCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="Delete" Width="18" Height="18"
                                                                     Foreground="#FB7185"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </materialDesign:Card>

            <!-- ── Right: User Form ── -->
            <materialDesign:Card Grid.Column="1"
                                 Style="{StaticResource AlAtmani.GlassCard}"
                                 Padding="24">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- Form title -->
                        <TextBlock FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}"
                                   Margin="0,0,0,20">
                            <TextBlock.Text>
                                <Binding Path="SelectedUser"
                                         Converter="{StaticResource NullToStringConverter}"
                                         ConverterParameter="تعديل مستخدم|إضافة مستخدم جديد"/>
                            </TextBlock.Text>
                        </TextBlock>

                        <!-- Full Name -->
                        <TextBox materialDesign:HintAssist.Hint="الاسم الكامل *"
                                 Text="{Binding FormFullName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Margin="0,0,0,16"/>

                        <!-- Username -->
                        <TextBox materialDesign:HintAssist.Hint="اسم المستخدم (للدخول) *"
                                 Text="{Binding FormUsername, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Margin="0,0,0,16"/>

                        <!-- Password -->
                        <PasswordBox x:Name="PasswordBox"
                                     materialDesign:HintAssist.Hint="كلمة المرور (اتركها فارغة للإبقاء على الحالية)"
                                     Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                     PasswordChanged="PasswordBox_PasswordChanged"
                                     Margin="0,0,0,16"/>

                        <!-- Phone -->
                        <TextBox materialDesign:HintAssist.Hint="رقم الهاتف"
                                 Text="{Binding FormPhone, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Margin="0,0,0,16"/>

                        <!-- Email -->
                        <TextBox materialDesign:HintAssist.Hint="البريد الإلكتروني"
                                 Text="{Binding FormEmail, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Margin="0,0,0,16"/>

                        <!-- Role ComboBox -->
                        <ComboBox materialDesign:HintAssist.Hint="الصلاحية"
                                  ItemsSource="{Binding AvailableRoles}"
                                  SelectedItem="{Binding FormRole}"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  Margin="0,0,0,16">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ShieldAccount"
                                                                 Width="14" Height="14"
                                                                 Margin="0,0,6,0"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="{DynamicResource AlAtmani.AccentBrush}"/>
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Active Toggle -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                          IsChecked="{Binding FormIsActive}"
                                          Margin="0,0,12,0"/>
                            <TextBlock Text="حساب نشط"
                                       Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}"
                                       VerticalAlignment="Center"
                                       FontSize="14"/>
                        </StackPanel>

                        <!-- Daily Meal Limit -->
                        <TextBox materialDesign:HintAssist.Hint="الحد اليومي للضيافة والوجبات (بالجنيه)"
                                 Text="{Binding FormDailyMealLimit, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Margin="0,0,0,20"/>

                        <!-- SuperAdmin Only: Permissions -->
                        <Border Background="{DynamicResource AlAtmani.Surface2Brush}"
                                CornerRadius="10" Padding="14"
                                Margin="0,0,0,20"
                                BorderBrush="{DynamicResource AlAtmani.BorderBrush}"
                                BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSuperAdmin}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="إعدادات الأمان والصلاحيات (للمالك فقط)" FontSize="14" FontWeight="SemiBold"
                                           Foreground="#EF4444" Margin="0,0,0,16"/>
                                
                                <TextBox materialDesign:HintAssist.Hint="الرقم السري (Admin PIN)"
                                         Text="{Binding FormAdminPin, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Margin="0,0,0,16"/>

                                <TextBlock Text="الصلاحيات المخصصة" FontSize="13" Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}" Margin="0,0,0,8"/>
                                
                                <CheckBox Content="فتح الدرج يدوياً بدون فاتورة" IsChecked="{Binding PermOpenDrawer}" Margin="0,4"/>
                                <CheckBox Content="مسح عناصر من الفاتورة / استرجاع" IsChecked="{Binding PermVoidItem}" Margin="0,4"/>
                                <CheckBox Content="تطبيق خصم أكبر من 15%" IsChecked="{Binding PermHighDiscount}" Margin="0,4"/>
                                <CheckBox Content="استخدام رقمه السري للمصادقة لتجاوز القيود" IsChecked="{Binding PermProvideAdminPin}" Margin="0,4"/>
                                <CheckBox Content="إدارة المستخدمين وإعطاء صلاحيات" IsChecked="{Binding PermManageUsers}" Margin="0,4"/>
                                <CheckBox Content="الاطلاع على تقارير الأرباح ورأس المال" IsChecked="{Binding PermViewProfit}" Margin="0,4"/>
                            </StackPanel>
                        </Border>

                        <!-- Roles info box -->
                        <Border Background="{DynamicResource AlAtmani.Surface2Brush}"
                                CornerRadius="10" Padding="14"
                                Margin="0,0,0,20"
                                BorderBrush="{DynamicResource AlAtmani.BorderBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="دليل الصلاحيات" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AlAtmani.AccentBrush}"
                                           Margin="0,0,0,8"/>
                                <TextBlock Text="🔑 مبرمج النظام: كامل الصلاحيات + الوايت لابيل"
                                           FontSize="12"
                                           Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}"
                                           Margin="0,2"/>
                                <TextBlock Text="👑 مدير / صاحب المحل: تقارير، منتجات، إعدادات"
                                           FontSize="12"
                                           Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}"
                                           Margin="0,2"/>
                                <TextBlock Text="🏪 مشرف فرع: منتجات، فواتير، عملاء"
                                           FontSize="12"
                                           Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}"
                                           Margin="0,2"/>
                                <TextBlock Text="💰 كاشير: نقطة البيع والمرتجعات فقط"
                                           FontSize="12"
                                           Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}"
                                           Margin="0,2"/>
                            </StackPanel>
                        </Border>

                        <!-- Save / Cancel buttons -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Command="{Binding SaveUserCommand}"
                                    Style="{StaticResource AlAtmani.SoftButton}"
                                    Height="48" FontSize="15"
                                    Background="{DynamicResource AlAtmani.AccentBrush}"
                                    Foreground="White"
                                    Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ContentSave" Width="18" Height="18"
                                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="حفظ" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1"
                                    Command="{Binding ClearFormCommand}"
                                    Style="{StaticResource AlAtmani.SoftButton}"
                                    Height="48" FontSize="15"
                                    Margin="6,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Close" Width="18" Height="18"
                                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="إلغاء" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Status message -->
                        <Border CornerRadius="8" Padding="10"
                                Visibility="{Binding StatusMessage, Converter={StaticResource CountToVisibilityConverter}}">
                            <TextBlock Text="{Binding StatusMessage}"
                                       Foreground="#22C55E"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Center"/>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </materialDesign:Card>
        </Grid>
    </Grid>
</Page>

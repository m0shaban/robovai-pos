<Page x:Class="SmartPOS.WPF.Views.RentalsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
      mc:Ignorable="d"
      d:DesignHeight="700"
        d:DesignWidth="1000"
      Title="إدارة الجلسات"
      FlowDirection="RightToLeft">

    <materialDesign:DialogHost Identifier="RentalsDialogHost">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header & Top Controls -->
            <Border Grid.Row="0"
                    Margin="0,0,0,16"
                    Padding="16"
                    Background="White"
                    CornerRadius="8">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10"
                            Opacity="0.1"
                            ShadowDepth="2"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="GamepadVariant"
                                Width="32"
                                Height="32"
                                Foreground="{DynamicResource PrimaryHueMidBrush}"
                                Margin="0,0,16,0"/>
                        <TextBlock Text="إدارة الجلسات"
                                FontSize="24"
                                FontWeight="Bold"
                                Foreground="#1E3A8A"
                                VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Add Device Button -->
                    <Button Grid.Column="1"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{x:Static materialDesign:DialogHost.OpenDialogCommand}">
                        <Button.CommandParameter>
                            <!-- Add Device Dialog -->
                            <Grid Margin="20"
                                    Width="300">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="إضافة جهاز جديد"
                                        FontSize="18"
                                        FontWeight="Bold"
                                        Margin="0,0,0,16"/>

                                <TextBox Grid.Row="1"
                                        materialDesign:HintAssist.Hint="اسم الجهاز (مثال: جهاز 1)"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Text="{Binding NewDeviceName, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,0,0,12"/>

                                <TextBox Grid.Row="2"
                                        materialDesign:HintAssist.Hint="سعر الساعة"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Text="{Binding NewDeviceRate, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,0,0,12"/>

                                <!-- Device Type ComboBox - Skipping exact enum binding for simplicity, using text or relying on default -->

                                <StackPanel Grid.Row="4"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Margin="0,16,0,0">
                                    <Button Content="إلغاء"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                                            Margin="0,0,8,0"/>
                                    <Button Content="حفظ"
                                            Command="{Binding AddDeviceCommand}"
                                            CommandParameter="{x:Static materialDesign:DialogHost.CloseDialogCommand}">
                                        <b:Interaction.Triggers>
                                            <b:EventTrigger EventName="Click">
                                                <b:InvokeCommandAction Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"/>
                                            </b:EventTrigger>
                                        </b:Interaction.Triggers>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Button.CommandParameter>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Width="20" Height="20" Margin="0,0,8,0"/>
                            <TextBlock Text="إضافة جهاز"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Devices Grid -->
            <ScrollViewer Grid.Row="1"
                    VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Devices}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="8"
                                    Width="300"
                                    Background="{Binding CardBackgroundColor}"
                                    CornerRadius="12"
                                    Padding="16"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource MaterialDesignDivider}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8"
                                            Opacity="0.1"
                                            ShadowDepth="1"/>
                                </Border.Effect>

                                <StackPanel>
                                    <!-- Header: Device Name, Status & Delete -->
                                    <DockPanel Margin="0,0,0,12">
                                        <materialDesign:PackIcon DockPanel.Dock="Left"
                                                Kind="Console"
                                                Width="24"
                                                Height="24"
                                                Foreground="White"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"/>
                                        <!-- Delete button (top-left of card) -->
                                        <Button DockPanel.Dock="Left"
                                                Style="{StaticResource MaterialDesignIconButton}"
                                                ToolTip="حذف الجهاز"
                                                Width="28"
                                                Height="28"
                                                Padding="0"
                                                Command="{Binding DataContext.DeleteDeviceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding IsAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <materialDesign:PackIcon Kind="DeleteCircleOutline"
                                                    Width="18"
                                                    Height="18"
                                                    Foreground="#FCA5A5"/>
                                        </Button>
                                        <TextBlock DockPanel.Dock="Right"
                                                Text="{Binding StatusText}"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding Device.Name}"
                                                FontSize="20"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                VerticalAlignment="Center"/>
                                    </DockPanel>

                                    <!-- Status Info -->
                                    <Border Background="#20FFFFFF"
                                            CornerRadius="8"
                                            Padding="12"
                                            Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="{Binding TimerText}"
                                                    FontSize="32"
                                                    FontWeight="Bold"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,0,0,8"
                                                    Foreground="White"
                                                    Visibility="{Binding IsTimeUp, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <TextBlock Text="{Binding TimerText}"
                                                    FontSize="32"
                                                    FontWeight="Bold"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,0,0,8"
                                                    Foreground="White"
                                                    Visibility="{Binding IsAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <TextBlock Text="{Binding TimerText}"
                                                    FontSize="32"
                                                    FontWeight="Bold"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,0,0,8"
                                                    Foreground="#A7F3D0"
                                                    Visibility="{Binding IsOccupied, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                            <DockPanel>
                                                <TextBlock Text="المبلغ الحالي:"
                                                        Foreground="#D1D5DB"/>
                                                <TextBlock Text="{Binding CurrentAmount, StringFormat={}{0:N2} ج.م}"
                                                        FontWeight="Bold"
                                                        Foreground="#10B981"
                                                        HorizontalAlignment="Right"/>
                                            </DockPanel>
                                            <DockPanel Margin="0,4,0,0">
                                                <TextBlock Text="سعر الساعة:"
                                                        Foreground="#D1D5DB"/>
                                                <TextBlock Text="{Binding Device.HourlyRate, StringFormat={}{0:N2} ج.م}"
                                                        FontWeight="Bold"
                                                        Foreground="White"
                                                        HorizontalAlignment="Right"/>
                                            </DockPanel>
                                            <DockPanel Margin="0,4,0,0"
                                                    Visibility="{Binding IsOccupied, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="العميل:"
                                                        Foreground="#D1D5DB"/>
                                                <TextBlock Text="{Binding CurrentSession.CustomerName}"
                                                        FontWeight="Bold"
                                                        Foreground="White"
                                                        HorizontalAlignment="Right"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Controls (Available) -->
                                    <StackPanel Visibility="{Binding IsAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBox materialDesign:HintAssist.Hint="اسم العميل (اختياري)"
                                                materialDesign:HintAssist.Foreground="LightGray"
                                                Foreground="White"
                                                Text="{Binding InputCustomerName}"
                                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                Margin="0,0,0,8"/>

                                        <StackPanel Orientation="Horizontal"
                                                Margin="0,0,0,8">
                                            <TextBox materialDesign:HintAssist.Hint="المدة (دقيقة)"
                                                    materialDesign:HintAssist.Foreground="LightGray"
                                                    Foreground="White"
                                                    Text="{Binding InputDurationMinutes}"
                                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                    Width="100"
                                                    Margin="0,0,8,0"/>
                                            <CheckBox Content="وقت مفتوح"
                                                    Foreground="White"
                                                    IsChecked="{Binding InputIsOpenDuration}"
                                                    VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <Button Content="بدء الجلسة"
                                                Command="{Binding DataContext.StartSessionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Background="#10B981"
                                                BorderBrush="#10B981"
                                                Foreground="White"/>
                                    </StackPanel>

                                    <!-- Controls (Occupied) -->
                                    <StackPanel Visibility="{Binding IsOccupied, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Button Content="تعيين الوقت وإنهاء (فعلي)"
                                                Command="{Binding DataContext.EndSessionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Background="#FF8A65"
                                                BorderBrush="#FF8A65"
                                                Foreground="White"
                                                Margin="0,0,0,8"
                                                ToolTip="حساب أي وقت إضافي فعلي"/>
                                        <Button Content="إنهاء (للمدة المتفق عليها)"
                                                Command="{Binding DataContext.EndSessionReservedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Background="#EF4444"
                                                BorderBrush="#EF4444"
                                                Foreground="White"
                                                Margin="0,0,0,8"
                                                ToolTip="إنهاء الجلسة حسب الوقت المحجوز دون احتساب تأخير الكاشير"/>
                                        <Button Content="إضافة نصف ساعة"
                                                Command="{Binding DataContext.AddExtraTimeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                Foreground="White"
                                                BorderBrush="White"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </materialDesign:DialogHost>
</Page>

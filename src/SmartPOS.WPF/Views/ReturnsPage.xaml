<Page x:Class="SmartPOS.WPF.Views.ReturnsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      FlowDirection="RightToLeft"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded">

    <Grid Background="{DynamicResource AlAtmani.BackgroundBrush}"
          TextElement.Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}"
          Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <materialDesign:Card Grid.Row="0"
                             Style="{StaticResource AlAtmani.GlassCard}"
                             Margin="0,0,0,24"
                             Padding="24">
            <DockPanel>
                <Border DockPanel.Dock="Right" Background="{DynamicResource AlAtmani.Surface2Brush}"
                        CornerRadius="12"
                        Padding="12"
                        Margin="0,0,16,0"
                        VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="BackupRestore"
                                             Width="32"
                                             Height="32"
                                             Foreground="{DynamicResource AlAtmani.AccentBrush}"/>
                </Border>
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Loc_22c00814}"
                               Style="{StaticResource AlAtmani.HeaderText}"/>
                    <TextBlock Text="{DynamicResource Loc_701b2a2a}"
                               FontSize="14"
                               Opacity="0.85"
                               Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>
                
                <!-- Toolbar -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Command="{Binding LoadCommand}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="{DynamicResource Loc_fd4458ee}"
                            Foreground="{DynamicResource AlAtmani.AccentBrush}">
                        <materialDesign:PackIcon Kind="Refresh" Width="24" Height="24"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </materialDesign:Card>

        <!-- Statistics -->
        <Grid Grid.Row="1"
              Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total Returns -->
            <materialDesign:Card Grid.Column="0"
                                 Style="{StaticResource AlAtmani.GlassCard}"
                                 Margin="0,0,8,0"
                                 Padding="20">
                <StackPanel>
                    <Border Background="{DynamicResource AlAtmani.Surface2Brush}"
                            CornerRadius="12"
                            Padding="10"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,12">
                        <materialDesign:PackIcon Kind="ArrowULeftTop"
                                                 Width="32"
                                                 Height="32"
                                                 Foreground="{DynamicResource AlAtmani.AccentBrush}"/>
                    </Border>
                    <TextBlock Text="{DynamicResource Loc_b230751c}"
                               FontSize="14"
                               Opacity="0.7"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding TotalReturnsCount, FallbackValue=0}"
                                   FontSize="24"
                                   FontWeight="Bold"/>
                        <TextBlock Text=" " />
                        <TextBlock Text="{DynamicResource Loc_ReturnsCountSuffix}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Opacity="0.7"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,3"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>

            <!-- Pending -->
            <materialDesign:Card Grid.Column="1"
                                 Style="{StaticResource AlAtmani.GlassCard}"
                                 Margin="8,0,8,0"
                                 Padding="20">
                <StackPanel>
                    <Border Background="{DynamicResource AlAtmani.Surface2Brush}"
                            CornerRadius="12"
                            Padding="10"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,12">
                        <materialDesign:PackIcon Kind="ClockAlert"
                                                 Width="32"
                                                 Height="32"
                                                 Foreground="{DynamicResource AlAtmani.AccentBrush}"/>
                    </Border>
                    <TextBlock Text="{DynamicResource Loc_e722ee31}"
                               FontSize="14"
                               Opacity="0.7"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding PendingReturnsCount, FallbackValue=0}"
                                   FontSize="24"
                                   FontWeight="Bold"/>
                        <TextBlock Text=" " />
                        <TextBlock Text="{DynamicResource Loc_ReturnsCountSuffix}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Opacity="0.7"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,3"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>

            <!-- Approved -->
            <materialDesign:Card Grid.Column="2"
                                 Style="{StaticResource AlAtmani.GlassCard}"
                                 Margin="8,0,8,0"
                                 Padding="20">
                <StackPanel>
                    <Border Background="{DynamicResource AlAtmani.Surface2Brush}"
                            CornerRadius="12"
                            Padding="10"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,12">
                        <materialDesign:PackIcon Kind="CheckCircle"
                                                 Width="32"
                                                 Height="32"
                                                 Foreground="{DynamicResource AlAtmani.AccentBrush}"/>
                    </Border>
                    <TextBlock Text="{DynamicResource Loc_86532625}"
                               FontSize="14"
                               Opacity="0.7"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding ApprovedReturnsCount, FallbackValue=0}"
                                   FontSize="24"
                                   FontWeight="Bold"/>
                        <TextBlock Text=" " />
                        <TextBlock Text="{DynamicResource Loc_ReturnsCountSuffix}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Opacity="0.7"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,3"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>

            <!-- Total Amount -->
            <materialDesign:Card Grid.Column="3"
                                 Style="{StaticResource AlAtmani.GlassCard}"
                                 Margin="8,0,0,0"
                                 Padding="20">
                <StackPanel>
                    <Border Background="{DynamicResource AlAtmani.Surface2Brush}"
                            CornerRadius="12"
                            Padding="10"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,12">
                        <materialDesign:PackIcon Kind="CashRefund"
                                                 Width="32"
                                                 Height="32"
                                                 Foreground="{DynamicResource AlAtmani.AccentBrush}"/>
                    </Border>
                    <TextBlock Text="{DynamicResource Loc_ffb75c1f}"
                               FontSize="14"
                               Opacity="0.7"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding TotalReturnsAmount, StringFormat={}{0:N2}, FallbackValue=0.00}"
                                   FontSize="24"
                                   FontWeight="Bold"/>
                        <TextBlock Text=" " />
                        <TextBlock Text="{DynamicResource Loc_CurrencySymbol}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Opacity="0.7"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,3"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>
        </Grid>

        <!-- Returns List -->
        <materialDesign:Card Grid.Row="2"
                             Style="{StaticResource AlAtmani.GlassCard}"
                             Margin="0"
                             Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            Margin="0,0,0,15">
                    <TextBlock Text="{DynamicResource Loc_f2490359}"
                               Style="{StaticResource AlAtmani.SubHeaderText}"
                               Margin="0"/>

                    <Button Style="{StaticResource AlAtmani.SoftButton}"
                            Height="45"
                            Padding="20,0"
                            Content="{DynamicResource Loc_73660945}"
                            Margin="20,0,0,0"/>
                </StackPanel>

                <!-- Create Return Form -->
                <Grid Grid.Row="1"
                      Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding Sales}"
                              DisplayMemberPath="InvoiceNumber"
                              SelectedItem="{Binding SelectedSale}"
                              Margin="0,0,10,0"
                              materialDesign:HintAssist.Hint="{DynamicResource Loc_h_297e861e}"/>

                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding Reasons}"
                              SelectedItem="{Binding SelectedReason}"
                              Margin="0,0,10,0"
                              materialDesign:HintAssist.Hint="{DynamicResource Loc_h_a620c435}"/>

                    <TextBox Grid.Column="2"
                             Text="{Binding NotesInput, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,10,0"
                             materialDesign:HintAssist.Hint="{DynamicResource Loc_h_3c4208fe}"/>

                    <Button Grid.Column="3"
                            Style="{StaticResource AlAtmani.SoftButton}"
                            Height="45"
                            Content="{DynamicResource Loc_c6a764fd}"
                            Command="{Binding CreateReturnCommand}"/>
                </Grid>

                <!-- Filter Tabs -->
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            Margin="0,0,0,15">
                    <Button Content="{DynamicResource Loc_6d08f196}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Height="44"
                            Padding="20,10"
                            Margin="0,0,10,0"
                            Command="{Binding FilterAllCommand}"/>
                    <Button Content="{DynamicResource Loc_e722ee31}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Height="44"
                            Padding="20,10"
                            Margin="0,0,10,0"
                            Command="{Binding FilterPendingCommand}"/>
                    <Button Content="{DynamicResource Loc_86532625}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Height="44"
                            Padding="20,10"
                            Margin="0,0,10,0"
                            Command="{Binding FilterApprovedCommand}"/>
                    <Button Content="{DynamicResource Loc_20a971a3}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Height="44"
                            Padding="20,10"
                            Margin="0,0,10,0"
                            Command="{Binding FilterRejectedCommand}"/>
                    
                    <TextBox materialDesign:HintAssist.Hint="{DynamicResource Loc_h_fd836ba8}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Padding="8,6"
                             Width="280"
                             Margin="20,0,0,0"
                             materialDesign:TextFieldAssist.HasClearButton="True"
                             VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Returns DataGrid -->
                <DataGrid Grid.Row="3"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          Background="Transparent"
                          BorderThickness="0"
                          HeadersVisibility="Column"
                          FontSize="14"
                          ItemsSource="{Binding Returns}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource Loc_8dfd4eec}"
                                            Binding="{Binding ReturnNumber}"
                                            Width="*"/>
                        <DataGridTextColumn Header="{DynamicResource Loc_aad5385a}"
                                            Binding="{Binding Sale.InvoiceNumber}"
                                            Width="*"/>
                        <DataGridTextColumn Header="{DynamicResource Loc_2b9848ef}"
                                            Binding="{Binding Customer.Name}"
                                            Width="2*"/>
                        <DataGridTextColumn Header="{DynamicResource Loc_151d530a}"
                                            Binding="{Binding ReturnDate, StringFormat={}{0:yyyy-MM-dd}}"
                                            Width="*"/>
                        <DataGridTextColumn Header="{DynamicResource Loc_1f02fd5e}"
                                            Binding="{Binding Reason}"
                                            Width="*"/>
                        <DataGridTextColumn Header="{DynamicResource Loc_faba469e}"
                                            Binding="{Binding TotalAmount, StringFormat={}{0:N2} ج.م}"
                                            Width="*"/>
                        <DataGridTemplateColumn Header="{DynamicResource Loc_1253eb56}" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Padding="12,4" CornerRadius="12" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#F3F4F6"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                        <Setter Property="Background" Value="#FEF3C7"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Approved">
                                                        <Setter Property="Background" Value="#DCFCE7"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Rejected">
                                                        <Setter Property="Background" Value="#FEE2E2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontWeight="SemiBold" FontSize="12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#4B5563"/>
                                                    <Setter Property="Text" Value="غير محدد"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                            <Setter Property="Foreground" Value="#D97706"/>
                                                            <Setter Property="Text" Value="قيد الانتظار"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Approved">
                                                            <Setter Property="Foreground" Value="#15803D"/>
                                                            <Setter Property="Text" Value="تم القبول"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Rejected">
                                                            <Setter Property="Foreground" Value="#B91C1C"/>
                                                            <Setter Property="Text" Value="مرفوض"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{DynamicResource Loc_901efe9b}"
                                                Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                 <DataTemplate>
                                     <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                         <Button Style="{StaticResource MaterialDesignIconButton}"
                                                 ToolTip="{DynamicResource Loc_6f239548}"
                                                 Width="34" Height="34" Margin="2,0">
                                             <materialDesign:PackIcon Kind="Check" Width="20" Height="20" Foreground="#10B981"/>
                                             <Button.Command>
                                                 <Binding Path="DataContext.ApproveReturnCommand"
                                                          RelativeSource="{RelativeSource AncestorType=Page}"/>
                                             </Button.Command>
                                             <Button.CommandParameter>
                                                 <Binding/>
                                             </Button.CommandParameter>
                                         </Button>
                                         <Button Style="{StaticResource MaterialDesignIconButton}"
                                                 ToolTip="{DynamicResource Loc_483649d1}"
                                                 Width="34" Height="34" Margin="2,0">
                                             <materialDesign:PackIcon Kind="Close" Width="20" Height="20" Foreground="#FB7185"/>
                                             <Button.Command>
                                                 <Binding Path="DataContext.RejectReturnCommand"
                                                          RelativeSource="{RelativeSource AncestorType=Page}"/>
                                             </Button.Command>
                                             <Button.CommandParameter>
                                                 <Binding/>
                                             </Button.CommandParameter>
                                         </Button>
                                     </StackPanel>
                                 </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </materialDesign:Card>
    </Grid>
</Page>

<Page x:Class="SmartPOS.WPF.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d"
      d:DesignHeight="800"
      d:DesignWidth="1400"
      Title="لوحة المعلومات"
      FontFamily="Segoe UI, Tahoma"
      FlowDirection="RightToLeft"
      Loaded="Page_Loaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  Background="{DynamicResource AlAtmani.BackgroundBrush}">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header (Glass) -->
            <materialDesign:Card Grid.Row="0"
                                 Style="{StaticResource AlAtmani.GlassCard}"
                                 Margin="0,0,0,20">
                <DockPanel LastChildFill="True">
                    <Border Background="{DynamicResource AlAtmani.Surface2Brush}"
                            CornerRadius="18"
                            Padding="12"
                            DockPanel.Dock="Right"
                            Margin="0,0,16,0"
                            Effect="{StaticResource AlAtmani.CyanGlow}">
                        <materialDesign:PackIcon Kind="ViewDashboard"
                                                 Width="34"
                                                 Height="34"
                                                 Foreground="{DynamicResource AlAtmani.AccentBrush}"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="لوحة المعلومات"
                                   Style="{StaticResource AlAtmani.HeaderText}"
                                   Margin="0"/>
                        <TextBlock Text="{Binding Source={x:Static system:DateTime.Now}, StringFormat='اليوم: {0:dddd، dd MMMM yyyy}'}"
                                   xmlns:system="clr-namespace:System;assembly=mscorlib"
                                   FontSize="13"
                                   Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Left"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Content="تحديث"
                                Style="{StaticResource AlAtmani.SoftButton}"
                                Height="42"
                                Padding="18,0"
                                Command="{Binding LoadDashboardDataCommand}"
                                ToolTip="تحديث بيانات لوحة المعلومات"/>
                    </StackPanel>
                </DockPanel>
            </materialDesign:Card>

            <!-- Bento Grid -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Card: Today Sales (Large) -->
                <materialDesign:Card Grid.Row="0"
                                     Grid.Column="0"
                                     Grid.ColumnSpan="5"
                                     Style="{StaticResource AlAtmani.GlassCard}"
                                     Margin="0,0,16,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="56"
                                Height="56"
                                CornerRadius="18"
                                Background="{DynamicResource AlAtmani.Surface2Brush}"
                                VerticalAlignment="Top"
                                Effect="{StaticResource AlAtmani.CyanGlow}">
                            <materialDesign:PackIcon Kind="CashMultiple"
                                                     Width="30"
                                                     Height="30"
                                                     Foreground="{DynamicResource AlAtmani.AccentBrush}"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1"
                                    Margin="16,0,0,0">
                            <TextBlock Text="مبيعات اليوم"
                                       FontSize="13"
                                       Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding TodaySales, StringFormat='{}{0:N2} ج.م'}"
                                       FontSize="34"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}"
                                       Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding TodayTransactions, StringFormat='{}{0} عملية بيع'}"
                                       FontSize="12"
                                       Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}"
                                       Margin="0,10,0,0"/>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>

                <!-- Card: Today Profit -->
                <materialDesign:Card Grid.Row="0"
                                     Grid.Column="5"
                                     Grid.ColumnSpan="4"
                                     Style="{StaticResource AlAtmani.GlassCard}"
                                     Margin="0,0,16,16">
                    <StackPanel>
                        <DockPanel>
                            <Border Background="#1A2A35"
                                    CornerRadius="18"
                                    Padding="12"
                                    DockPanel.Dock="Right"
                                    Effect="{StaticResource AlAtmani.CyanGlow}">
                                <materialDesign:PackIcon Kind="TrendingUp"
                                                         Width="28"
                                                         Height="28"
                                                         Foreground="{DynamicResource AlAtmani.AccentBrush}"/>
                            </Border>
                            <StackPanel Margin="16,0,0,0">
                                <TextBlock Text="ربح اليوم"
                                           FontSize="13"
                                           Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding TodayProfit, StringFormat='{}{0:N2} ج.م'}"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="صافي الربح"
                                   FontSize="12"
                                   Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}"
                                   Margin="0,12,0,0"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Card: Low Stock Alert -->
                <materialDesign:Card Grid.Row="0"
                                     Grid.Column="9"
                                     Grid.ColumnSpan="3"
                                     Style="{StaticResource AlAtmani.GlassCard}"
                                     Margin="0,0,0,16">
                    <StackPanel>
                        <DockPanel>
                            <Border Background="#2A1B2B"
                                    CornerRadius="18"
                                    Padding="12"
                                    DockPanel.Dock="Right">
                                <materialDesign:PackIcon Kind="AlertCircle"
                                                         Width="28"
                                                         Height="28"
                                                         Foreground="#FB7185"/>
                            </Border>
                            <StackPanel Margin="16,0,0,0">
                                <TextBlock Text="نقص المخزون"
                                           FontSize="13"
                                           Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding LowStockCount}"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="منتجات تحتاج إعادة التخزين"
                                   FontSize="12"
                                   Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}"
                                   Margin="0,12,0,0"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Card: Current Shift Sales -->
                <materialDesign:Card Grid.Row="1"
                                     Grid.Column="0"
                                     Grid.ColumnSpan="5"
                                     Style="{StaticResource AlAtmani.GlassCard}"
                                     Margin="0,0,16,16">
                    <StackPanel>
                        <DockPanel>
                            <Border Background="#1C2336"
                                    CornerRadius="18"
                                    Padding="12"
                                    DockPanel.Dock="Right">
                                <materialDesign:PackIcon Kind="ClockOutline"
                                                         Width="28"
                                                         Height="28"
                                                         Foreground="{DynamicResource AlAtmani.AccentBrush}"/>
                            </Border>
                            <StackPanel Margin="16,0,0,0">
                                <TextBlock Text="الوردية الحالية"
                                           FontSize="13"
                                           Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding CurrentShiftSales, StringFormat='{}{0:N2} ج.م'}"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <!-- Active shift indicator -->
                        <Grid Margin="0,12,0,0">
                            <TextBlock Text="مبيعات الوردية النشطة"
                                       FontSize="12"
                                       Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}"
                                       Visibility="{Binding HasActiveShift, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Text="لا توجد وردية نشطة"
                                       FontSize="12"
                                       Foreground="#FB7185"
                                       FontWeight="SemiBold"
                                       Visibility="{Binding HasActiveShift, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>
                
                <!-- Card: Total Products -->
                <materialDesign:Card Grid.Row="1"
                                     Grid.Column="5"
                                     Grid.ColumnSpan="3"
                                     Style="{StaticResource AlAtmani.GlassCard}"
                                     Margin="0,0,16,16">
                    <StackPanel>
                        <DockPanel>
                            <Border Background="#2B281B"
                                    CornerRadius="18"
                                    Padding="12"
                                    DockPanel.Dock="Right">
                                <materialDesign:PackIcon Kind="PackageVariant"
                                                         Width="28"
                                                         Height="28"
                                                         Foreground="#EAB308"/>
                            </Border>
                            <StackPanel Margin="16,0,0,0">
                                <TextBlock Text="المنتجات"
                                           FontSize="13"
                                           Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding TotalProducts}"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="إجمالي المنتجات المتاحة"
                                   FontSize="12"
                                   Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}"
                                   Margin="0,12,0,0"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Card: Total Customers -->
                <materialDesign:Card Grid.Row="1"
                                     Grid.Column="8"
                                     Grid.ColumnSpan="4"
                                     Style="{StaticResource AlAtmani.GlassCard}"
                                     Margin="0,0,0,16">
                    <StackPanel>
                        <DockPanel>
                            <Border Background="#1C352D"
                                    CornerRadius="18"
                                    Padding="12"
                                    DockPanel.Dock="Right">
                                <materialDesign:PackIcon Kind="AccountGroup"
                                                         Width="28"
                                                         Height="28"
                                                         Foreground="#22C55E"/>
                            </Border>
                            <StackPanel Margin="16,0,0,0">
                                <TextBlock Text="العملاء"
                                           FontSize="13"
                                           Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding TotalCustomers}"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="قاعدة بيانات العملاء"
                                   FontSize="12"
                                   Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}"
                                   Margin="0,12,0,0"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Card: Recent Sales (Bento chips / WrapPanel) -->
                <materialDesign:Card Grid.Row="2"
                                     Grid.Column="0"
                                     Grid.ColumnSpan="4"
                                     Style="{StaticResource AlAtmani.GlassCard}"
                                     Margin="0,0,16,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="نشاط المبيعات"
                                       Style="{StaticResource AlAtmani.SubHeaderText}"
                                       DockPanel.Dock="Right"
                                       Margin="0"/>
                            <TextBlock Text="آخر العمليات"
                                       DockPanel.Dock="Left"
                                       FontSize="12"
                                       Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </DockPanel>

                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto"
                                      Height="240">
                            <ItemsControl ItemsSource="{Binding RecentSales}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="18"
                                                BorderBrush="{DynamicResource AlAtmani.BorderBrush}"
                                                BorderThickness="1"
                                                Background="{DynamicResource AlAtmani.Surface2Brush}"
                                                Margin="0,0,12,12"
                                                Padding="12">
                                            <StackPanel>
                                                <TextBlock Text="{Binding InvoiceNumber, StringFormat=فاتورة: {0}}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding SaleDate, StringFormat='{}{0:dd/MM HH:mm}'}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}"
                                                           Margin="0,6,0,0"/>
                                                <TextBlock Text="{Binding TotalAmount, StringFormat='{}{0:N2} ج.م'}"
                                                           FontSize="13"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource AlAtmani.AccentBrush}"
                                                           Margin="0,10,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Card: Low Stock Products (compact) -->
                <materialDesign:Card Grid.Row="2"
                                     Grid.Column="4"
                                     Grid.ColumnSpan="4"
                                     Style="{StaticResource AlAtmani.GlassCard}"
                                     Margin="0,0,16,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="المخزون المنخفض"
                                       Style="{StaticResource AlAtmani.SubHeaderText}"
                                       DockPanel.Dock="Right"
                                       Margin="0"/>
                            <TextBlock Text="مراجعة سريعة"
                                       DockPanel.Dock="Left"
                                       FontSize="12"
                                       Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </DockPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Height="240">
                            <ItemsControl ItemsSource="{Binding LowStockProducts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="16"
                                                BorderBrush="{DynamicResource AlAtmani.BorderBrush}"
                                                BorderThickness="1"
                                                Background="{DynamicResource AlAtmani.Surface2Brush}"
                                                Padding="14"
                                                Margin="0,0,0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}"
                                                               TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Category.Name}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}"
                                                               Margin="0,6,0,0"/>
                                                </StackPanel>
                                                <Border Grid.Column="1"
                                                        Background="#2A1B2B"
                                                        CornerRadius="14"
                                                        Padding="10,6"
                                                        VerticalAlignment="Top"
                                                        Margin="12,0,0,0">
                                                    <TextBlock Text="{Binding Stock, StringFormat=متبقي: {0}}"
                                                               FontWeight="Bold"
                                                               Foreground="#FB7185"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </materialDesign:Card>
                <!-- Card: AI Stock Predictor (New Feature) -->
                <materialDesign:Card Grid.Row="2"
                                     Grid.Column="8"
                                     Grid.ColumnSpan="4"
                                     Style="{StaticResource AlAtmani.GlassCard}"
                                     Margin="0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="المخزون الذكي AI 🤖"
                                       Style="{StaticResource AlAtmani.SubHeaderText}"
                                       DockPanel.Dock="Right"
                                       Margin="0"/>
                            <TextBlock Text="تنبؤ بالاستهلاك"
                                       DockPanel.Dock="Left"
                                       FontSize="12"
                                       Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </DockPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Height="240">
                            <ItemsControl ItemsSource="{Binding AiStockPredictions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="16"
                                                BorderBrush="{DynamicResource AlAtmani.BorderBrush}"
                                                BorderThickness="1"
                                                Background="{DynamicResource AlAtmani.Surface2Brush}"
                                                Padding="14"
                                                Margin="0,0,0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding ProductName}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}"
                                                               TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding AlertMessage}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource AlAtmani.AccentBrush}"
                                                               Margin="0,6,0,0"/>
                                                    <TextBlock Text="{Binding SuggestedRestockQuantity, StringFormat='اطلب: {0} وحدة'}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}"
                                                               Margin="0,4,0,0"/>
                                                </StackPanel>
                                                <Border Grid.Column="1"
                                                        Background="#2A1B2B"
                                                        CornerRadius="14"
                                                        Padding="10,6"
                                                        VerticalAlignment="Top"
                                                        Margin="12,0,0,0">
                                                    <TextBlock Text="{Binding DaysUntilStockout, StringFormat='{}{0} أيام'}"
                                                               FontWeight="Bold"
                                                               Foreground="#FB7185"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>

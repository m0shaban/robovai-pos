<Page x:Class="SmartPOS.WPF.Views.CustomersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="العملاء"
      FontFamily="Segoe UI, Tahoma"
      FlowDirection="RightToLeft"
      Loaded="Page_Loaded">

    <Grid Background="{DynamicResource AlAtmani.BackgroundBrush}"
          Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <materialDesign:Card Grid.Row="0"
                             Style="{StaticResource AlAtmani.GlassCard}">
            <DockPanel>
                <Border Background="#E3F2FD"
                        CornerRadius="12"
                        Padding="12"
                        DockPanel.Dock="Right"
                        Margin="0,0,16,0">
                    <materialDesign:PackIcon Kind="AccountGroup"
                                             Width="36"
                                             Height="36"
                                             Foreground="#1976D2"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="إدارة العملاء"
                               Style="{StaticResource AlAtmani.HeaderText}"
                               Margin="0"/>
                    <TextBlock Text="إضافة وتعديل بيانات العملاء"
                               FontSize="13"
                               Foreground="#1976D2"
                               Opacity="0.8"/>
                </StackPanel>

                <!-- Toolbar -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Command="{Binding LoadCustomersCommand}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="تحديث البيانات"
                            Margin="0,0,16,0"
                            Foreground="#1976D2">
                        <materialDesign:PackIcon Kind="Refresh" Width="24" Height="24"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </materialDesign:Card>

        <materialDesign:Card Grid.Row="1"
                             Padding="16"
                             Margin="0,0,0,16"
                             Style="{StaticResource AlAtmani.GlassCard}"
                             Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBox Grid.Column="0"
                         materialDesign:HintAssist.Hint="اسم العميل"
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         Height="45"
                         Margin="0,0,12,12"/>
                <TextBox Grid.Column="1"
                         materialDesign:HintAssist.Hint="الهاتف"
                         Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                         Height="45"
                         Margin="0,0,12,12"/>
                <TextBox Grid.Column="2"
                         materialDesign:HintAssist.Hint="البريد"
                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         Height="45"
                         Margin="0,0,12,12"/>
                <TextBox Grid.Column="3"
                         materialDesign:HintAssist.Hint="الحد الائتماني"
                         Text="{Binding CreditLimit, StringFormat={}{0:0.##}}"
                         Height="45"
                         Margin="0,0,0,12"/>

                <TextBox Grid.Row="1"
                         Grid.Column="0"
                         materialDesign:HintAssist.Hint="العنوان"
                         Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                         Height="45"
                         Margin="0,0,12,0"/>
                <TextBox Grid.Row="1"
                         Grid.Column="1"
                         materialDesign:HintAssist.Hint="ملاحظات"
                         Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                         Height="45"
                         Margin="0,0,12,0"/>

                <CheckBox Grid.Row="1"
                          Grid.Column="2"
                          IsChecked="{Binding FormIsActive}"
                          Content="عميل نشط"
                          Style="{StaticResource MaterialDesignFilterChipPrimaryOutlineCheckBox}"
                          VerticalAlignment="Center"
                          Margin="0,0,12,0" Height="45"/>
                <StackPanel Grid.Row="1"
                            Grid.Column="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="حفظ"
                            Style="{StaticResource AlAtmani.SoftButton}"
                            Width="120"
                            Height="45"
                            Command="{Binding SaveCustomerCommand}"
                            Margin="0,0,12,0"/>
                    <Button Content="تفريغ"
                            Style="{StaticResource AlAtmani.SoftButton}"
                            Width="120"
                            Height="45"
                            Command="{Binding ClearFormCommand}"/>
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <materialDesign:Card Grid.Row="2"
                             Style="{StaticResource AlAtmani.GlassCard}"
                             Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Search Bar -->
                <Grid Grid.Row="0" Margin="16">
                    <TextBox materialDesign:HintAssist.Hint="ابحث بالاسم، أو رقم الهاتف، أو البريد الإلكتروني..."
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Padding="8"
                             materialDesign:TextFieldAssist.HasClearButton="True"/>
                </Grid>

                <DataGrid Grid.Row="1"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          ItemsSource="{Binding Customers}"
                          SelectedItem="{Binding SelectedCustomer}"
                          materialDesign:DataGridAssist.CellPadding="12,8">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الاسم"
                                        Binding="{Binding Name}"
                                        Width="2*"/>
                    <DataGridTextColumn Header="الهاتف"
                                        Binding="{Binding Phone}"
                                        Width="*"/>
                    <DataGridTextColumn Header="البريد"
                                        Binding="{Binding Email}"
                                        Width="*"/>
                    <DataGridTextColumn Header="العنوان"
                                        Binding="{Binding Address}"
                                        Width="2*"/>
                    <DataGridTextColumn Header="الحد الائتماني"
                                        Binding="{Binding CreditLimit, StringFormat='{}{0:F2} ج.م'}"
                                        Width="*"/>

                    <!-- Status Indicator -->
                    <DataGridTemplateColumn Header="الحالة" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="12"
                                        Padding="12,4"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#E3F2FD"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                    <Setter Property="Background" Value="#FFEBEE"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontWeight="SemiBold" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="نشط"/>
                                                <Setter Property="Foreground" Value="#1565C0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                        <Setter Property="Text" Value="موقوف"/>
                                                        <Setter Property="Foreground" Value="#C62828"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="إجراءات"
                                            Width="140"
                                            Visibility="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            ToolTip="كشف حساب / فواتير"
                                            Width="34" Height="34" Margin="2,0"
                                            Click="BtnViewInvoices_Click" Tag="{Binding}">
                                        <materialDesign:PackIcon Kind="ReceiptText" Width="20" Height="20" Foreground="#10B981"/>
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            ToolTip="تعديل"
                                            Width="34" Height="34" Margin="2,0"
                                            Command="{Binding DataContext.EditCustomerCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}">
                                        <materialDesign:PackIcon Kind="Pencil" Width="20" Height="20" Foreground="{DynamicResource AlAtmani.AccentBrush}"/>
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            ToolTip="حذف"
                                            Width="34" Height="34" Margin="2,0"
                                            Command="{Binding DataContext.DeleteCustomerCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}">
                                        <materialDesign:PackIcon Kind="Delete" Width="20" Height="20" Foreground="#FB7185"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            </Grid>
        </materialDesign:Card>
    </Grid>
</Page>

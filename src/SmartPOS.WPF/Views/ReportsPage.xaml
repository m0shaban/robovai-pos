<Page x:Class="SmartPOS.WPF.Views.ReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      Title="التقارير"
      FontFamily="Segoe UI, Tahoma"
      FlowDirection="RightToLeft"
      Loaded="Page_Loaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Background="{DynamicResource AlAtmani.BackgroundBrush}"
              Margin="24">
            <StackPanel>
                <!-- Header -->
                <materialDesign:Card Style="{StaticResource AlAtmani.GlassCard}"
                                     Margin="0,0,0,24"
                                     Padding="24">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#E1F5FE"
                                CornerRadius="12"
                                Padding="12"
                                Margin="0,0,16,0"
                                VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="ChartLine"
                                                     Width="32"
                                                     Height="32"
                                                     Foreground="#0288D1"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="التقارير والإحصائيات"
                                       Style="{StaticResource AlAtmani.HeaderText}"/>
                            <TextBlock Text="عرض تقارير المبيعات والأرباح والمصروفات"
                                       FontSize="14"
                                       Opacity="0.7"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Statistics Cards -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Today Sales -->
                    <materialDesign:Card Grid.Column="0"
                                         Style="{StaticResource AlAtmani.GlassCard}"
                                         Margin="0,0,8,0"
                                         Padding="20">
                        <StackPanel>
                            <Border Background="#E8F5E9"
                                    CornerRadius="12"
                                    Padding="10"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,12">
                                <materialDesign:PackIcon Kind="CashMultiple"
                                                         Width="32"
                                                         Height="32"
                                                         Foreground="#4CAF50"/>
                            </Border>
                            <TextBlock Text="مبيعات اليوم"
                                       FontSize="14"
                                       Opacity="0.7"/>
                            <TextBlock x:Name="TodaySalesText"
                                       Text="0.00 ج.م"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Margin="0,4,0,0"/>
                            <TextBlock x:Name="TodayTransactionsText"
                                       Text="0 عملية"
                                       FontSize="12"
                                       Opacity="0.6"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Today Profit -->
                    <materialDesign:Card Grid.Column="1"
                                         Style="{StaticResource AlAtmani.GlassCard}"
                                         Margin="8,0,8,0"
                                         Padding="20">
                        <StackPanel>
                            <Border Background="#E8F5E9"
                                    CornerRadius="12"
                                    Padding="10"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,12">
                                <materialDesign:PackIcon Kind="TrendingUp"
                                                         Width="32"
                                                         Height="32"
                                                         Foreground="#4CAF50"/>
                            </Border>
                            <TextBlock Text="ربح اليوم"
                                       FontSize="14"
                                       Opacity="0.7"/>
                            <TextBlock x:Name="TodayProfitText"
                                       Text="0.00 ج.م"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="#4CAF50"
                                       Margin="0,4,0,0"/>
                            <TextBlock Text="صافي الربح"
                                       FontSize="12"
                                       Opacity="0.6"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Month Sales -->
                    <materialDesign:Card Grid.Column="2"
                                         Style="{StaticResource AlAtmani.GlassCard}"
                                         Margin="8,0,8,0"
                                         Padding="20">
                        <StackPanel>
                            <Border Background="#FFF3E0"
                                    CornerRadius="12"
                                    Padding="10"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,12">
                                <materialDesign:PackIcon Kind="CalendarMonth"
                                                         Width="32"
                                                         Height="32"
                                                         Foreground="#FF9800"/>
                            </Border>
                            <TextBlock Text="مبيعات الشهر"
                                       FontSize="14"
                                       Opacity="0.7"/>
                            <TextBlock x:Name="MonthSalesText"
                                       Text="0.00 ج.م"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="#FF9800"
                                       Margin="0,4,0,0"/>
                            <TextBlock Text="إجمالي الشهر"
                                       FontSize="12"
                                       Opacity="0.6"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Expenses -->
                    <materialDesign:Card Grid.Column="3"
                                         Style="{StaticResource AlAtmani.GlassCard}"
                                         Margin="8,0,0,0"
                                         Padding="20">
                        <StackPanel>
                            <Border Background="#FFEBEE"
                                    CornerRadius="12"
                                    Padding="10"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,12">
                                <materialDesign:PackIcon Kind="CurrencyUsd"
                                                         Width="32"
                                                         Height="32"
                                                         Foreground="#F44336"/>
                            </Border>
                            <TextBlock Text="مصروفات الشهر"
                                       FontSize="14"
                                       Opacity="0.7"/>
                            <TextBlock x:Name="TotalExpensesText"
                                       Text="0.00 ج.م"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="#F44336"
                                       Margin="0,4,0,0"/>
                            <TextBlock Text="إجمالي المصروفات"
                                       FontSize="12"
                                       Opacity="0.6"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </materialDesign:Card>
                </Grid>

                <!-- Interactive Charts -->
                <materialDesign:Card Style="{StaticResource AlAtmani.GlassCard}"
                                     Padding="20"
                                     Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="الرسوم البيانية التفاعلية"
                                   FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="16"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Bar Chart: Daily Sales -->
                            <materialDesign:Card Grid.Column="0" Grid.Row="0"
                                                 UniformCornerRadius="12"
                                                 Background="#0D1B2E"
                                                 Padding="16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <materialDesign:PackIcon Kind="ChartBar" Width="20" Height="20"
                                                                 Foreground="#06B6D4" Margin="0,0,8,0"
                                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="مبيعات آخر 7 أيام"
                                                   FontSize="15" FontWeight="SemiBold"
                                                   Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <lvc:CartesianChart Height="220"
                                                        Series="{Binding SalesChartSeries}"
                                                        XAxes="{Binding SalesChartXAxes}"
                                                        Background="Transparent"
                                                        FlowDirection="LeftToRight"
                                                        ZoomMode="X"/>
                                </StackPanel>
                            </materialDesign:Card>

                            <!-- Pie Chart: Category Split -->
                            <materialDesign:Card Grid.Column="2" Grid.Row="0"
                                                 UniformCornerRadius="12"
                                                 Background="#0D1B2E"
                                                 Padding="16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <materialDesign:PackIcon Kind="ChartDonut" Width="20" Height="20"
                                                                 Foreground="#F59E0B" Margin="0,0,8,0"
                                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="مبيعات الشهر حسب التصنيف"
                                                   FontSize="15" FontWeight="SemiBold"
                                                   Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Grid Height="220">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <lvc:PieChart Grid.Column="0"
                                                      Series="{Binding CategoryChartSeries}"
                                                      Background="Transparent"
                                                      InitialRotation="-90"
                                                      IsClockwise="True"
                                                      LegendPosition="Hidden"/>
                                        <ItemsControl Grid.Column="1" 
                                                      ItemsSource="{Binding CategoryLegend}" 
                                                      VerticalAlignment="Center" 
                                                      Margin="16,0,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                                        <Ellipse Width="12" Height="12" Fill="{Binding Color}" Margin="0,0,0,0"/>
                                                        <TextBlock Text="{Binding Name}" Foreground="#94A3B8" Margin="8,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Value, StringFormat={}{0:N2}}" Foreground="#E2E8F0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </StackPanel>
                            </materialDesign:Card>

                            <!-- Line Chart: Daily Profit -->
                            <materialDesign:Card Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="2"
                                                 UniformCornerRadius="12"
                                                 Background="#0D1B2E"
                                                 Padding="16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <materialDesign:PackIcon Kind="TrendingUp" Width="20" Height="20"
                                                                 Foreground="#10B981" Margin="0,0,8,0"
                                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="منحنى الربح اليومي (آخر 7 أيام)"
                                                   FontSize="15" FontWeight="SemiBold"
                                                   Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <lvc:CartesianChart Height="180"
                                                        Series="{Binding ProfitChartSeries}"
                                                        XAxes="{Binding SalesChartXAxes}"
                                                        Background="Transparent"
                                                        FlowDirection="LeftToRight"/>
                                </StackPanel>
                            </materialDesign:Card>
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Date Filter -->
                <materialDesign:Card Style="{StaticResource ModernCard}"
                                     Padding="20"
                                     Margin="0,0,0,16">
                    <DockPanel>
                        <TextBlock Text="فلترة حسب التاريخ:"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   DockPanel.Dock="Left"
                                   VerticalAlignment="Center"
                                   Margin="0,0,16,0"/>

                        <Button DockPanel.Dock="Right"
                                Content="بحث"
                                Width="120"
                                Height="40"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Command="{Binding FilterReportsCommand}"/>

                        <StackPanel Orientation="Horizontal"
                                    DockPanel.Dock="Right"
                                    Margin="0,0,16,0">
                            <DatePicker x:Name="StartDatePicker"
                                        materialDesign:HintAssist.Hint="من تاريخ"
                                        Width="150"
                                        SelectedDate="{Binding StartDate}"
                                        Margin="0,0,16,0"/>
                            <DatePicker x:Name="EndDatePicker"
                                        materialDesign:HintAssist.Hint="إلى تاريخ"
                                        SelectedDate="{Binding EndDate}"
                                        Width="150"/>
                        </StackPanel>
                    </DockPanel>
                </materialDesign:Card>

                <!-- Printing Controls -->
                <materialDesign:Card Style="{StaticResource ModernCard}"
                                     Padding="20"
                                     Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="إصدار تقارير شاملة:"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,24,0"/>
                        
                        <Button Width="180"
                                Height="40"
                                Margin="0,0,16,0"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="#673AB7"
                                BorderBrush="#673AB7"
                                Command="{Binding PrintPurchasesReportCommand}">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Printer" Width="20" Height="20" Margin="0,0,8,0"/>
                                    <TextBlock Text="كشف المشتريات"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>

                        <Button Width="180"
                                Height="40"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="#009688"
                                BorderBrush="#009688"
                                Command="{Binding PrintIncomeReportCommand}">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FilePdfBox" Width="20" Height="20" Margin="0,0,8,0"/>
                                    <TextBlock Text="كشف الإيرادات"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Inventory & Custom Period -->
                <materialDesign:Card Style="{StaticResource ModernCard}"
                                     Padding="20"
                                     Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Inventory Valuation -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="قيمة المخزون"
                                       FontSize="14"
                                       Opacity="0.7"/>
                            <TextBlock Text="{Binding InventoryValuation, StringFormat={}{0:N2} ج.م}"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="#673AB7"
                                       Margin="0,8,0,0"/>
                        </StackPanel>

                        <!-- Custom Period Sales -->
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="مبيعات الفترة"
                                       FontSize="14"
                                       Opacity="0.7"/>
                            <TextBlock Text="{Binding CustomPeriodSales, StringFormat={}{0:N2} ج.م}"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="#1976D2"
                                       Margin="0,8,0,0"/>
                        </StackPanel>

                        <!-- Custom Period Profit -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="أرباح الفترة"
                                       FontSize="14"
                                       Opacity="0.7"/>
                            <TextBlock Text="{Binding CustomPeriodProfit, StringFormat={}{0:N2} ج.م}"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="#388E3C"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>

                <!-- Recent Sales -->
                <materialDesign:Card Padding="16"
                                     Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="أحدث المبيعات"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,16"/>
                        <DataGrid x:Name="RecentSalesGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  MaxHeight="300"
                                  materialDesign:DataGridAssist.CellPadding="8">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="رقم الفاتورة"
                                                    Binding="{Binding InvoiceNumber}"
                                                    Width="120"/>
                                <DataGridTextColumn Header="التاريخ"
                                                    Binding="{Binding SaleDate, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"
                                                    Width="150"/>
                                <DataGridTextColumn Header="الكاشير"
                                                    Binding="{Binding User.FullName}"
                                                    Width="*"/>
                                <DataGridTextColumn Header="الإجمالي"
                                                    Binding="{Binding TotalAmount, StringFormat='{}{0:F2} ج.م'}"
                                                    Width="120"/>
                                <DataGridTextColumn Header="طريقة الدفع"
                                                    Binding="{Binding PaymentMethod}"
                                                    Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Top Products -->
                <materialDesign:Card Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="أكثر المنتجات مبيعاً"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,16"/>
                        <DataGrid x:Name="TopProductsGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  MaxHeight="300"
                                  materialDesign:DataGridAssist.CellPadding="8">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="اسم المنتج"
                                                    Binding="{Binding Name}"
                                                    Width="*"/>
                                <DataGridTextColumn Header="التصنيف"
                                                    Binding="{Binding Category.Name}"
                                                    Width="150"/>
                                <DataGridTextColumn Header="السعر"
                                                    Binding="{Binding SellingPrice, StringFormat='{}{0:F2} ج.م'}"
                                                    Width="100"/>
                                <DataGridTextColumn Header="المخزون الحالي"
                                                    Binding="{Binding Stock}"
                                                    Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Advanced Reports TabControl -->
                <materialDesign:Card Padding="16" Margin="0,0,0,16" Style="{StaticResource AlAtmani.GlassCard}">
                    <TabControl Style="{StaticResource MaterialDesignTabControl}">

                        <!-- Profit Report Tab -->
                        <TabItem Header="📊 تقرير الأرباح">
                            <StackPanel Margin="16">
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <DatePicker Grid.Column="0" materialDesign:HintAssist.Hint="من تاريخ"
                                                SelectedDate="{Binding ProfitStartDate}" Width="140" Margin="0,0,8,0"/>
                                    <DatePicker Grid.Column="1" materialDesign:HintAssist.Hint="إلى تاريخ"
                                                SelectedDate="{Binding ProfitEndDate}" Width="140" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding TotalGrossProfit, StringFormat='إجمالي الربح: {0:N2} ج.م'}"
                                               FontSize="18" FontWeight="Bold" Foreground="#2E7D32" VerticalAlignment="Center"/>
                                    <Button Grid.Column="3" Content="تحميل" Command="{Binding LoadProfitReportCommand}"
                                            Style="{StaticResource AlAtmani.SoftButton}" Margin="0,0,8,0" Padding="16,8"/>
                                    <Button Grid.Column="4" Content="تصدير CSV" Command="{Binding ExportProfitToCsvCommand}"
                                            Style="{StaticResource AlAtmani.SoftButton}" Padding="16,8"/>
                                </Grid>
                                <DataGrid ItemsSource="{Binding ProfitItems}" AutoGenerateColumns="False"
                                          IsReadOnly="True" CanUserAddRows="False" MaxHeight="350"
                                          materialDesign:DataGridAssist.CellPadding="8">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="المنتج" Binding="{Binding ProductName}" Width="2*"/>
                                        <DataGridTextColumn Header="الكمية المباعة" Binding="{Binding TotalQuantity}" Width="*"/>
                                        <DataGridTextColumn Header="الإيراد" Binding="{Binding TotalRevenue, StringFormat='{}{0:N2}'}" Width="*"/>
                                        <DataGridTextColumn Header="التكلفة" Binding="{Binding TotalCost, StringFormat='{}{0:N2}'}" Width="*"/>
                                        <DataGridTextColumn Header="الربح الإجمالي" Binding="{Binding GrossProfit, StringFormat='{}{0:N2}'}" Width="*"/>
                                        <DataGridTextColumn Header="هامش الربح %" Binding="{Binding MarginPct, StringFormat='{}{0:F1}%'}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </TabItem>

                        <!-- Cashier Stats Tab -->
                        <TabItem Header="👤 أداء الكاشير">
                            <StackPanel Margin="16">
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <DatePicker Grid.Column="0" materialDesign:HintAssist.Hint="من تاريخ"
                                                SelectedDate="{Binding CashierStatsStart}" Width="140" Margin="0,0,8,0"/>
                                    <DatePicker Grid.Column="1" materialDesign:HintAssist.Hint="إلى تاريخ"
                                                SelectedDate="{Binding CashierStatsEnd}" Width="140" Margin="0,0,8,0"/>
                                    <Button Grid.Column="3" Content="تحميل إحصائيات" Command="{Binding LoadCashierStatsCommand}"
                                            Style="{StaticResource AlAtmani.SoftButton}" Padding="16,8"/>
                                </Grid>
                                <DataGrid ItemsSource="{Binding CashierStats}" AutoGenerateColumns="False"
                                          IsReadOnly="True" CanUserAddRows="False" MaxHeight="350"
                                          materialDesign:DataGridAssist.CellPadding="8">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="اسم الكاشير" Binding="{Binding CashierName}" Width="2*"/>
                                        <DataGridTextColumn Header="إجمالي المبيعات" Binding="{Binding TotalSales, StringFormat='{}{0:N2} ج.م'}" Width="*"/>
                                        <DataGridTextColumn Header="عدد الفواتير" Binding="{Binding TotalTransactions}" Width="*"/>
                                        <DataGridTextColumn Header="متوسط الفاتورة" Binding="{Binding AverageTicket, StringFormat='{}{0:N2} ج.م'}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </TabItem>

                        <!-- Debt Dashboard Tab -->
                        <TabItem Header="💳 لوحة الديون">
                            <StackPanel Margin="16">
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#FEF2F2" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="ديون العملاء" Foreground="#DC2626" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding TotalCustomerDebt, StringFormat='{}{0:N2} ج.م'}"
                                                       FontSize="20" FontWeight="Bold" Foreground="#DC2626"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="#FFF7ED" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="ديون الموردين" Foreground="#EA580C" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding TotalSupplierDebt, StringFormat='{}{0:N2} ج.م'}"
                                                       FontSize="20" FontWeight="Bold" Foreground="#EA580C"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="#F0FDF4" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="صافي المركز المالي" Foreground="#16A34A" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding NetDebtPosition, StringFormat='{}{0:N2} ج.م'}"
                                                       FontSize="20" FontWeight="Bold" Foreground="#16A34A"/>
                                        </StackPanel>
                                    </Border>
                                    <Button Grid.Column="3" Content="تحديث" Command="{Binding LoadDebtDashboardCommand}"
                                            Style="{StaticResource AlAtmani.SoftButton}" Padding="16,8" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="عملاء مديونون" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <DataGrid ItemsSource="{Binding CustomersWithDebt}" AutoGenerateColumns="False"
                                                  IsReadOnly="True" CanUserAddRows="False" MaxHeight="250">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="اسم العميل" Binding="{Binding Name}" Width="*"/>
                                                <DataGridTextColumn Header="الدين" Binding="{Binding CurrentDebt, StringFormat='{}{0:N2}'}" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="موردون مديونون" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <DataGrid ItemsSource="{Binding SuppliersWithDebt2}" AutoGenerateColumns="False"
                                                  IsReadOnly="True" CanUserAddRows="False" MaxHeight="250">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="اسم المورد" Binding="{Binding Name}" Width="*"/>
                                                <DataGridTextColumn Header="الدين" Binding="{Binding DebtAmount, StringFormat='{}{0:N2}'}" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </TabItem>

                        <!-- Expiry Tracking Tab -->
                        <TabItem Header="⏰ تتبع الصلاحية">
                            <StackPanel Margin="16">
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="تنبيه قبل:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding ExpiryAlertDays}" Width="60"
                                             materialDesign:HintAssist.Hint="أيام" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="2" Text="يوم" VerticalAlignment="Center"/>
                                    <Button Grid.Column="3" Content="بحث" Command="{Binding LoadExpiryTrackingCommand}"
                                            Style="{StaticResource AlAtmani.SoftButton}" Padding="16,8"/>
                                </Grid>
                                <DataGrid ItemsSource="{Binding ExpiringProducts}" AutoGenerateColumns="False"
                                          IsReadOnly="True" CanUserAddRows="False" MaxHeight="350"
                                          materialDesign:DataGridAssist.CellPadding="8">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="المنتج" Binding="{Binding Name}" Width="2*"/>
                                        <DataGridTextColumn Header="التصنيف" Binding="{Binding Category.Name}" Width="*"/>
                                        <DataGridTextColumn Header="المخزون" Binding="{Binding Stock}" Width="*"/>
                                        <DataGridTextColumn Header="تاريخ الانتهاء"
                                                            Binding="{Binding ExpiryDate, StringFormat='{}{0:dd/MM/yyyy}'}" Width="*"/>
                                        <DataGridTemplateColumn Header="الحالة" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock>
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="قريب الانتهاء"/>
                                                                <Setter Property="Foreground" Value="Orange"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsExpired}" Value="True">
                                                                        <Setter Property="Text" Value="منتهي الصلاحية"/>
                                                                        <Setter Property="Foreground" Value="Red"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </TabItem>

                        <!-- CSV Export Tab -->
                        <TabItem Header="📥 تصدير البيانات">
                            <StackPanel Margin="16" HorizontalAlignment="Center">
                                <TextBlock Text="تصدير بيانات النظام إلى CSV" FontSize="18" FontWeight="Bold"
                                           HorizontalAlignment="Center" Margin="0,0,0,24"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <materialDesign:Card Grid.Column="0" Padding="24" Margin="0,0,8,0"
                                                         Style="{StaticResource AlAtmani.GlassCard}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="FileDelimited" Width="48" Height="48"
                                                                     Foreground="#10B981" HorizontalAlignment="Center"
                                                                     Margin="0,0,0,12"/>
                                            <TextBlock Text="تصدير المبيعات" FontSize="16" FontWeight="Bold"
                                                       HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                            <TextBlock Text="تصدير سجل المبيعات حسب الفترة المحددة أعلاه"
                                                       TextWrapping="Wrap" HorizontalAlignment="Center"
                                                       Foreground="Gray" Margin="0,0,0,16"/>
                                            <Button Content="تصدير المبيعات CSV" Command="{Binding ExportSalesToCsvCommand}"
                                                    Style="{StaticResource AlAtmani.SoftButton}" Padding="24,10"/>
                                        </StackPanel>
                                    </materialDesign:Card>

                                    <materialDesign:Card Grid.Column="1" Padding="24"
                                                         Style="{StaticResource AlAtmani.GlassCard}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="ChartBar" Width="48" Height="48"
                                                                     Foreground="#3B82F6" HorizontalAlignment="Center"
                                                                     Margin="0,0,0,12"/>
                                            <TextBlock Text="تصدير الأرباح" FontSize="16" FontWeight="Bold"
                                                       HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                            <TextBlock Text="تصدير تقرير أرباح المنتجات (يجب تحميل التقرير أولاً)"
                                                       TextWrapping="Wrap" HorizontalAlignment="Center"
                                                       Foreground="Gray" Margin="0,0,0,16"/>
                                            <Button Content="تصدير الأرباح CSV" Command="{Binding ExportProfitToCsvCommand}"
                                                    Style="{StaticResource AlAtmani.SoftButton}" Padding="24,10"/>
                                        </StackPanel>
                                    </materialDesign:Card>
                                </Grid>
                            </StackPanel>
                        </TabItem>

                    </TabControl>
                </materialDesign:Card>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

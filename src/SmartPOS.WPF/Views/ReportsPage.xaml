<Page x:Class="SmartPOS.WPF.Views.ReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      Title="{DynamicResource Loc_4d4e102c}"
      FontFamily="Segoe UI, Tahoma"
      FlowDirection="RightToLeft"
      Loaded="Page_Loaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Background="{DynamicResource AlAtmani.BackgroundBrush}"
              Margin="24">
            <StackPanel>
                <!-- Header -->
                <materialDesign:Card Style="{StaticResource AlAtmani.GlassCard}"
                                     Margin="0,0,0,24"
                                     Padding="24">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#E1F5FE"
                                CornerRadius="12"
                                Padding="12"
                                Margin="0,0,16,0"
                                VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="ChartLine"
                                                     Width="32"
                                                     Height="32"
                                                     Foreground="#0288D1"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Loc_95bc86fe}"
                                       Style="{StaticResource AlAtmani.HeaderText}"/>
                            <TextBlock Text="{DynamicResource Loc_b825a2e8}"
                                       FontSize="14"
                                       Opacity="0.7"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Statistics Cards -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Today Sales -->
                    <materialDesign:Card Grid.Column="0"
                                         Style="{StaticResource AlAtmani.GlassCard}"
                                         Margin="0,0,8,0"
                                         Padding="20">
                        <StackPanel>
                            <Border Background="#E8F5E9"
                                    CornerRadius="12"
                                    Padding="10"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,12">
                                <materialDesign:PackIcon Kind="CashMultiple"
                                                         Width="32"
                                                         Height="32"
                                                         Foreground="#4CAF50"/>
                            </Border>
                            <TextBlock Text="{DynamicResource Loc_b7b53a04}"
                                       FontSize="14"
                                       Opacity="0.7"/>
                            <TextBlock x:Name="TodaySalesText"
                                       Text="{DynamicResource Loc_388b1526}"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Margin="0,4,0,0"/>
                            <TextBlock x:Name="TodayTransactionsText"
                                       Text="{DynamicResource Loc_477e0f95}"
                                       FontSize="12"
                                       Opacity="0.6"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Today Profit -->
                    <materialDesign:Card Grid.Column="1"
                                         Style="{StaticResource AlAtmani.GlassCard}"
                                         Margin="8,0,8,0"
                                         Padding="20">
                        <StackPanel>
                            <Border Background="#E8F5E9"
                                    CornerRadius="12"
                                    Padding="10"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,12">
                                <materialDesign:PackIcon Kind="TrendingUp"
                                                         Width="32"
                                                         Height="32"
                                                         Foreground="#4CAF50"/>
                            </Border>
                            <TextBlock Text="{DynamicResource Loc_cfd9cbd5}"
                                       FontSize="14"
                                       Opacity="0.7"/>
                            <TextBlock x:Name="TodayProfitText"
                                       Text="{DynamicResource Loc_388b1526}"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="#4CAF50"
                                       Margin="0,4,0,0"/>
                            <TextBlock Text="{DynamicResource Loc_9b69ab6b}"
                                       FontSize="12"
                                       Opacity="0.6"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Month Sales -->
                    <materialDesign:Card Grid.Column="2"
                                         Style="{StaticResource AlAtmani.GlassCard}"
                                         Margin="8,0,8,0"
                                         Padding="20">
                        <StackPanel>
                            <Border Background="#FFF3E0"
                                    CornerRadius="12"
                                    Padding="10"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,12">
                                <materialDesign:PackIcon Kind="CalendarMonth"
                                                         Width="32"
                                                         Height="32"
                                                         Foreground="#FF9800"/>
                            </Border>
                            <TextBlock Text="{DynamicResource Loc_87d558d4}"
                                       FontSize="14"
                                       Opacity="0.7"/>
                            <TextBlock x:Name="MonthSalesText"
                                       Text="{DynamicResource Loc_388b1526}"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="#FF9800"
                                       Margin="0,4,0,0"/>
                            <TextBlock Text="{DynamicResource Loc_9fbc5746}"
                                       FontSize="12"
                                       Opacity="0.6"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Expenses -->
                    <materialDesign:Card Grid.Column="3"
                                         Style="{StaticResource AlAtmani.GlassCard}"
                                         Margin="8,0,0,0"
                                         Padding="20">
                        <StackPanel>
                            <Border Background="#FFEBEE"
                                    CornerRadius="12"
                                    Padding="10"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,12">
                                <materialDesign:PackIcon Kind="CurrencyUsd"
                                                         Width="32"
                                                         Height="32"
                                                         Foreground="#F44336"/>
                            </Border>
                            <TextBlock Text="{DynamicResource Loc_26438b26}"
                                       FontSize="14"
                                       Opacity="0.7"/>
                            <TextBlock x:Name="TotalExpensesText"
                                       Text="{DynamicResource Loc_388b1526}"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="#F44336"
                                       Margin="0,4,0,0"/>
                            <TextBlock Text="{DynamicResource Loc_66084dfb}"
                                       FontSize="12"
                                       Opacity="0.6"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </materialDesign:Card>
                </Grid>

                <!-- Interactive Charts -->
                <materialDesign:Card Style="{StaticResource AlAtmani.GlassCard}"
                                     Padding="20"
                                     Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc_d241c745}"
                                   FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="16"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Bar Chart: Daily Sales -->
                            <materialDesign:Card Grid.Column="0" Grid.Row="0"
                                                 UniformCornerRadius="12"
                                                 Background="#0D1B2E"
                                                 Padding="16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <materialDesign:PackIcon Kind="ChartBar" Width="20" Height="20"
                                                                 Foreground="#06B6D4" Margin="0,0,8,0"
                                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Loc_5fdfd607}"
                                                   FontSize="15" FontWeight="SemiBold"
                                                   Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <lvc:CartesianChart Height="220"
                                                        Series="{Binding SalesChartSeries}"
                                                        XAxes="{Binding SalesChartXAxes}"
                                                        Background="Transparent"
                                                        FlowDirection="LeftToRight"
                                                        ZoomMode="X"/>
                                </StackPanel>
                            </materialDesign:Card>

                            <!-- Pie Chart: Category Split -->
                            <materialDesign:Card Grid.Column="2" Grid.Row="0"
                                                 UniformCornerRadius="12"
                                                 Background="#0D1B2E"
                                                 Padding="16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <materialDesign:PackIcon Kind="ChartDonut" Width="20" Height="20"
                                                                 Foreground="#F59E0B" Margin="0,0,8,0"
                                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Loc_90b4e7b7}"
                                                   FontSize="15" FontWeight="SemiBold"
                                                   Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Grid Height="220">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <lvc:PieChart Grid.Column="0"
                                                      Series="{Binding CategoryChartSeries}"
                                                      Background="Transparent"
                                                      InitialRotation="-90"
                                                      IsClockwise="True"
                                                      LegendPosition="Hidden"/>
                                        <ItemsControl Grid.Column="1" 
                                                      ItemsSource="{Binding CategoryLegend}" 
                                                      VerticalAlignment="Center" 
                                                      Margin="16,0,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                                        <Ellipse Width="12" Height="12" Fill="{Binding Color}" Margin="0,0,0,0"/>
                                                        <TextBlock Text="{Binding Name}" Foreground="#94A3B8" Margin="8,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Value, StringFormat={}{0:N2}}" Foreground="#E2E8F0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </StackPanel>
                            </materialDesign:Card>

                            <!-- Line Chart: Daily Profit -->
                            <materialDesign:Card Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="2"
                                                 UniformCornerRadius="12"
                                                 Background="#0D1B2E"
                                                 Padding="16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <materialDesign:PackIcon Kind="TrendingUp" Width="20" Height="20"
                                                                 Foreground="#10B981" Margin="0,0,8,0"
                                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Loc_31266bca}"
                                                   FontSize="15" FontWeight="SemiBold"
                                                   Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <lvc:CartesianChart Height="180"
                                                        Series="{Binding ProfitChartSeries}"
                                                        XAxes="{Binding SalesChartXAxes}"
                                                        Background="Transparent"
                                                        FlowDirection="LeftToRight"/>
                                </StackPanel>
                            </materialDesign:Card>
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Date Filter -->
                <materialDesign:Card Style="{StaticResource ModernCard}"
                                     Padding="20"
                                     Margin="0,0,0,16">
                    <DockPanel>
                        <TextBlock Text="{DynamicResource Loc_d5a41c96}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   DockPanel.Dock="Left"
                                   VerticalAlignment="Center"
                                   Margin="0,0,16,0"/>

                        <Button DockPanel.Dock="Right"
                                Content="{DynamicResource Loc_ab79fc14}"
                                Width="120"
                                Height="40"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Command="{Binding FilterReportsCommand}"/>

                        <StackPanel Orientation="Horizontal"
                                    DockPanel.Dock="Right"
                                    Margin="0,0,16,0">
                            <DatePicker x:Name="StartDatePicker"
                                        materialDesign:HintAssist.Hint="{DynamicResource Loc_h_13e7cfbc}"
                                        Width="150"
                                        SelectedDate="{Binding StartDate}"
                                        Margin="0,0,16,0"/>
                            <DatePicker x:Name="EndDatePicker"
                                        materialDesign:HintAssist.Hint="{DynamicResource Loc_h_a41631e1}"
                                        SelectedDate="{Binding EndDate}"
                                        Width="150"/>
                        </StackPanel>
                    </DockPanel>
                </materialDesign:Card>

                <!-- Printing Controls -->
                <materialDesign:Card Style="{StaticResource ModernCard}"
                                     Padding="20"
                                     Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource Loc_087a5ba4}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,24,0"/>
                        
                        <Button Width="180"
                                Height="40"
                                Margin="0,0,16,0"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="#673AB7"
                                BorderBrush="#673AB7"
                                Command="{Binding PrintPurchasesReportCommand}">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Printer" Width="20" Height="20" Margin="0,0,8,0"/>
                                    <TextBlock Text="{DynamicResource Loc_708a309a}"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>

                        <Button Width="180"
                                Height="40"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="#009688"
                                BorderBrush="#009688"
                                Command="{Binding PrintIncomeReportCommand}">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FilePdfBox" Width="20" Height="20" Margin="0,0,8,0"/>
                                    <TextBlock Text="{DynamicResource Loc_ce12f2a2}"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Inventory & Custom Period -->
                <materialDesign:Card Style="{StaticResource ModernCard}"
                                     Padding="20"
                                     Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Inventory Valuation -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Loc_238d24bc}"
                                       FontSize="14"
                                       Opacity="0.7"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="{Binding InventoryValuation, StringFormat={}{0:N2}}"
                                           FontSize="22" FontWeight="Bold" Foreground="#673AB7"/>
                                <TextBlock Text=" " />
                                <TextBlock Text="{DynamicResource Loc_CurrencySymbol}"
                                           FontSize="14" FontWeight="Bold" Foreground="#673AB7"
                                           VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Custom Period Sales -->
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{DynamicResource Loc_3938960c}"
                                       FontSize="14"
                                       Opacity="0.7"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="{Binding CustomPeriodSales, StringFormat={}{0:N2}}"
                                           FontSize="22" FontWeight="Bold" Foreground="#1976D2"/>
                                <TextBlock Text=" " />
                                <TextBlock Text="{DynamicResource Loc_CurrencySymbol}"
                                           FontSize="14" FontWeight="Bold" Foreground="#1976D2"
                                           VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Custom Period Profit -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource Loc_2a695a4d}"
                                       FontSize="14"
                                       Opacity="0.7"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="{Binding CustomPeriodProfit, StringFormat={}{0:N2}}"
                                           FontSize="22" FontWeight="Bold" Foreground="#388E3C"/>
                                <TextBlock Text=" " />
                                <TextBlock Text="{DynamicResource Loc_CurrencySymbol}"
                                           FontSize="14" FontWeight="Bold" Foreground="#388E3C"
                                           VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>

                <!-- Recent Sales -->
                <materialDesign:Card Padding="16"
                                     Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc_f06567f0}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,16"/>
                        <DataGrid x:Name="RecentSalesGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  MaxHeight="300"
                                  materialDesign:DataGridAssist.CellPadding="8">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource Loc_aad5385a}"
                                                    Binding="{Binding InvoiceNumber}"
                                                    Width="120"/>
                                <DataGridTextColumn Header="{DynamicResource Loc_8456f22b}"
                                                    Binding="{Binding SaleDate, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"
                                                    Width="150"/>
                                <DataGridTextColumn Header="{DynamicResource Loc_1567b6bf}"
                                                    Binding="{Binding User.FullName}"
                                                    Width="*"/>
                                <DataGridTextColumn Header="{DynamicResource Loc_88fc73eb}"
                                                    Binding="{Binding TotalAmount, StringFormat='{}{0:F2} ج.م'}"
                                                    Width="120"/>
                                <DataGridTextColumn Header="{DynamicResource Loc_8f31e70d}"
                                                    Binding="{Binding PaymentMethod}"
                                                    Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Top Products -->
                <materialDesign:Card Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc_e73a1111}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,16"/>
                        <DataGrid x:Name="TopProductsGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  MaxHeight="300"
                                  materialDesign:DataGridAssist.CellPadding="8">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource Loc_1ab39148}"
                                                    Binding="{Binding Name}"
                                                    Width="*"/>
                                <DataGridTextColumn Header="{DynamicResource Loc_cf143297}"
                                                    Binding="{Binding Category.Name}"
                                                    Width="150"/>
                                <DataGridTextColumn Header="{DynamicResource Loc_fa59c355}"
                                                    Binding="{Binding SellingPrice, StringFormat='{}{0:F2} ج.م'}"
                                                    Width="100"/>
                                <DataGridTextColumn Header="{DynamicResource Loc_c3771b94}"
                                                    Binding="{Binding Stock}"
                                                    Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Advanced Reports TabControl -->
                <materialDesign:Card Padding="16" Margin="0,0,0,16" Style="{StaticResource AlAtmani.GlassCard}">
                    <TabControl Style="{StaticResource MaterialDesignTabControl}">

                        <!-- Profit Report Tab -->
                        <TabItem Header="{DynamicResource Loc_c110ca76}">
                            <StackPanel Margin="16">
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <DatePicker Grid.Column="0" materialDesign:HintAssist.Hint="{DynamicResource Loc_h_13e7cfbc}"
                                                SelectedDate="{Binding ProfitStartDate}" Width="140" Margin="0,0,8,0"/>
                                    <DatePicker Grid.Column="1" materialDesign:HintAssist.Hint="{DynamicResource Loc_h_a41631e1}"
                                                SelectedDate="{Binding ProfitEndDate}" Width="140" Margin="0,0,8,0"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Loc_TotalProfitPrefix}"
                                                   FontSize="18" FontWeight="Bold" Foreground="#2E7D32"/>
                                        <TextBlock Text="{Binding TotalGrossProfit, StringFormat='{}{0:N2}'}"
                                                   FontSize="18" FontWeight="Bold" Foreground="#2E7D32"/>
                                        <TextBlock Text=" " />
                                        <TextBlock Text="{DynamicResource Loc_CurrencySymbol}"
                                                   FontSize="14" FontWeight="Bold" Foreground="#2E7D32"
                                                   VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                                    </StackPanel>
                                    <Button Grid.Column="3" Content="{DynamicResource Loc_969879d2}" Command="{Binding LoadProfitReportCommand}"
                                            Style="{StaticResource AlAtmani.SoftButton}" Margin="0,0,8,0" Padding="16,8"/>
                                    <Button Grid.Column="4" Content="{DynamicResource Loc_91cafef9}" Command="{Binding ExportProfitToCsvCommand}"
                                            Style="{StaticResource AlAtmani.SoftButton}" Padding="16,8"/>
                                </Grid>
                                <DataGrid ItemsSource="{Binding ProfitItems}" AutoGenerateColumns="False"
                                          IsReadOnly="True" CanUserAddRows="False" MaxHeight="350"
                                          materialDesign:DataGridAssist.CellPadding="8">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{DynamicResource Loc_726cc064}" Binding="{Binding ProductName}" Width="2*"/>
                                        <DataGridTextColumn Header="{DynamicResource Loc_17831d5f}" Binding="{Binding TotalQuantity}" Width="*"/>
                                        <DataGridTextColumn Header="{DynamicResource Loc_2ce9c33b}" Binding="{Binding TotalRevenue, StringFormat='{}{0:N2}'}" Width="*"/>
                                        <DataGridTextColumn Header="{DynamicResource Loc_c6ed35ce}" Binding="{Binding TotalCost, StringFormat='{}{0:N2}'}" Width="*"/>
                                        <DataGridTextColumn Header="{DynamicResource Loc_54dfbc1b}" Binding="{Binding GrossProfit, StringFormat='{}{0:N2}'}" Width="*"/>
                                        <DataGridTextColumn Header="{DynamicResource Loc_3c7bb9a9}" Binding="{Binding MarginPct, StringFormat='{}{0:F1}%'}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </TabItem>

                        <!-- Cashier Stats Tab -->
                        <TabItem Header="{DynamicResource Loc_4ff403fb}">
                            <StackPanel Margin="16">
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <DatePicker Grid.Column="0" materialDesign:HintAssist.Hint="{DynamicResource Loc_h_13e7cfbc}"
                                                SelectedDate="{Binding CashierStatsStart}" Width="140" Margin="0,0,8,0"/>
                                    <DatePicker Grid.Column="1" materialDesign:HintAssist.Hint="{DynamicResource Loc_h_a41631e1}"
                                                SelectedDate="{Binding CashierStatsEnd}" Width="140" Margin="0,0,8,0"/>
                                    <Button Grid.Column="3" Content="{DynamicResource Loc_a6e1f15e}" Command="{Binding LoadCashierStatsCommand}"
                                            Style="{StaticResource AlAtmani.SoftButton}" Padding="16,8"/>
                                </Grid>
                                <DataGrid ItemsSource="{Binding CashierStats}" AutoGenerateColumns="False"
                                          IsReadOnly="True" CanUserAddRows="False" MaxHeight="350"
                                          materialDesign:DataGridAssist.CellPadding="8">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{DynamicResource Loc_548093b3}" Binding="{Binding CashierName}" Width="2*"/>
                                        <DataGridTextColumn Header="{DynamicResource Loc_b94c9b2f}" Binding="{Binding TotalSales, StringFormat='{}{0:N2}'}" Width="*"/>
                                        <DataGridTextColumn Header="{DynamicResource Loc_05096add}" Binding="{Binding TotalTransactions}" Width="*"/>
                                        <DataGridTextColumn Header="{DynamicResource Loc_d1e550ce}" Binding="{Binding AverageTicket, StringFormat='{}{0:N2}'}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </TabItem>

                        <!-- Debt Dashboard Tab -->
                        <TabItem Header="{DynamicResource Loc_51c4f7dd}">
                            <StackPanel Margin="16">
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#FEF2F2" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Loc_3be404ab}" Foreground="#DC2626" FontWeight="Bold"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding TotalCustomerDebt, StringFormat='{}{0:N2}'}"
                                                           FontSize="20" FontWeight="Bold" Foreground="#DC2626"/>
                                                <TextBlock Text=" " />
                                                <TextBlock Text="{DynamicResource Loc_CurrencySymbol}"
                                                           FontSize="13" FontWeight="Bold" Foreground="#DC2626"
                                                           VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="#FFF7ED" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Loc_74c2154c}" Foreground="#EA580C" FontWeight="Bold"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding TotalSupplierDebt, StringFormat='{}{0:N2}'}"
                                                           FontSize="20" FontWeight="Bold" Foreground="#EA580C"/>
                                                <TextBlock Text=" " />
                                                <TextBlock Text="{DynamicResource Loc_CurrencySymbol}"
                                                           FontSize="13" FontWeight="Bold" Foreground="#EA580C"
                                                           VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="#F0FDF4" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Loc_576153fc}" Foreground="#16A34A" FontWeight="Bold"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding NetDebtPosition, StringFormat='{}{0:N2}'}"
                                                           FontSize="20" FontWeight="Bold" Foreground="#16A34A"/>
                                                <TextBlock Text=" " />
                                                <TextBlock Text="{DynamicResource Loc_CurrencySymbol}"
                                                           FontSize="13" FontWeight="Bold" Foreground="#16A34A"
                                                           VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Button Grid.Column="3" Content="{DynamicResource Loc_061401dc}" Command="{Binding LoadDebtDashboardCommand}"
                                            Style="{StaticResource AlAtmani.SoftButton}" Padding="16,8" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="{DynamicResource Loc_4fd16c01}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <DataGrid ItemsSource="{Binding CustomersWithDebt}" AutoGenerateColumns="False"
                                                  IsReadOnly="True" CanUserAddRows="False" MaxHeight="250">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="{DynamicResource Loc_2b9848ef}" Binding="{Binding Name}" Width="*"/>
                                                <DataGridTextColumn Header="{DynamicResource Loc_fd8eabe1}" Binding="{Binding CurrentDebt, StringFormat='{}{0:N2}'}" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{DynamicResource Loc_72e19c25}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <DataGrid ItemsSource="{Binding SuppliersWithDebt2}" AutoGenerateColumns="False"
                                                  IsReadOnly="True" CanUserAddRows="False" MaxHeight="250">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="{DynamicResource Loc_daa5ae96}" Binding="{Binding Name}" Width="*"/>
                                                <DataGridTextColumn Header="{DynamicResource Loc_fd8eabe1}" Binding="{Binding DebtAmount, StringFormat='{}{0:N2}'}" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </TabItem>

                        <!-- Expiry Tracking Tab -->
                        <TabItem Header="{DynamicResource Loc_0d894fb9}">
                            <StackPanel Margin="16">
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{DynamicResource Loc_308840b6}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding ExpiryAlertDays}" Width="60"
                                             materialDesign:HintAssist.Hint="{DynamicResource Loc_h_3f6bf715}" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="2" Text="{DynamicResource Loc_10954620}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="3" Content="{DynamicResource Loc_ab79fc14}" Command="{Binding LoadExpiryTrackingCommand}"
                                            Style="{StaticResource AlAtmani.SoftButton}" Padding="16,8"/>
                                </Grid>
                                <DataGrid ItemsSource="{Binding ExpiringProducts}" AutoGenerateColumns="False"
                                          IsReadOnly="True" CanUserAddRows="False" MaxHeight="350"
                                          materialDesign:DataGridAssist.CellPadding="8">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{DynamicResource Loc_726cc064}" Binding="{Binding Name}" Width="2*"/>
                                        <DataGridTextColumn Header="{DynamicResource Loc_cf143297}" Binding="{Binding Category.Name}" Width="*"/>
                                        <DataGridTextColumn Header="{DynamicResource Loc_a089edeb}" Binding="{Binding Stock}" Width="*"/>
                                        <DataGridTextColumn Header="{DynamicResource Loc_845e41c4}"
                                                            Binding="{Binding ExpiryDate, StringFormat='{}{0:dd/MM/yyyy}'}" Width="*"/>
                                        <DataGridTemplateColumn Header="{DynamicResource Loc_1253eb56}" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock>
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="قريب الانتهاء"/>
                                                                <Setter Property="Foreground" Value="Orange"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsExpired}" Value="True">
                                                                        <Setter Property="Text" Value="منتهي الصلاحية"/>
                                                                        <Setter Property="Foreground" Value="Red"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </TabItem>

                        <!-- CSV Export Tab -->
                        <TabItem Header="{DynamicResource Loc_b5c720c6}">
                            <StackPanel Margin="16" HorizontalAlignment="Center">
                                <TextBlock Text="{DynamicResource Loc_ebb88f46}" FontSize="18" FontWeight="Bold"
                                           HorizontalAlignment="Center" Margin="0,0,0,24"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <materialDesign:Card Grid.Column="0" Padding="24" Margin="0,0,8,0"
                                                         Style="{StaticResource AlAtmani.GlassCard}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="FileDelimited" Width="48" Height="48"
                                                                     Foreground="#10B981" HorizontalAlignment="Center"
                                                                     Margin="0,0,0,12"/>
                                            <TextBlock Text="{DynamicResource Loc_11cb8fe2}" FontSize="16" FontWeight="Bold"
                                                       HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                            <TextBlock Text="{DynamicResource Loc_a938b38b}"
                                                       TextWrapping="Wrap" HorizontalAlignment="Center"
                                                       Foreground="Gray" Margin="0,0,0,16"/>
                                            <Button Content="{DynamicResource Loc_2e4f6a07}" Command="{Binding ExportSalesToCsvCommand}"
                                                    Style="{StaticResource AlAtmani.SoftButton}" Padding="24,10"/>
                                        </StackPanel>
                                    </materialDesign:Card>

                                    <materialDesign:Card Grid.Column="1" Padding="24"
                                                         Style="{StaticResource AlAtmani.GlassCard}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="ChartBar" Width="48" Height="48"
                                                                     Foreground="#3B82F6" HorizontalAlignment="Center"
                                                                     Margin="0,0,0,12"/>
                                            <TextBlock Text="{DynamicResource Loc_3a542da0}" FontSize="16" FontWeight="Bold"
                                                       HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                            <TextBlock Text="{DynamicResource Loc_e0f2ae57}"
                                                       TextWrapping="Wrap" HorizontalAlignment="Center"
                                                       Foreground="Gray" Margin="0,0,0,16"/>
                                            <Button Content="{DynamicResource Loc_e010bece}" Command="{Binding ExportProfitToCsvCommand}"
                                                    Style="{StaticResource AlAtmani.SoftButton}" Padding="24,10"/>
                                        </StackPanel>
                                    </materialDesign:Card>
                                </Grid>
                            </StackPanel>
                        </TabItem>

                    </TabControl>
                </materialDesign:Card>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

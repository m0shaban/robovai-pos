<Window x:Class="SmartPOS.WPF.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:SmartPOS.WPF.Converters"
        Title="RoboVAI PRO POS"
        Width="1200"
        Height="740"
        MinWidth="1200"
        MinHeight="740"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI, Tahoma"
        FlowDirection="RightToLeft"
        Loaded="LoginWindow_Loaded"
        Closed="LoginWindow_Closed"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

        <Window.Resources>

                <!-- ── Converters ────────────────────────────────── -->
                <converters:BoolNegationConverter x:Key="BoolNegationConverter"/>
                <BooleanToVisibilityConverter    x:Key="BooleanToVisibilityConverter"/>

                <!-- ── Space Palette ─────────────────────────────── -->
                <SolidColorBrush x:Key="SpaceText"
                                 Color="#EBF4FF"/>
                <SolidColorBrush x:Key="SpaceMuted"
                                 Color="#4A6680"/>
                <SolidColorBrush x:Key="SpaceAccent"
                                 Color="#00D4FF"/>
                <SolidColorBrush x:Key="SpaceError"
                                 Color="#FF6B6B"/>

                <!-- kept for any implicit references from App.xaml -->
                <SolidColorBrush x:Key="LoginAccentBrush"
                                 Color="#00D4FF"/>
                <SolidColorBrush x:Key="LoginTextBrush"
                                 Color="#EBF4FF"/>
                <SolidColorBrush x:Key="LoginMutedBrush"
                                 Color="#4A6680"/>
                <SolidColorBrush x:Key="LoginErrorBrush"
                                 Color="#FF6B6B"/>
                <SolidColorBrush x:Key="LoginBackgroundBrush"
                                 Color="#030911"/>
                <SolidColorBrush x:Key="LoginPanelBrush"
                                 Color="#050F1C"/>
                <SolidColorBrush x:Key="LoginCardBrush"
                                 Color="#0A1929"/>
                <SolidColorBrush x:Key="LoginBorderBrush"
                                 Color="#1E3248"/>
                <SolidColorBrush x:Key="LoginAccentSoftBrush"
                                 Color="#0A2238"/>
                <LinearGradientBrush x:Key="LoginHeroOverlay"
                                     StartPoint="0,0"
                                     EndPoint="1,1">
                        <GradientStop Color="#F0030911"
                                      Offset="0"/>
                        <GradientStop Color="#AA050D1A"
                                      Offset="0.6"/>
                        <GradientStop Color="#33050D1A"
                                      Offset="1"/>
                </LinearGradientBrush>

                <!-- ── Field Label ────────────────────────────────── -->
                <Style x:Key="LoginFieldLabelStyle"
                       TargetType="TextBlock">
                        <Setter Property="Foreground"
                                Value="#607898"/>
                        <Setter Property="FontSize"
                                Value="12"/>
                        <Setter Property="FontWeight"
                                Value="SemiBold"/>
                        <Setter Property="Margin"
                                Value="2,0,0,7"/>
                </Style>

                <!-- ── TextBox ────────────────────────────────────── -->
                <Style x:Key="LoginTextBoxStyle"
                       TargetType="TextBox">
                        <Setter Property="FontSize"
                                Value="15"/>
                        <Setter Property="Foreground"
                                Value="#EBF4FF"/>
                        <Setter Property="Background"
                                Value="#0F1F30"/>
                        <Setter Property="BorderBrush"
                                Value="#1E3248"/>
                        <Setter Property="BorderThickness"
                                Value="1.5"/>
                        <Setter Property="Padding"
                                Value="14,0"/>
                        <Setter Property="Height"
                                Value="50"/>
                        <Setter Property="CaretBrush"
                                Value="#00D4FF"/>
                        <Setter Property="SelectionBrush"
                                Value="#4000D4FF"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                                <Border x:Name="border"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="12">
                                                        <ScrollViewer x:Name="PART_ContentHost"
                                                                      Focusable="False"
                                                                      HorizontalScrollBarVisibility="Hidden"
                                                                      VerticalScrollBarVisibility="Hidden"
                                                                      VerticalAlignment="Center"
                                                                      Margin="{TemplateBinding Padding}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver"
                                                                 Value="True">
                                                                <Setter TargetName="border"
                                                                        Property="BorderBrush"
                                                                        Value="#2A4A6A"/>
                                                        </Trigger>
                                                        <Trigger Property="IsFocused"
                                                                 Value="True">
                                                                <Setter TargetName="border"
                                                                        Property="BorderBrush"
                                                                        Value="#00D4FF"/>
                                                                <Setter TargetName="border"
                                                                        Property="Background"
                                                                        Value="#142438"/>
                                                                <Setter TargetName="border"
                                                                        Property="Effect">
                                                                        <Setter.Value>
                                                                                <DropShadowEffect Color="#00D4FF"
                                                                                                  BlurRadius="14"
                                                                                                  ShadowDepth="0"
                                                                                                  Opacity="0.30"/>
                                                                        </Setter.Value>
                                                                </Setter>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>

                <!-- ── PasswordBox ────────────────────────────────── -->
                <Style x:Key="LoginPasswordBoxStyle"
                       TargetType="PasswordBox">
                        <Setter Property="FontSize"
                                Value="15"/>
                        <Setter Property="Foreground"
                                Value="#EBF4FF"/>
                        <Setter Property="Background"
                                Value="#0F1F30"/>
                        <Setter Property="BorderBrush"
                                Value="#1E3248"/>
                        <Setter Property="BorderThickness"
                                Value="1.5"/>
                        <Setter Property="Padding"
                                Value="14,0"/>
                        <Setter Property="Height"
                                Value="50"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="PasswordBox">
                                                <Border x:Name="border"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="12">
                                                        <ScrollViewer x:Name="PART_ContentHost"
                                                                      Focusable="False"
                                                                      VerticalAlignment="Center"
                                                                      Margin="{TemplateBinding Padding}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver"
                                                                 Value="True">
                                                                <Setter TargetName="border"
                                                                        Property="BorderBrush"
                                                                        Value="#2A4A6A"/>
                                                        </Trigger>
                                                        <Trigger Property="IsKeyboardFocusWithin"
                                                                 Value="True">
                                                                <Setter TargetName="border"
                                                                        Property="BorderBrush"
                                                                        Value="#00D4FF"/>
                                                                <Setter TargetName="border"
                                                                        Property="Background"
                                                                        Value="#142438"/>
                                                                <Setter TargetName="border"
                                                                        Property="Effect">
                                                                        <Setter.Value>
                                                                                <DropShadowEffect Color="#00D4FF"
                                                                                                  BlurRadius="14"
                                                                                                  ShadowDepth="0"
                                                                                                  Opacity="0.30"/>
                                                                        </Setter.Value>
                                                                </Setter>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>

                <!-- ── Primary Login Button ───────────────────────── -->
                <Style x:Key="PrimaryLoginButtonStyle"
                       TargetType="Button">
                        <Setter Property="Height"
                                Value="52"/>
                        <Setter Property="FontSize"
                                Value="16"/>
                        <Setter Property="FontWeight"
                                Value="Bold"/>
                        <Setter Property="Foreground"
                                Value="White"/>
                        <Setter Property="Cursor"
                                Value="Hand"/>
                        <Setter Property="Effect">
                                <Setter.Value>
                                        <DropShadowEffect Color="#00C6FF"
                                                          BlurRadius="22"
                                                          ShadowDepth="0"
                                                          Opacity="0.55"/>
                                </Setter.Value>
                        </Setter>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                                <Border x:Name="border"
                                                        CornerRadius="14">
                                                        <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0"
                                                                                     EndPoint="1,0">
                                                                        <GradientStop Color="#0090CC"
                                                                                      Offset="0"/>
                                                                        <GradientStop Color="#00C6FF"
                                                                                      Offset="0.45"/>
                                                                        <GradientStop Color="#6D28D9"
                                                                                      Offset="1"/>
                                                                </LinearGradientBrush>
                                                        </Border.Background>
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver"
                                                                 Value="True">
                                                                <Setter TargetName="border"
                                                                        Property="Opacity"
                                                                        Value="0.88"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed"
                                                                 Value="True">
                                                                <Setter TargetName="border"
                                                                        Property="Opacity"
                                                                        Value="0.70"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled"
                                                                 Value="False">
                                                                <Setter Property="Opacity"
                                                                        Value="0.40"/>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>

                <!-- ── Secondary / Exit Button ────────────────────── -->
                <Style x:Key="SecondaryLoginButtonStyle"
                       TargetType="Button">
                        <Setter Property="Height"
                                Value="44"/>
                        <Setter Property="FontSize"
                                Value="13"/>
                        <Setter Property="FontWeight"
                                Value="SemiBold"/>
                        <Setter Property="Foreground"
                                Value="#3D586E"/>
                        <Setter Property="Background"
                                Value="Transparent"/>
                        <Setter Property="BorderBrush"
                                Value="#162438"/>
                        <Setter Property="BorderThickness"
                                Value="1"/>
                        <Setter Property="Cursor"
                                Value="Hand"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                                <Border x:Name="border"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="12"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver"
                                                                 Value="True">
                                                                <Setter Property="Foreground"
                                                                        Value="#6A90B4"/>
                                                                <Setter TargetName="border"
                                                                        Property="BorderBrush"
                                                                        Value="#2A4060"/>
                                                                <Setter TargetName="border"
                                                                        Property="Background"
                                                                        Value="#0A1522"/>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>

                <!-- ── Window Close Button ────────────────────────── -->
                <Style x:Key="WinCloseButtonStyle"
                       TargetType="Button">
                        <Setter Property="Width"
                                Value="34"/>
                        <Setter Property="Height"
                                Value="34"/>
                        <Setter Property="FontSize"
                                Value="13"/>
                        <Setter Property="Foreground"
                                Value="#3A5068"/>
                        <Setter Property="Background"
                                Value="Transparent"/>
                        <Setter Property="BorderBrush"
                                Value="Transparent"/>
                        <Setter Property="Cursor"
                                Value="Hand"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                                <Border x:Name="bg"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="8">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver"
                                                                 Value="True">
                                                                <Setter TargetName="bg"
                                                                        Property="Background"
                                                                        Value="#55FF3333"/>
                                                                <Setter Property="Foreground"
                                                                        Value="#FF6B6B"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed"
                                                                 Value="True">
                                                                <Setter TargetName="bg"
                                                                        Property="Background"
                                                                        Value="#88CC1111"/>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>

        </Window.Resources>

        <!-- ╔══════════════════════════════════════════════════════╗ -->
        <!-- ║  Outer wrapper — transparent window with shadow     ║ -->
        <!-- ╚══════════════════════════════════════════════════════╝ -->
        <Grid>
                <!-- Shadow layer (behind content, no ClipToBounds) -->
                <Border Margin="16"
                        CornerRadius="18"
                        Background="#020810">
                        <Border.Effect>
                                <DropShadowEffect Color="#000000"
                                                  BlurRadius="45"
                                                  ShadowDepth="2"
                                                  Opacity="0.95"/>
                        </Border.Effect>
                </Border>

                <!-- Content layer (rounded + clipped) -->
                <Border Margin="16"
                        CornerRadius="18"
                        ClipToBounds="True">
                        <Grid>
                                <!-- ── Background: Space image ── -->
                                <Image Source="pack://application:,,,/Assets/Images/wizard_large.jpeg"
                                       Stretch="UniformToFill"/>

                                <!-- ── Dark cosmic overlay ── -->
                                <Rectangle>
                                        <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0"
                                                                     EndPoint="0,1">
                                                        <GradientStop Color="#EC090F16"
                                                                      Offset="0"/>
                                                        <GradientStop Color="#DF0B131C"
                                                                      Offset="0.45"/>
                                                        <GradientStop Color="#F8071018"
                                                                      Offset="1"/>
                                                </LinearGradientBrush>
                                        </Rectangle.Fill>
                                </Rectangle>

                                <!-- ── Main 3-row layout ── -->
                                <Grid>
                                        <Grid.RowDefinitions>
                                                <RowDefinition Height="50"/>
                                                <!-- Top bar: drag + close -->
                                                <RowDefinition Height="*"/>
                                                <!-- Main content          -->
                                                <RowDefinition Height="40"/>
                                                <!-- Footer                -->
                                        </Grid.RowDefinitions>

                                        <!-- ════════════════════════════════════ -->
                                        <!--  ROW 0 — Custom Title Bar           -->
                                        <!-- ════════════════════════════════════ -->
                                        <Grid Grid.Row="0"
                                              FlowDirection="LeftToRight">
                                                <TextBlock Text="RoboVAI PRO POS"
                                                           Foreground="#1C3A55"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                                <Button Style="{StaticResource WinCloseButtonStyle}"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,14,0"
                                                        Content="✕"
                                                        Click="CloseButton_Click"/>
                                        </Grid>

                                        <!-- ════════════════════════════════════ -->
                                        <!--  ROW 1 — Main Content               -->
                                        <!-- ════════════════════════════════════ -->
                                        <Grid Grid.Row="1">
                                                <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.3*"/>
                                                        <ColumnDefinition Width="1"/>
                                                        <!-- thin divider -->
                                                        <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- ─────────────────────────────── -->
                                                <!--  LEFT — Hero / Marketing Panel  -->
                                                <!-- ─────────────────────────────── -->
                                                <Grid Grid.Column="0"
                                                      Margin="50,14,30,24">
                                                        <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="*"/>
                                                                <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- Status badge -->
                                                        <StackPanel Orientation="Horizontal"
                                                                    HorizontalAlignment="Left">
                                                                <Border Background="#1200D4FF"
                                                                        BorderBrush="#2800D4FF"
                                                                        BorderThickness="1"
                                                                        CornerRadius="999"
                                                                        Padding="13,5">
                                                                        <StackPanel Orientation="Horizontal">
                                                                                <Ellipse Width="6"
                                                                                         Height="6"
                                                                                         Fill="#00D4FF"
                                                                                         Margin="0,0,8,0"
                                                                                         VerticalAlignment="Center">
                                                                                        <Ellipse.Effect>
                                                                                                <DropShadowEffect Color="#00D4FF"
                                                                                                                  BlurRadius="8"
                                                                                                                  ShadowDepth="0"
                                                                                                                  Opacity="1"/>
                                                                                        </Ellipse.Effect>
                                                                                </Ellipse>
                                                                                <TextBlock Text="Enterprise Local Intelligence"
                                                                                           Foreground="#55B8D8"
                                                                                           FontSize="11"
                                                                                           FontWeight="SemiBold"/>
                                                                        </StackPanel>
                                                                </Border>
                                                        </StackPanel>

                                                        <!-- middle stretch -->
                                                        <Grid Grid.Row="1"/>

                                                        <!-- Bottom: branding + features -->
                                                        <StackPanel Grid.Row="2">
                                                                <!-- Logo + company name -->
                                                                <StackPanel Orientation="Horizontal"
                                                                            Margin="0,0,0,16">
                                                                        <Image Source="pack://application:,,,/Assets/logo.png"
                                                                               Width="68"
                                                                               Height="68"
                                                                               Stretch="Uniform"
                                                                               VerticalAlignment="Bottom"
                                                                               Margin="0,0,16,4">
                                                                                <Image.Effect>
                                                                                        <DropShadowEffect Color="#00D4FF"
                                                                                                          BlurRadius="22"
                                                                                                          ShadowDepth="0"
                                                                                                          Opacity="0.65"/>
                                                                                </Image.Effect>
                                                                        </Image>
                                                                        <StackPanel VerticalAlignment="Bottom">
                                                                                <TextBlock Text="RoboVAI"
                                                                                           Foreground="#00D4FF"
                                                                                           FontSize="12"
                                                                                           FontWeight="Bold"
                                                                                           Margin="0,0,0,3"/>
                                                                                <TextBlock Foreground="White"
                                                                                           FontSize="36"
                                                                                           FontWeight="Black"
                                                                                           LineHeight="40">
                                            <Run Text="نقاط البيع"/>
                                                                                </TextBlock>
                                                                                <TextBlock FontSize="36"
                                                                                           FontWeight="Black"
                                                                                           LineHeight="42">
                                            <Run Text="الذكية المتقدمة"
                                                                                        Foreground="#00D4FF"/>
                                                                                        <TextBlock.Effect>
                                                                                                <DropShadowEffect Color="#00D4FF"
                                                                                                                  BlurRadius="18"
                                                                                                                  ShadowDepth="0"
                                                                                                                  Opacity="0.65"/>
                                                                                        </TextBlock.Effect>
                                                                                </TextBlock>
                                                                        </StackPanel>
                                                                </StackPanel>

                                                                <!-- Gradient accent line -->
                                                                <Rectangle Height="2"
                                                                           Width="260"
                                                                           HorizontalAlignment="Left"
                                                                           Margin="0,0,0,18"
                                                                           RadiusX="1"
                                                                           RadiusY="1">
                                                                        <Rectangle.Fill>
                                                                                <LinearGradientBrush StartPoint="0,0"
                                                                                                     EndPoint="1,0">
                                                                                        <GradientStop Color="#00D4FF"
                                                                                                      Offset="0"/>
                                                                                        <GradientStop Color="#6D28D9"
                                                                                                      Offset="0.65"/>
                                                                                        <GradientStop Color="#00000000"
                                                                                                      Offset="1"/>
                                                                                </LinearGradientBrush>
                                                                        </Rectangle.Fill>
                                                                </Rectangle>

                                                                <!-- Arabic marketing tagline -->
                                                                <TextBlock Text="منصة إدارة متجرك بثقة واحترافية — بدون إنترنت، بدون خوادم خارجية، بياناتك آمنة تحت سيطرتك الكاملة."
                                                                           Foreground="#6B8CA8"
                                                                           FontSize="15"
                                                                           LineHeight="26"
                                                                           TextWrapping="Wrap"
                                                                           MaxWidth="460"
                                                                           Margin="0,0,0,28"/>

                                                                <!-- Feature cards (3-column grid) -->
                                                                <UniformGrid Columns="3"
                                                                             HorizontalAlignment="Left">

                                                                        <!-- Feature 1: Speed -->
                                                                        <Border Margin="0,0,10,0"
                                                                                Padding="16,15"
                                                                                CornerRadius="14"
                                                                                Background="#180D1D35"
                                                                                BorderBrush="#1800D4FF"
                                                                                BorderThickness="1">
                                                                                <Border.Effect>
                                                                                        <DropShadowEffect Color="#00D4FF"
                                                                                                          BlurRadius="14"
                                                                                                          ShadowDepth="0"
                                                                                                          Opacity="0.08"/>
                                                                                </Border.Effect>
                                                                                <StackPanel>
                                                                                        <TextBlock Text="⚡"
                                                                                                   FontSize="20"
                                                                                                   Foreground="#00D4FF"
                                                                                                   Margin="0,0,0,10"/>
                                                                                        <TextBlock Text="سرعة فائقة"
                                                                                                   Foreground="#C8D8E8"
                                                                                                   FontWeight="Bold"
                                                                                                   FontSize="13"/>
                                                                                        <TextBlock Text="استجابة فورية لكل عملية"
                                                                                                   Foreground="#2E4A5E"
                                                                                                   FontSize="11"
                                                                                                   TextWrapping="Wrap"
                                                                                                   Margin="0,6,0,0"/>
                                                                                </StackPanel>
                                                                        </Border>

                                                                        <!-- Feature 2: Security -->
                                                                        <Border Margin="0,0,10,0"
                                                                                Padding="16,15"
                                                                                CornerRadius="14"
                                                                                Background="#180D1D35"
                                                                                BorderBrush="#188B5CF6"
                                                                                BorderThickness="1">
                                                                                <Border.Effect>
                                                                                        <DropShadowEffect Color="#7C3AED"
                                                                                                          BlurRadius="14"
                                                                                                          ShadowDepth="0"
                                                                                                          Opacity="0.08"/>
                                                                                </Border.Effect>
                                                                                <StackPanel>
                                                                                        <TextBlock Text="🔒"
                                                                                                   FontSize="20"
                                                                                                   Foreground="#A78BFA"
                                                                                                   Margin="0,0,0,10"/>
                                                                                        <TextBlock Text="حماية كاملة"
                                                                                                   Foreground="#C8D8E8"
                                                                                                   FontWeight="Bold"
                                                                                                   FontSize="13"/>
                                                                                        <TextBlock Text="بيانات مشفرة محلياً 100%"
                                                                                                   Foreground="#2E4A5E"
                                                                                                   FontSize="11"
                                                                                                   TextWrapping="Wrap"
                                                                                                   Margin="0,6,0,0"/>
                                                                                </StackPanel>
                                                                        </Border>

                                                                        <!-- Feature 3: Analytics -->
                                                                        <Border Padding="16,15"
                                                                                CornerRadius="14"
                                                                                Background="#180D1D35"
                                                                                BorderBrush="#18F59E0B"
                                                                                BorderThickness="1">
                                                                                <Border.Effect>
                                                                                        <DropShadowEffect Color="#F59E0B"
                                                                                                          BlurRadius="14"
                                                                                                          ShadowDepth="0"
                                                                                                          Opacity="0.08"/>
                                                                                </Border.Effect>
                                                                                <StackPanel>
                                                                                        <TextBlock Text="📊"
                                                                                                   FontSize="20"
                                                                                                   Foreground="#F59E0B"
                                                                                                   Margin="0,0,0,10"/>
                                                                                        <TextBlock Text="تقارير ذكية"
                                                                                                   Foreground="#C8D8E8"
                                                                                                   FontWeight="Bold"
                                                                                                   FontSize="13"/>
                                                                                        <TextBlock Text="تحليلات فورية وتفصيلية"
                                                                                                   Foreground="#2E4A5E"
                                                                                                   FontSize="11"
                                                                                                   TextWrapping="Wrap"
                                                                                                   Margin="0,6,0,0"/>
                                                                                </StackPanel>
                                                                        </Border>

                                                                </UniformGrid>

                                                                <!-- Trust badge / Random Tip Box -->
                                                                <Border Margin="0,20,0,0"
                                                                        Padding="15"
                                                                        CornerRadius="12"
                                                                        Background="#25051224"
                                                                        BorderBrush="#4000D4FF"
                                                                        BorderThickness="1"
                                                                        HorizontalAlignment="Left">
                                                                        <Border.Effect>
                                                                                <DropShadowEffect Color="#00D4FF"
                                                                                                  BlurRadius="10"
                                                                                                  ShadowDepth="0"
                                                                                                  Opacity="0.3"/>
                                                                        </Border.Effect>
                                                                        <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                </Grid.ColumnDefinitions>

                                                                                <TextBlock Grid.Column="0"
                                                                                           Text="💡"
                                                                                           FontSize="22"
                                                                                           VerticalAlignment="Top"
                                                                                           Margin="0,0,10,0">
                                                                                        <TextBlock.Effect>
                                                                                                <DropShadowEffect Color="#00D4FF"
                                                                                                                BlurRadius="12"
                                                                                                                ShadowDepth="0"
                                                                                                                Opacity="0.8"/>
                                                                                        </TextBlock.Effect>
                                                                                </TextBlock>

                                                                                <StackPanel Grid.Column="1"
                                                                                            VerticalAlignment="Center">
                                                                                        <TextBlock Text="نصيحة اليوم"
                                                                                                   Foreground="#00D4FF"
                                                                                                   FontSize="14"
                                                                                                   FontWeight="Bold"
                                                                                                   Margin="0,0,0,4">
                                                                                                <TextBlock.Effect>
                                                                                                        <DropShadowEffect Color="#00D4FF"
                                                                                                                        BlurRadius="8"
                                                                                                                        ShadowDepth="0"
                                                                                                                        Opacity="0.4"/>
                                                                                                </TextBlock.Effect>
                                                                                        </TextBlock>
                                                                                        <TextBlock x:Name="txtRandomTip"
                                                                                                   Foreground="#EBF4FF"
                                                                                                   FontSize="14"
                                                                                                   TextWrapping="Wrap"
                                                                                                   MaxWidth="400"
                                                                                                   LineHeight="22">
                                                                                                <Run Text="تأكد من إغلاق الوردية يومياً للحفاظ على دقة الحسابات."/>
                                                                                        </TextBlock>
                                                                                </StackPanel>

                                                                                <Button Grid.Column="2"
                                                                                        Content="التالي &#187;"
                                                                                        VerticalAlignment="Bottom"
                                                                                        Margin="12,0,0,0"
                                                                                        Style="{StaticResource SecondaryLoginButtonStyle}"
                                                                                        Foreground="#00D4FF"
                                                                                        BorderBrush="#4000D4FF"
                                                                                        Background="#1000D4FF"
                                                                                        Padding="10,4"
                                                                                        Height="32"
                                                                                        Click="NextTipButton_Click"/>
                                                                        </Grid>
                                                                </Border>
                                                        </StackPanel>
                                                </Grid>

                                                <!-- ── Vertical Glow Divider ── -->
                                                <Rectangle Grid.Column="1"
                                                           Margin="0,28">
                                                        <Rectangle.Fill>
                                                                <LinearGradientBrush StartPoint="0,0"
                                                                                     EndPoint="0,1">
                                                                        <GradientStop Color="#00000000"
                                                                                      Offset="0"/>
                                                                        <GradientStop Color="#2000D4FF"
                                                                                      Offset="0.3"/>
                                                                        <GradientStop Color="#2000D4FF"
                                                                                      Offset="0.7"/>
                                                                        <GradientStop Color="#00000000"
                                                                                      Offset="1"/>
                                                                </LinearGradientBrush>
                                                        </Rectangle.Fill>
                                                </Rectangle>

                                                <!-- ─────────────────────────────── -->
                                                <!--  RIGHT — Login Form             -->
                                                <!-- ─────────────────────────────── -->
                                                <Grid Grid.Column="2"
                                                      Margin="30,14,50,24">
                                                        <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- Header -->
                                                        <StackPanel HorizontalAlignment="Center">
                                                                <TextBlock Text="تسجيل الدخول"
                                                                           Foreground="#E0EFFF"
                                                                           FontSize="30"
                                                                           FontWeight="Black"
                                                                           HorizontalAlignment="Center">
                                                                        <TextBlock.Effect>
                                                                                <DropShadowEffect Color="#00D4FF"
                                                                                                  BlurRadius="22"
                                                                                                  ShadowDepth="0"
                                                                                                  Opacity="0.20"/>
                                                                        </TextBlock.Effect>
                                                                </TextBlock>
                                                                <Rectangle Height="3"
                                                                           Width="55"
                                                                           Margin="0,10,0,0"
                                                                           RadiusX="2"
                                                                           RadiusY="2"
                                                                           HorizontalAlignment="Center">
                                                                        <Rectangle.Fill>
                                                                                <LinearGradientBrush StartPoint="0,0"
                                                                                                     EndPoint="1,0">
                                                                                        <GradientStop Color="#00D4FF"
                                                                                                      Offset="0"/>
                                                                                        <GradientStop Color="#6D28D9"
                                                                                                      Offset="1"/>
                                                                                </LinearGradientBrush>
                                                                        </Rectangle.Fill>
                                                                </Rectangle>
                                                                <TextBlock Text="أدخل بياناتك للوصول إلى لوحة التحكم"
                                                                           Foreground="#2A4260"
                                                                           FontSize="13"
                                                                           HorizontalAlignment="Center"
                                                                           Margin="0,10,0,0"/>
                                                        </StackPanel>

                                                        <!-- ── Glassmorphism Login Card ── -->
                                                        <Border Grid.Row="1"
                                                                VerticalAlignment="Center"
                                                                Margin="0,22,0,0"
                                                                Padding="32,26"
                                                                Background="#BB07141F"
                                                                BorderBrush="#1AFFFFFF"
                                                                BorderThickness="1"
                                                                CornerRadius="22">
                                                                <Border.Effect>
                                                                        <DropShadowEffect Color="#000000"
                                                                                          BlurRadius="30"
                                                                                          ShadowDepth="0"
                                                                                          Opacity="0.55"/>
                                                                </Border.Effect>
                                                                <StackPanel>

                                                                        <!-- Username -->
                                                                        <TextBlock Text="اسم المستخدم"
                                                                                   Style="{StaticResource LoginFieldLabelStyle}"/>
                                                                        <TextBox x:Name="txtUsername"
                                                                                 Style="{StaticResource LoginTextBoxStyle}"
                                                                                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                                                                 IsEnabled="{Binding IsBusy, Converter={StaticResource BoolNegationConverter}}"/>

                                                                        <!-- Password -->
                                                                        <TextBlock Text="كلمة المرور"
                                                                                   Style="{StaticResource LoginFieldLabelStyle}"
                                                                                   Margin="2,18,0,7"/>
                                                                        <PasswordBox x:Name="PasswordBox"
                                                                                     Style="{StaticResource LoginPasswordBoxStyle}"
                                                                                     IsEnabled="{Binding IsBusy, Converter={StaticResource BoolNegationConverter}}"
                                                                                     PasswordChanged="PasswordBox_PasswordChanged"/>

                                                                        <!-- Error Message -->
                                                                        <Border Margin="0,14,0,0"
                                                                                Padding="14,10"
                                                                                CornerRadius="10"
                                                                                Background="#18FF1C1C"
                                                                                BorderBrush="#25FF4444"
                                                                                BorderThickness="1">
                                                                                <Border.Style>
                                                                                        <Style TargetType="Border">
                                                                                                <Style.Triggers>
                                                                                                        <DataTrigger Binding="{Binding ErrorMessage}"
                                                                                                                     Value="{x:Null}">
                                                                                                                <Setter Property="Visibility"
                                                                                                                        Value="Collapsed"/>
                                                                                                        </DataTrigger>
                                                                                                        <DataTrigger Binding="{Binding ErrorMessage}"
                                                                                                                     Value="">
                                                                                                                <Setter Property="Visibility"
                                                                                                                        Value="Collapsed"/>
                                                                                                        </DataTrigger>
                                                                                                </Style.Triggers>
                                                                                        </Style>
                                                                                </Border.Style>
                                                                                <TextBlock Text="{Binding ErrorMessage}"
                                                                                           Foreground="#FF8080"
                                                                                           FontSize="13"
                                                                                           FontWeight="SemiBold"
                                                                                           TextWrapping="Wrap"/>
                                                                        </Border>

                                                                        <!-- Busy progress indicator -->
                                                                        <StackPanel Orientation="Horizontal"
                                                                                    Margin="0,12,0,0"
                                                                                    HorizontalAlignment="Center"
                                                                                    Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                <ProgressBar Width="100"
                                                                                             Height="3"
                                                                                             Margin="0,0,12,0"
                                                                                             IsIndeterminate="True"
                                                                                             Foreground="#00D4FF"
                                                                                             Background="#0F1F30"
                                                                                             BorderBrush="Transparent"/>
                                                                                <TextBlock Text="جاري التحقق..."
                                                                                           Foreground="#2A4260"
                                                                                           FontSize="12"
                                                                                           VerticalAlignment="Center"/>
                                                                        </StackPanel>

                                                                        <!-- Login Button -->
                                                                        <Button Content="دخول إلى النظام"
                                                                                Style="{StaticResource PrimaryLoginButtonStyle}"
                                                                                Command="{Binding LoginCommand}"
                                                                                IsDefault="True"
                                                                                Margin="0,22,0,0"
                                                                                IsEnabled="{Binding IsBusy, Converter={StaticResource BoolNegationConverter}}"/>

                                                                        <!-- Exit Button -->
                                                                        <Button Content="إغلاق البرنامج"
                                                                                Style="{StaticResource SecondaryLoginButtonStyle}"
                                                                                Command="{Binding ExitCommand}"
                                                                                IsCancel="True"
                                                                                Margin="0,10,0,0"
                                                                                IsEnabled="{Binding IsBusy, Converter={StaticResource BoolNegationConverter}}"/>

                                                                </StackPanel>
                                                        </Border>
                                                </Grid>
                                        </Grid>

                                        <!-- ════════════════════════════════════ -->
                                        <!--  ROW 2 — Footer                     -->
                                        <!-- ════════════════════════════════════ -->
                                        <Grid Grid.Row="2">
                                                <Rectangle Height="1"
                                                           VerticalAlignment="Top">
                                                        <Rectangle.Fill>
                                                                <LinearGradientBrush StartPoint="0,0"
                                                                                     EndPoint="1,0">
                                                                        <GradientStop Color="#00000000"
                                                                                      Offset="0"/>
                                                                        <GradientStop Color="#1200D4FF"
                                                                                      Offset="0.3"/>
                                                                        <GradientStop Color="#1200D4FF"
                                                                                      Offset="0.7"/>
                                                                        <GradientStop Color="#00000000"
                                                                                      Offset="1"/>
                                                                </LinearGradientBrush>
                                                        </Rectangle.Fill>
                                                </Rectangle>
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="RoboVAI Solutions"
                                                                   Foreground="#1A3450"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"/>
                                                        <TextBlock Text="  ·  "
                                                                   Foreground="#122840"
                                                                   FontSize="11"/>
                                                        <TextBlock Text="© 2026 جميع الحقوق محفوظة"
                                                                   Foreground="#122840"
                                                                   FontSize="11"/>
                                                </StackPanel>
                                        </Grid>

                                </Grid>
                        </Grid>
                </Border>
        </Grid>

</Window>

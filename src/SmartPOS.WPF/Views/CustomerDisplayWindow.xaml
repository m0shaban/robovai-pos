<Window x:Class="SmartPOS.WPF.Views.CustomerDisplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="شاشة العميل"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        Width="500" Height="700"
        FontFamily="Segoe UI, Tahoma"
        FlowDirection="RightToLeft">

    <Border Background="#0F172A" CornerRadius="12" BorderBrush="#1E3A5F" BorderThickness="2">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Store Name -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20">
                <TextBlock x:Name="StoreNameText" Text="RobovAI PRO POS"
                           FontSize="28" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center"/>
                <Rectangle Height="2" Fill="#1E3A5F" Margin="0,8,0,0"/>
            </StackPanel>

            <!-- Customer Name -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,20">
                <TextBlock Text="مرحباً بك" FontSize="16" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                <TextBlock x:Name="CustomerNameText" Text="زبون كريم"
                           FontSize="22" FontWeight="SemiBold" Foreground="#38BDF8"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Items List -->
            <Border Grid.Row="2" Background="#1E293B" CornerRadius="8" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ItemsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}"
                                               Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat='x{0}'}"
                                               Foreground="#94A3B8" FontSize="13" Margin="8,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Total, StringFormat='{}{0:N2}'}"
                                               Foreground="#38BDF8" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Total -->
            <Border Grid.Row="3" Background="#1E3A5F" CornerRadius="8" Padding="16" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="الإجمالي" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Grid.Column="1" x:Name="TotalText" Text="0.00 ج.م"
                               FontSize="26" FontWeight="Bold" Foreground="#38BDF8"/>
                </Grid>
            </Border>

            <!-- Welcome Message -->
            <TextBlock Grid.Row="4" x:Name="WelcomeText"
                       Text="شكراً لتسوقكم معنا 😊"
                       FontSize="16" Foreground="#64748B"
                       HorizontalAlignment="Center" Margin="0,16,0,0"/>
        </Grid>
    </Border>
</Window>

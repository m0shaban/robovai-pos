<Page x:Class="SmartPOS.WPF.Views.ProductsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="المنتجات"
      FontFamily="Segoe UI, Tahoma"
      FlowDirection="RightToLeft"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded">

    <Grid Background="{DynamicResource AlAtmani.BackgroundBrush}"
          Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4*"/>
        </Grid.RowDefinitions>

        <!-- Search and Filter (Combined Header) -->
        <materialDesign:Card Grid.Row="1"
                             Padding="12"
                             Margin="0,0,0,8"
                             Style="{StaticResource AlAtmani.GlassCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="إدارة المنتجات"
                           FontSize="18" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,16,0"/>

                <TextBox Grid.Column="1"
                         x:Name="SearchBox"
                         materialDesign:HintAssist.Hint="ابحث بالاسم أو الباركود..."
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="14"
                         Height="48"
                         Margin="0,0,16,0"
                         materialDesign:TextFieldAssist.HasClearButton="True"/>

                <ComboBox Grid.Column="2"
                          x:Name="CategoryFilterComboBox"
                          materialDesign:HintAssist.Hint="التصنيف"
                          ItemsSource="{Binding Categories}"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          SelectedValue="{Binding SelectedCategoryFilter}"
                          Height="48"
                          FontSize="14"
                          Margin="0,0,16,0"/>

                <Button Grid.Column="3"
                        Content="مسح"
                        Height="48"
                        Width="80"
                        Style="{StaticResource AlAtmani.SoftButton}"
                        Command="{Binding ClearFilterCommand}"/>
            </Grid>
        </materialDesign:Card>

        <!-- ══════ Product Form (Admin/Manager/SuperAdmin) ══════ -->
        <materialDesign:Card Grid.Row="2"
                             Padding="12"
                             Margin="0,0,0,8"
                             Style="{StaticResource AlAtmani.GlassCard}"
                             Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <!-- image column -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Image Picker -->
                <Border Grid.Column="0" Width="90" Height="90"
                        CornerRadius="12"
                        Background="{DynamicResource AlAtmani.Surface2Brush}"
                        BorderBrush="{DynamicResource AlAtmani.BorderBrush}"
                        BorderThickness="1"
                        Margin="0,0,20,0"
                        Cursor="Hand">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding BrowseImageCommand}"/>
                    </Border.InputBindings>
                    <!-- Show image if path set, else placeholder icon -->
                    <Grid>
                        <Image Source="{Binding FormImagePath}"
                               Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding FormImagePath, Converter={StaticResource NullToVisibilityConverter}}">
                            <materialDesign:PackIcon Kind="ImagePlus" Width="36" Height="36"
                                                     Foreground="{DynamicResource AlAtmani.AccentBrush}" Opacity="0.6"/>
                            <TextBlock Text="اضغط لإضافة صورة" FontSize="10"
                                       Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}"
                                       HorizontalAlignment="Center" TextWrapping="Wrap"
                                       TextAlignment="Center" Margin="4,4,4,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Form Fields -->
                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 1: Name(3), Barcode(2), Category(2), Unit(1) -->
                    <TextBox Grid.Column="0" Grid.ColumnSpan="3"
                             materialDesign:HintAssist.Hint="اسم المنتج *"
                             Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0,0,8,8"/>

                    <TextBox Grid.Column="3" Grid.ColumnSpan="2"
                             materialDesign:HintAssist.Hint="الباركود *"
                             Text="{Binding FormBarcode, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0,0,8,8"/>

                    <ComboBox Grid.Column="5" Grid.ColumnSpan="2"
                              ItemsSource="{Binding Categories}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding FormCategoryId}"
                              materialDesign:HintAssist.Hint="التصنيف *"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              Margin="0,0,8,8"/>

                    <ComboBox Grid.Column="7" Grid.ColumnSpan="1"
                              ItemsSource="{Binding Units}"
                              SelectedItem="{Binding FormUnit}"
                              materialDesign:HintAssist.Hint="الوحدة"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              Margin="0,0,0,8"/>

                    <!-- Row 2: Purchase Price(2), Selling Price(2), Stock(2), MinStock(2) -->
                    <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                             materialDesign:HintAssist.Hint="سعر الشراء"
                             Text="{Binding FormPurchasePrice, StringFormat={}{0:0.##}}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0,0,8,8"/>

                    <TextBox Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2"
                             materialDesign:HintAssist.Hint="سعر البيع"
                             Text="{Binding FormSellingPrice, StringFormat={}{0:0.##}}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0,0,8,8"/>

                    <TextBox Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="2"
                             materialDesign:HintAssist.Hint="الكمية في المخزون"
                             Text="{Binding FormStock}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0,0,8,8"/>

                    <TextBox Grid.Row="1" Grid.Column="6" Grid.ColumnSpan="2"
                             materialDesign:HintAssist.Hint="حد التنبيه (10 افتراضي)"
                             Text="{Binding FormMinStockLevel}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0,0,0,8"/>

                    <!-- Row 3: Description(3), IsActive(1) + Buttons(4) -->
                    <TextBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                             materialDesign:HintAssist.Hint="وصف المنتج (اختياري)"
                             Text="{Binding FormDescription, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0,0,8,0"/>

                    <CheckBox Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="1"
                              IsChecked="{Binding FormIsActive}"
                              Content="نشط"
                              Style="{StaticResource MaterialDesignFilterChipPrimaryOutlineCheckBox}"
                              Margin="0,0,8,0"/>

                    <StackPanel Grid.Row="2" Grid.Column="4" Grid.ColumnSpan="4"
                                Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="💾 حفظ"
                                Style="{StaticResource AlAtmani.SoftButton}"
                                Width="90"
                                Background="{DynamicResource AlAtmani.AccentBrush}"
                                Foreground="White"
                                Command="{Binding SaveProductCommand}"
                                Margin="0,0,8,0"/>
                        <Button Content="✕ تفريغ"
                                Style="{StaticResource AlAtmani.SoftButton}"
                                Width="90"
                                Command="{Binding ClearFormCommand}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </materialDesign:Card>



        <!-- Products Grid -->
        <materialDesign:Card Grid.Row="3"
                             Padding="16"
                             VerticalAlignment="Stretch"
                             Style="{StaticResource AlAtmani.GlassCard}">
            <Grid VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Toolbar -->
                <DockPanel Grid.Row="0"
                           Margin="0,0,0,16">
                    <TextBlock Text="قائمة المنتجات"
                               FontSize="18"
                               FontWeight="SemiBold"
                               DockPanel.Dock="Left"
                               VerticalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal"
                                DockPanel.Dock="Right"
                                HorizontalAlignment="Right">
                        <Button Margin="0,0,8,0"
                                Style="{StaticResource ModernButton}"
                                Command="{Binding ImportExcelCommand}"
                                ToolTip="استيراد من إكسيل"
                                Height="40">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileExcelBox" Width="20" Height="20" Foreground="#10B981" Margin="0,0,8,0"/>
                                    <TextBlock Text="استيراد"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                        <Button Margin="0,0,8,0"
                                Style="{StaticResource ModernButton}"
                                Command="{Binding ExportExcelCommand}"
                                ToolTip="تصدير إلى إكسيل"
                                Height="40">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileExcelBox" Width="20" Height="20" Foreground="#10B981" Margin="0,0,8,0"/>
                                    <TextBlock Text="تصدير إكسيل"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                        <Button Margin="0,0,8,0"
                                Style="{StaticResource ModernButton}"
                                Command="{Binding ExportPdfCommand}"
                                ToolTip="تصدير إلى PDF"
                                Height="40">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FilePdfBox" Width="20" Height="20" Foreground="#DC2626" Margin="0,0,8,0"/>
                                    <TextBlock Text="تصدير PDF"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                        <Button Margin="0,0,8,0"
                                Style="{StaticResource ModernButton}"
                                Command="{Binding RefreshProductsCommand}"
                                Height="40">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" Margin="0,0,8,0"/>
                                    <TextBlock Text="تحديث"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                    </StackPanel>
                </DockPanel>

                <!-- DataGrid - Enhanced -->
                <DataGrid Grid.Row="1"
                          x:Name="ProductsDataGrid"
                          ItemsSource="{Binding FilteredProducts}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectedItem="{Binding SelectedProduct}"
                          RowHeight="44"
                          FontSize="13"
                          materialDesign:DataGridAssist.CellPadding="6,4,6,4"
                          materialDesign:DataGridAssist.ColumnHeaderPadding="8,6,8,6">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="12,10"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>

                        <!-- الصورة -->
                        <DataGridTemplateColumn Width="70">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="ImageOutline" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="الصورة" FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Width="32" Height="32" CornerRadius="6"
                                            Background="{DynamicResource AlAtmani.Surface2Brush}"
                                            ClipToBounds="True" HorizontalAlignment="Center">
                                        <Grid>
                                            <materialDesign:PackIcon Kind="ImageOutline" Width="16" Height="16"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.3"/>
                                            <Image Source="{Binding ImagePath}" Stretch="UniformToFill"
                                                   Visibility="{Binding ImagePath, Converter={StaticResource NullToVisibilityConverter}}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- الباركود -->
                        <DataGridTemplateColumn Width="150">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Barcode" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="رقم الباركود" FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <materialDesign:PackIcon Kind="Barcode" Width="12" Height="12" Opacity="0.5" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding Barcode}" FontFamily="Courier New" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource AlAtmani.AccentBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- اسم المنتج -->
                        <DataGridTemplateColumn Width="2*">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="PackageVariant" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="اسم المنتج" FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" Margin="4,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- التصنيف -->
                        <DataGridTemplateColumn Width="160">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="TagMultiple" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="التصنيف" FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource AlAtmani.Surface2Brush}" CornerRadius="8"
                                            Padding="8,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Tag" Width="14" Height="14"
                                                                     Foreground="{DynamicResource AlAtmani.AccentBrush}"
                                                                     VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding Category.Name}" FontSize="12" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- سعر الشراء -->
                        <DataGridTemplateColumn Width="150">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="CartArrowDown" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="سعر الشراء" FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Run Text="شراء: " Foreground="Gray" FontSize="11"/>
                                        <Run Text="{Binding PurchasePrice, StringFormat={}{0:F2} ج.م}" FontWeight="Bold" Foreground="#F59E0B"/>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- سعر البيع -->
                        <DataGridTemplateColumn Width="150">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="CashRegister" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="سعر البيع" FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Run Text="بيع: " Foreground="Gray" FontSize="11"/>
                                        <Run Text="{Binding SellingPrice, StringFormat={}{0:F2} ج.م}" FontWeight="Bold" Foreground="{DynamicResource AlAtmani.AccentBrush}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- الكمية في المخزون -->
                        <DataGridTemplateColumn Width="130">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Warehouse" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="الكمية" FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Stock}" FontWeight="Bold" FontSize="14"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{Binding Converter={StaticResource StockToColorConverter}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- الوحدة -->
                        <DataGridTemplateColumn Width="110">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="ScaleBalance" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="وحدة القياس" FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource AlAtmani.Surface2Brush}" CornerRadius="6"
                                            Padding="8,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Unit}" FontSize="12" HorizontalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- حالة المنتج -->
                        <DataGridTemplateColumn Width="110">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="CheckCircle" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="الحالة" FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <materialDesign:Chip Content="{Binding IsActive, Converter={StaticResource BoolToStatusConverter}}"
                                                         Background="{Binding IsActive, Converter={StaticResource BoolToColorConverter}}"
                                                         Foreground="White" FontSize="12"
                                                         HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- تنبيه المخزون -->
                        <DataGridTemplateColumn Width="120">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="AlertCircle" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="تنبيه المخزون" FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Converter={StaticResource StockToColorConverter}}"
                                            CornerRadius="8" Padding="8,4"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="AlertCircleOutline" Width="14" Height="14"
                                                                     Foreground="White" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding Converter={StaticResource StockToTextConverter}}"
                                                       Foreground="White" FontSize="12" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- الإجراءات -->
                        <DataGridTemplateColumn Width="130"
                                                Visibility="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Settings" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="الإجراءات" FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                ToolTip="تعديل" Width="34" Height="34" Margin="2,0"
                                                Command="{Binding DataContext.EditProductCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="Pencil" Width="20" Height="20"
                                                                     Foreground="{DynamicResource AlAtmani.AccentBrush}"/>
                                        </Button>
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                ToolTip="حذف" Width="34" Height="34" Margin="2,0"
                                                Command="{Binding DataContext.DeleteProductCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="Delete" Width="20" Height="20"
                                                                     Foreground="#FB7185"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>

                <!-- No Data Message -->
                <StackPanel Grid.Row="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Visibility="{Binding ElementName=ProductsDataGrid, Path=Items.Count, Converter={StaticResource CountToVisibilityConverter}}">
                    <materialDesign:PackIcon Kind="PackageVariant"
                                             Width="80"
                                             Height="80"
                                             Opacity="0.3"
                                             Margin="0,0,0,16"/>
                    <TextBlock Text="لا توجد منتجات"
                               FontSize="18"
                               Opacity="0.6"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </materialDesign:Card>
    </Grid>
</Page>


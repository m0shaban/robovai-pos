<Page x:Class="SmartPOS.WPF.Views.InvoicesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="{DynamicResource Loc_250c74e3}"
      FontFamily="Segoe UI, Tahoma"
      FlowDirection="RightToLeft"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded">

        <Grid Background="{DynamicResource AlAtmani.BackgroundBrush}"
              Margin="24">
                <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <materialDesign:Card Grid.Row="0"
                                     Style="{StaticResource AlAtmani.GlassCard}">
                        <DockPanel>
                                <Border Background="#E8F5E9"
                                        CornerRadius="12"
                                        Padding="12"
                                        DockPanel.Dock="Right"
                                        Margin="0,0,16,0">
                                        <materialDesign:PackIcon Kind="Receipt"
                                                                 Width="36"
                                                                 Height="36"
                                                                 Foreground="#2E7D32"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Loc_250c74e3}"
                                                   Style="{StaticResource AlAtmani.HeaderText}"
                                                   Margin="0"/>
                                        <TextBlock Text="{DynamicResource Loc_cbe4c20e}"
                                                   FontSize="13"
                                                   Foreground="#2E7D32"
                                                   Opacity="0.8"/>
                                </StackPanel>
                        </DockPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Row="1"
                                     Padding="16"
                                     Margin="0,0,0,16"
                                     Style="{StaticResource AlAtmani.GlassCard}">
                        <DockPanel>
                                <TextBlock Text="{DynamicResource Loc_6079fc6b}"
                                           FontSize="15"
                                           VerticalAlignment="Center"
                                           Margin="0,0,16,0"/>
                                <DatePicker SelectedDate="{Binding StartDate}"
                                            Width="160"
                                            Margin="0,0,12,0"/>
                                <DatePicker SelectedDate="{Binding EndDate}"
                                            Width="160"
                                            Margin="0,0,12,0"/>
                                <Button Content="{DynamicResource Loc_ab79fc14}"
                                        Style="{StaticResource AlAtmani.SoftButton}"
                                        Width="100"
                                        Margin="0,0,8,0"
                                        Command="{Binding FilterCommand}"/>
                                <Button Content="{DynamicResource Loc_708a309a}"
                                        Style="{StaticResource AlAtmani.SoftButton}"
                                        Width="150"
                                        Margin="0,0,8,0"
                                        Background="#E91E63"
                                        Foreground="White"
                                        Command="{Binding PrintPurchaseReportCommand}"/>
                                <Button Content="{DynamicResource Loc_ce12f2a2}"
                                        Style="{StaticResource AlAtmani.SoftButton}"
                                        Width="150"
                                        Background="#9C27B0"
                                        Foreground="White"
                                        Command="{Binding PrintIncomeReportCommand}"/>
                        </DockPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Row="2"
                                     Style="{StaticResource AlAtmani.GlassCard}"
                                     Padding="16">
                        <DataGrid AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  SelectedItem="{Binding SelectedSale}"
                                  ItemsSource="{Binding Sales}">
                                <DataGrid.Columns>
                                        <DataGridTextColumn Header="{DynamicResource Loc_aad5385a}"
                                                            Binding="{Binding InvoiceNumber}"
                                                            Width="*"/>
                                        <DataGridTextColumn Header="{DynamicResource Loc_8456f22b}"
                                                            Binding="{Binding SaleDate, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                                            Width="*"/>
                                        <DataGridTextColumn Header="{DynamicResource Loc_1567b6bf}"
                                                            Binding="{Binding User.FullName}"
                                                            Width="*"/>
                                        <DataGridTextColumn Header="{DynamicResource Loc_bc9b4318}"
                                                            Binding="{Binding Customer.Name}"
                                                            Width="*"/>
                                        <DataGridTextColumn Header="{DynamicResource Loc_88fc73eb}"
                                                            Binding="{Binding TotalAmount, StringFormat='{}{0:F2} ج.م'}"
                                                            Width="*"/>
                                        <DataGridTemplateColumn Header="{DynamicResource Loc_901efe9b}"
                                                                Width="180">
                                                <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                <!-- Print Receipt -->
                                                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                                                        ToolTip="{DynamicResource Loc_d1d00152}"
                                                                        Width="34" Height="34" Margin="2,0"
                                                                        Command="{Binding DataContext.PrintInvoiceCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                        CommandParameter="{Binding}">
                                                                        <materialDesign:PackIcon Kind="Printer" Width="20" Height="20" Foreground="#2E7D32"/>
                                                                </Button>
                                                                <!-- Export PDF -->
                                                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                                                        ToolTip="{DynamicResource Loc_bd239af0}"
                                                                        Width="34" Height="34" Margin="2,0"
                                                                        Command="{Binding DataContext.ExportInvoicePdfCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                        CommandParameter="{Binding}">
                                                                        <materialDesign:PackIcon Kind="FilePdfBox" Width="20" Height="20" Foreground="#1976D2"/>
                                                                </Button>
                                                                <!-- Void / Return Sale -->
                                                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                                                        ToolTip="{DynamicResource Loc_755a53c9}"
                                                                        Width="34" Height="34" Margin="2,0"
                                                                        Command="{Binding DataContext.VoidSaleCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                        CommandParameter="{Binding}">
                                                                        <materialDesign:PackIcon Kind="DeleteForever" Width="20" Height="20" Foreground="#FB7185"/>
                                                                </Button>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                </DataGrid.Columns>
                        </DataGrid>
                </materialDesign:Card>
        </Grid>
</Page>
<Page x:Class="SmartPOS.WPF.Views.PurchaseOrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="المشتريات"
      FontFamily="Segoe UI, Tahoma"
      FlowDirection="RightToLeft">

    <Grid Background="{DynamicResource AlAtmani.BackgroundBrush}" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="إدارة المشتريات" FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource AlAtmani.AccentBrush}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Command="{Binding RefreshAllCommand}"
                    Style="{StaticResource AlAtmani.SoftButton}" Padding="12,8">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" Margin="0,0,6,0"/>
                    <TextBlock Text="تحديث"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Tab Control -->
        <TabControl Grid.Row="1"
                    SelectedIndex="{Binding SelectedTabIndex}"
                    Style="{StaticResource MaterialDesignTabControl}">

            <!-- ══════════════════════════════════════════════════════════
                 TAB 1 — NEW ORDER
                 ══════════════════════════════════════════════════════════ -->
            <TabItem Header="➕ فاتورة جديدة">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: form -->
                    <materialDesign:Card Grid.Column="0" Style="{StaticResource AlAtmani.GlassCard}"
                                         Margin="0,0,12,0" Padding="16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="بيانات الفاتورة" FontSize="16" FontWeight="Bold"
                                           Foreground="{DynamicResource AlAtmani.AccentBrush}" Margin="0,0,0,16"/>

                                <TextBox materialDesign:HintAssist.Hint="رقم الفاتورة"
                                         Text="{Binding InvoiceNumber}" IsReadOnly="True"
                                         Margin="0,0,0,12" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                                <DatePicker materialDesign:HintAssist.Hint="تاريخ الفاتورة"
                                            SelectedDate="{Binding OrderDate}"
                                            Margin="0,0,0,12" Style="{StaticResource MaterialDesignOutlinedDatePicker}"/>

                                <ComboBox materialDesign:HintAssist.Hint="المورد *"
                                          ItemsSource="{Binding Suppliers}"
                                          SelectedItem="{Binding SelectedSupplier}"
                                          DisplayMemberPath="Name"
                                          Margin="0,0,0,20" Style="{StaticResource MaterialDesignOutlinedComboBox}"/>

                                <Separator Margin="0,0,0,16"/>
                                <TextBlock Text="إضافة صنف" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>

                                <ComboBox materialDesign:HintAssist.Hint="اختر المنتج"
                                          ItemsSource="{Binding Products}"
                                          SelectedItem="{Binding SelectedProduct}"
                                          DisplayMemberPath="Name"
                                          Margin="0,0,0,12" Style="{StaticResource MaterialDesignOutlinedComboBox}"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="الكمية"
                                             Text="{Binding Quantity}" Margin="0,0,6,0"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                    <TextBox Grid.Column="1" materialDesign:HintAssist.Hint="سعر الشراء"
                                             Text="{Binding CostPrice, StringFormat={}{0:0.##}}" Margin="6,0,0,0"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                </Grid>

                                <Button Content="➕ إضافة للفاتورة" Command="{Binding AddItemCommand}"
                                        Style="{StaticResource AlAtmani.SoftButton}"
                                        Background="{DynamicResource AlAtmani.AccentBrush}"
                                        Foreground="White" Margin="0,0,0,4"/>
                            </StackPanel>
                        </ScrollViewer>
                    </materialDesign:Card>

                    <!-- Right: items + totals -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <materialDesign:Card Grid.Row="0" Style="{StaticResource AlAtmani.GlassCard}" Margin="0,0,0,12">
                            <DataGrid ItemsSource="{Binding OrderItems}"
                                      AutoGenerateColumns="False" CanUserAddRows="False"
                                      IsReadOnly="True"
                                      materialDesign:DataGridAssist.CellPadding="10">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="المنتج" Binding="{Binding Product.Name}" Width="2*"/>
                                    <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity}" Width="*"/>
                                    <DataGridTextColumn Header="سعر الوحدة" Binding="{Binding UnitCost, StringFormat='{}{0:N2}'}" Width="*"/>
                                    <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalCost, StringFormat='{}{0:N2}'}" Width="*"/>
                                    <DataGridTemplateColumn Header="حذف" Width="60">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                                        Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}">
                                                    <materialDesign:PackIcon Kind="Delete" Width="20" Height="20" Foreground="#DC2626"/>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </materialDesign:Card>

                        <!-- Totals bar -->
                        <materialDesign:Card Grid.Row="1" Style="{StaticResource AlAtmani.GlassCard}" Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="إجمالي الفاتورة" Foreground="Gray" FontSize="11"/>
                                    <TextBlock Text="{Binding TotalAmount, StringFormat='{}{0:N2}'}"
                                               FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AlAtmani.AccentBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="12,0">
                                    <TextBlock Text="المدفوع" Foreground="Gray" FontSize="11"/>
                                    <TextBox Text="{Binding PaidAmount, StringFormat={}{0:0.##}}"
                                             FontSize="18" FontWeight="Bold"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             materialDesign:HintAssist.Hint="0.00"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="المتبقي (آجل)" Foreground="Gray" FontSize="11"/>
                                    <TextBlock Text="{Binding RemainingAmount, StringFormat='{}{0:N2} ج.م'}"
                                               FontSize="20" FontWeight="Bold" Foreground="#DC2626"/>
                                </StackPanel>
                                <Button Grid.Column="3" Content="💾 حفظ الفاتورة"
                                        Command="{Binding SaveOrderCommand}"
                                        Style="{StaticResource AlAtmani.SoftButton}"
                                        Background="#059669" Foreground="White"
                                        FontSize="15" Height="55" Padding="20,0"/>
                            </Grid>
                        </materialDesign:Card>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ══════════════════════════════════════════════════════════
                 TAB 2 — PURCHASE HISTORY
                 ══════════════════════════════════════════════════════════ -->
            <TabItem Header="📋 سجل الفواتير">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Filter bar -->
                    <materialDesign:Card Grid.Row="0" Style="{StaticResource AlAtmani.GlassCard}"
                                         Padding="16" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <DatePicker Grid.Column="0" materialDesign:HintAssist.Hint="من تاريخ"
                                        SelectedDate="{Binding HistoryStartDate}"
                                        Style="{StaticResource MaterialDesignOutlinedDatePicker}" Margin="0,0,8,0"/>
                            <DatePicker Grid.Column="1" materialDesign:HintAssist.Hint="إلى تاريخ"
                                        SelectedDate="{Binding HistoryEndDate}"
                                        Style="{StaticResource MaterialDesignOutlinedDatePicker}" Margin="0,0,8,0"/>
                            <ComboBox Grid.Column="2" materialDesign:HintAssist.Hint="المورد (الكل)"
                                      ItemsSource="{Binding Suppliers}"
                                      SelectedItem="{Binding HistoryFilterSupplier}"
                                      DisplayMemberPath="Name"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="3" materialDesign:HintAssist.Hint="🔍 بحث برقم الفاتورة"
                                     Text="{Binding HistorySearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,8,0"/>
                            <Button Grid.Column="4" Content="بحث" Command="{Binding FilterHistoryCommand}"
                                    Style="{StaticResource AlAtmani.SoftButton}" Padding="16,8"/>
                        </Grid>
                    </materialDesign:Card>

                    <!-- History grid -->
                    <materialDesign:Card Grid.Row="1" Style="{StaticResource AlAtmani.GlassCard}">
                        <DataGrid ItemsSource="{Binding PurchaseHistory}"
                                  SelectedItem="{Binding SelectedHistoryOrder}"
                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                  IsReadOnly="True"
                                  materialDesign:DataGridAssist.CellPadding="10">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding OrderNumber}" Width="*"/>
                                <DataGridTextColumn Header="التاريخ" Binding="{Binding OrderDate, StringFormat='dd/MM/yyyy'}" Width="*"/>
                                <DataGridTextColumn Header="المورد" Binding="{Binding Supplier.Name}" Width="*"/>
                                <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalAmount, StringFormat='{}{0:N2}'}" Width="*"/>
                                <DataGridTextColumn Header="المدفوع" Binding="{Binding PaidAmount, StringFormat='{}{0:N2}'}" Width="*"/>
                                <DataGridTextColumn Header="المتبقي" Binding="{Binding RemainingAmount, StringFormat='{}{0:N2}'}" Width="*"/>
                                <DataGridTemplateColumn Header="PDF" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                                    Command="{Binding DataContext.ExportOrderPdfCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="تصدير PDF">
                                                <materialDesign:PackIcon Kind="FilePdfBox" Foreground="#DC2626" Width="22" Height="22"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="استلام / موافقة" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.ApproveOrderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Background="#059669" Foreground="White"
                                                    Padding="8,4" FontSize="11"
                                                    ToolTip="الموافقة على الاستلام وتحديث المخزون">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource AlAtmani.SoftButton}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="1"> <!-- PurchaseOrderStatus.Pending is 1 -->
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="CheckAll" Width="14" Height="14" Margin="0,0,4,0"/>
                                                    <TextBlock Text="موافقة"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </materialDesign:Card>
                </Grid>
            </TabItem>

            <!-- ══════════════════════════════════════════════════════════
                 TAB 3 — SUPPLIER DEBTS
                 ══════════════════════════════════════════════════════════ -->
            <TabItem Header="💳 ديون الموردين">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="350"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: debt list -->
                    <Grid Grid.Column="0" Margin="0,0,12,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <materialDesign:Card Grid.Row="0" Style="{StaticResource AlAtmani.GlassCard}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="الموردون المدينون" FontSize="15" FontWeight="Bold"
                                           Foreground="{DynamicResource AlAtmani.AccentBrush}" Margin="12,12,12,8"/>
                                <ListBox ItemsSource="{Binding SuppliersWithDebt}"
                                         SelectedItem="{Binding SelectedDebtSupplier}"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding Phone}" FontSize="11" Foreground="Gray"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding DebtAmount, StringFormat='{}{0:N2} ج.م'}"
                                                           FontWeight="Bold" Foreground="#DC2626" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Payment form -->
                        <materialDesign:Card Grid.Row="1" Style="{StaticResource AlAtmani.GlassCard}" Padding="16">
                            <StackPanel>
                                <TextBlock Text="تسجيل سداد" FontSize="14" FontWeight="Bold" Margin="0,0,0,12"/>
                                <TextBox materialDesign:HintAssist.Hint="المبلغ المسدد *"
                                         Text="{Binding PaymentAmount, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,10"/>
                                <TextBox materialDesign:HintAssist.Hint="ملاحظات (اختياري)"
                                         Text="{Binding PaymentNotes}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12"/>
                                <Button Content="✅ تسجيل السداد" Command="{Binding PaySupplierDebtCommand}"
                                        Style="{StaticResource AlAtmani.SoftButton}"
                                        Background="#059669" Foreground="White"/>
                            </StackPanel>
                        </materialDesign:Card>
                    </Grid>

                    <!-- Right: payment history -->
                    <materialDesign:Card Grid.Column="1" Style="{StaticResource AlAtmani.GlassCard}">
                        <StackPanel>
                            <TextBlock Text="سجل المدفوعات للمورد المحدد" FontSize="15" FontWeight="Bold"
                                       Margin="12,12,12,8" Foreground="{DynamicResource AlAtmani.AccentBrush}"/>
                            <DataGrid ItemsSource="{Binding SupplierPaymentHistory}"
                                      AutoGenerateColumns="False" CanUserAddRows="False"
                                      IsReadOnly="True" MaxHeight="500"
                                      materialDesign:DataGridAssist.CellPadding="10">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="التاريخ" Binding="{Binding PaymentDate, StringFormat='dd/MM/yyyy HH:mm'}" Width="*"/>
                                    <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat='{}{0:N2} ج.م'}" Width="*"/>
                                    <DataGridTextColumn Header="المرجع" Binding="{Binding Reference}" Width="*"/>
                                    <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="2*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </materialDesign:Card>
                </Grid>
            </TabItem>

            <!-- ══════════════════════════════════════════════════════════
                 TAB 4 — LOW STOCK ALERT
                 ══════════════════════════════════════════════════════════ -->
            <TabItem Header="⚠️ تنبيه المخزون">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <materialDesign:Card Grid.Row="0" Style="{StaticResource AlAtmani.GlassCard}"
                                         Padding="16" Margin="0,0,0,12">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AlertCircle" Width="24" Height="24"
                                                         Foreground="#F59E0B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock VerticalAlignment="Center" FontSize="14">
                                    <Run Text="المنتجات التي وصل مخزونها للحد الأدنى أو أقل — إجمالي: "/>
                                    <Run Text="{Binding LowStockProducts.Count, Mode=OneWay}" FontWeight="Bold" Foreground="#DC2626"/>
                                    <Run Text=" صنف"/>
                                </TextBlock>
                            </StackPanel>
                            <Button HorizontalAlignment="Left" Command="{Binding RefreshLowStockCommand}"
                                    Style="{StaticResource AlAtmani.SoftButton}" Padding="12,6">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,4,0"/>
                                    <TextBlock Text="تحديث"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </materialDesign:Card>

                    <materialDesign:Card Grid.Row="1" Style="{StaticResource AlAtmani.GlassCard}">
                        <DataGrid ItemsSource="{Binding LowStockProducts}"
                                  SelectedItem="{Binding SelectedLowStockProduct}"
                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                  IsReadOnly="True"
                                  materialDesign:DataGridAssist.CellPadding="10">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Stock}" Value="0">
                                            <Setter Property="Background" Value="#FEF2F2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="المنتج" Binding="{Binding Name}" Width="2*"/>
                                <DataGridTextColumn Header="التصنيف" Binding="{Binding Category.Name}" Width="*"/>
                                <DataGridTextColumn Header="المورد" Binding="{Binding Supplier.Name}" Width="*"/>
                                <DataGridTemplateColumn Header="المخزون الحالي" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Stock}" FontWeight="Bold"
                                                       Foreground="{Binding Stock, Converter={StaticResource StockToColorConverter}}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="الحد الأدنى" Binding="{Binding MinStockLevel}" Width="*"/>
                                <DataGridTextColumn Header="سعر الشراء" Binding="{Binding PurchasePrice, StringFormat='{}{0:N2}'}" Width="*"/>
                                <DataGridTemplateColumn Header="طلب سريع" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource AlAtmani.SoftButton}"
                                                    Command="{Binding DataContext.QuickOrderLowStockCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="8,4" FontSize="11">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="ShoppingCart" Width="14" Height="14" Margin="0,0,4,0"/>
                                                    <TextBlock Text="اطلب"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </materialDesign:Card>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Page>

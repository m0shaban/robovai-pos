<Window x:Class="SmartPOS.WPF.Views.FirstTimeSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="معالج التهيئة والأتمتة الشاملة – RoboVAI PRO POS"
        Height="740" Width="1180"
        MinHeight="680" MinWidth="1060"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI Variable, Segoe UI, Tahoma"
        FlowDirection="RightToLeft">

    <Window.Resources>
        <!-- Space Theme Input Styles -->
        <Style x:Key="FluentInputLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Margin" Value="2,0,0,5"/>
        </Style>

        <Style x:Key="FluentTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#0A1625"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#1E354D"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="#00D4FF"/>
            <Setter Property="SelectionBrush" Value="#4000D4FF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#00D4FF"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#00D4FF" BlurRadius="8" ShadowDepth="0" Opacity="0.4"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FluentComboBox" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignComboBox}">
            <Setter Property="Background" Value="#0A1625"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#1E354D"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="12,7"/>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#00D4FF"/>
            <Setter Property="Foreground" Value="#030911"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#33E8FF"/>
                                <Setter TargetName="bg" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#00D4FF" BlurRadius="18" ShadowDepth="0" Opacity="0.5"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#00B5D8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#1E354D"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#0D1F30"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#00D4FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FinishBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>

    <!-- Outer Frame Container with Rich Deep Ambient Shadow -->
    <Grid>
        <Border Margin="14" CornerRadius="20" Background="#FF020810">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="55" ShadowDepth="4" Opacity="0.95"/>
            </Border.Effect>
        </Border>

        <!-- Main Content Area with Cosmic Space Aesthetic -->
        <Border Margin="14" CornerRadius="20" ClipToBounds="True" Background="#FF030914" BorderBrush="#1E3248" BorderThickness="1">
            <Grid>
                <!-- Space Background Image (Identical to Login) -->
                <Image Source="pack://application:,,,/Assets/Images/wizard_large.jpeg" Stretch="UniformToFill" Opacity="0.25"/>

                <!-- Deep Dark Solid/Cosmic Tint Overlay (eliminates text clash from underlying image) -->
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF030812" Offset="0"/>
                            <GradientStop Color="#FF040C18" Offset="0.45"/>
                            <GradientStop Color="#FF040E1B" Offset="0.8"/>
                            <GradientStop Color="#FF040E1B" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>   <!-- Top System Bar -->
                        <RowDefinition Height="*"/>    <!-- Core Content Body -->
                        <RowDefinition Height="70"/>   <!-- Glass Navigation Bar -->
                    </Grid.RowDefinitions>

                    <!-- Top Bar with App Badge and Window Controls (Drag handle) -->
                    <Grid Grid.Row="0" FlowDirection="LeftToRight" Background="#60000000" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0,0,0">
                            <Border Background="#00D4FF" CornerRadius="6" Width="8" Height="8" Margin="0,0,8,0">
                                <Border.Effect>
                                    <DropShadowEffect Color="#00D4FF" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                                </Border.Effect>
                            </Border>
                            <TextBlock Text="RoboVAI PRO POS  •  معالج التثبيت والتهيئة الذكية" Foreground="#64748B" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Close Button -->
                        <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0" Click="Close_Click" Width="32" Height="32" Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" CornerRadius="8" Background="Transparent" Width="32" Height="32">
                                        <TextBlock Text="✕" Foreground="#64748B" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="#55FF3333"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- Core 2-Column Split View: Left Branding Hero & Right Glass Card Form -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320"/>  <!-- Left Hero Panel -->
                            <ColumnDefinition Width="1"/>    <!-- Subtle Divider -->
                            <ColumnDefinition Width="*"/>    <!-- Interactive Steps Area -->
                        </Grid.ColumnDefinitions>

                        <!-- Left Hero Column: Official Identity & Dynamic Steps Pipeline -->
                        <Grid Grid.Column="0" Margin="30,8,20,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Identity Header with Logo & Brand Text -->
                            <StackPanel Grid.Row="0" Margin="0,4,0,18">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Image Source="pack://application:,,,/Assets/logo.png" Width="52" Height="52" Stretch="Uniform" VerticalAlignment="Bottom" Margin="0,0,12,2">
                                        <Image.Effect>
                                            <DropShadowEffect Color="#00D4FF" BlurRadius="22" ShadowDepth="0" Opacity="0.75"/>
                                        </Image.Effect>
                                    </Image>
                                    <StackPanel VerticalAlignment="Bottom">
                                        <TextBlock Text="RoboVAI" Foreground="#00D4FF" FontSize="11" FontWeight="Bold" Margin="0,0,0,1"/>
                                        <TextBlock Foreground="White" FontSize="26" FontWeight="Black" LineHeight="28">
                                            <Run Text="تهيئة المنظومة"/>
                                        </TextBlock>
                                        <TextBlock Text="الذكية المتكاملة" Foreground="#00D4FF" FontSize="26" FontWeight="Black" LineHeight="30">
                                            <TextBlock.Effect>
                                                <DropShadowEffect Color="#00D4FF" BlurRadius="16" ShadowDepth="0" Opacity="0.8"/>
                                            </TextBlock.Effect>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Text="إعداد متجرك وهيكلة الفروع والضرائب والطباعة في خطوات احترافية معدودة." Foreground="#8EA5BE" FontSize="12" TextWrapping="Wrap" LineHeight="18"/>
                            </StackPanel>

                            <!-- Stepper Timeline List -->
                            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,6">
                                <!-- Step 1 Badge Item -->
                                <Border x:Name="Step1Badge" CornerRadius="10" Padding="12,8" Margin="0,0,0,8" Background="#0E2C44" BorderBrush="#00D4FF" BorderThickness="1.5" Cursor="Hand" Tag="1" MouseLeftButtonDown="StepBadge_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🌍" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="Step1Text" Text="1. السوق والدولة والعملة" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12.5"/>
                                            <TextBlock Text="العملة الرسمية، الضرائب والقوانين" Foreground="#7E99B5" FontSize="10"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Step 2 Badge Item -->
                                <Border x:Name="Step2Badge" CornerRadius="10" Padding="12,8" Margin="0,0,0,8" Background="#081422" BorderBrush="#1A2C40" BorderThickness="1" Cursor="Hand" Tag="2" MouseLeftButtonDown="StepBadge_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🏢" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="Step2Text" Text="2. هوية المتجر والشعار" Foreground="#94A3B8" FontWeight="Bold" FontSize="12.5"/>
                                            <TextBlock Text="اسم المؤسسة والشعار ورأس الفاتورة" Foreground="#5E7791" FontSize="10"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Step 3 Badge Item -->
                                <Border x:Name="Step3Badge" CornerRadius="10" Padding="12,8" Margin="0,0,0,8" Background="#081422" BorderBrush="#1A2C40" BorderThickness="1" Cursor="Hand" Tag="3" MouseLeftButtonDown="StepBadge_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🌐" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="Step3Text" Text="3. الفروع والربط والمزامنة" Foreground="#94A3B8" FontWeight="Bold" FontSize="12.5"/>
                                            <TextBlock Text="سيرفر مركزي، كاشير فرعي، جسر WMS" Foreground="#5E7791" FontSize="10"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Step 4 Badge Item -->
                                <Border x:Name="Step4Badge" CornerRadius="10" Padding="12,8" Margin="0,0,0,8" Background="#081422" BorderBrush="#1A2C40" BorderThickness="1" Cursor="Hand" Tag="4" MouseLeftButtonDown="StepBadge_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="💳" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="Step4Text" Text="4. طرق الدفع والتحصيل" Foreground="#94A3B8" FontWeight="Bold" FontSize="12.5"/>
                                            <TextBlock Text="كاش، مدى، انستاباي، Apple Pay، تقسيط" Foreground="#5E7791" FontSize="10"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Step 5 Badge Item -->
                                <Border x:Name="Step5Badge" CornerRadius="10" Padding="12,8" Background="#081422" BorderBrush="#1A2C40" BorderThickness="1" Cursor="Hand" Tag="5" MouseLeftButtonDown="StepBadge_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🖨️" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="Step5Text" Text="5. الأجهزة واختبار الطباعة" Foreground="#94A3B8" FontWeight="Bold" FontSize="12.5"/>
                                            <TextBlock Text="طابعة الفواتير الحرارية والجاهزية" Foreground="#5E7791" FontSize="10"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,4">
                                <materialDesign:PackIcon Kind="ShieldCheckOutline" Width="15" Height="15" Foreground="#00D4FF" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="بياناتك مشفرة ومحمية محلياً 100%" Foreground="#475569" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Vertical Glass Divider Line -->
                        <Border Grid.Column="1" Background="#1E354D" Margin="0,16"/>

                        <!-- Right Column: Glassmorphism Action Card Container -->
                        <Border Grid.Column="2"
                                Background="#E8050F1C"
                                CornerRadius="16"
                                BorderBrush="#1E354D"
                                BorderThickness="1.5"
                                Margin="20,10,24,10"
                                Padding="24,20">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="0" Opacity="0.6"/>
                            </Border.Effect>

                            <Grid>
                                <!-- STEP 1: Country & Business Sector -->
                                <Grid x:Name="Step1Panel" Visibility="Visible">
                                    <StackPanel>
                                        <TextBlock Text="🌍 اختر الدولة والسوق التجاري ونوع النشاط:" FontSize="16" FontWeight="Bold" Margin="0,0,0,3" Foreground="#F1F5F9"/>
                                        <TextBlock Text="سيقوم النظام تلقائياً بتهيئة العملة الرسمية ونسبة الضريبة والقوانين وطرق الدفع المناسبة لدولتك." FontSize="12.5" Foreground="#8EA5BE" Margin="0,0,0,12"/>

                                        <!-- Country Selection Grid (Fluent Cards) -->
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="270" Margin="0,0,0,10">
                                            <UniformGrid Columns="2" Rows="4">
                                                <RadioButton x:Name="RbSaudi" Style="{StaticResource MaterialDesignTabRadioButton}" Margin="3" Checked="Country_Checked" Tag="SA" IsChecked="True">
                                                    <Border Background="#0B1B2B" BorderBrush="#1E354D" BorderThickness="1.5" CornerRadius="9" Padding="10,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="🇸🇦" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="المملكة العربية السعودية" FontWeight="Bold" FontSize="13" Foreground="#F1F5F9"/>
                                                                <TextBlock Text="العملة: ر.س • ضريبة: 15% • مدى، STC Pay، Apple Pay" FontSize="10.5" Foreground="#7E99B5" Margin="0,1,0,0"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </RadioButton>
                                                <RadioButton x:Name="RbEgypt" Style="{StaticResource MaterialDesignTabRadioButton}" Margin="3" Checked="Country_Checked" Tag="EG">
                                                    <Border Background="#0B1B2B" BorderBrush="#1E354D" BorderThickness="1.5" CornerRadius="9" Padding="10,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="🇪🇬" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="جمهورية مصر العربية" FontWeight="Bold" FontSize="13" Foreground="#F1F5F9"/>
                                                                <TextBlock Text="العملة: ج.م • ضريبة: 14% • انستاباي، فودافون كاش، ميزة" FontSize="10.5" Foreground="#7E99B5" Margin="0,1,0,0"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </RadioButton>
                                                <RadioButton x:Name="RbUAE" Style="{StaticResource MaterialDesignTabRadioButton}" Margin="3" Checked="Country_Checked" Tag="AE">
                                                    <Border Background="#0B1B2B" BorderBrush="#1E354D" BorderThickness="1.5" CornerRadius="9" Padding="10,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="🇦🇪" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="الإمارات العربية المتحدة" FontWeight="Bold" FontSize="13" Foreground="#F1F5F9"/>
                                                                <TextBlock Text="العملة: د.إ • ضريبة: 5% • Apple Pay، PayBy" FontSize="10.5" Foreground="#7E99B5" Margin="0,1,0,0"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </RadioButton>
                                                <RadioButton x:Name="RbKuwait" Style="{StaticResource MaterialDesignTabRadioButton}" Margin="3" Checked="Country_Checked" Tag="KW">
                                                    <Border Background="#0B1B2B" BorderBrush="#1E354D" BorderThickness="1.5" CornerRadius="9" Padding="10,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="🇰🇼" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="دولة الكويت" FontWeight="Bold" FontSize="13" Foreground="#F1F5F9"/>
                                                                <TextBlock Text="العملة: د.ك • كي نت KNET، Apple Pay" FontSize="10.5" Foreground="#7E99B5" Margin="0,1,0,0"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </RadioButton>
                                                <RadioButton x:Name="RbQatar" Style="{StaticResource MaterialDesignTabRadioButton}" Margin="3" Checked="Country_Checked" Tag="QA">
                                                    <Border Background="#0B1B2B" BorderBrush="#1E354D" BorderThickness="1.5" CornerRadius="9" Padding="10,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="🇶🇦" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="دولة قطر" FontWeight="Bold" FontSize="13" Foreground="#F1F5F9"/>
                                                                <TextBlock Text="العملة: ر.ق • نابس NAPS، QPay" FontSize="10.5" Foreground="#7E99B5" Margin="0,1,0,0"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </RadioButton>
                                                <RadioButton x:Name="RbBahrain" Style="{StaticResource MaterialDesignTabRadioButton}" Margin="3" Checked="Country_Checked" Tag="BH">
                                                    <Border Background="#0B1B2B" BorderBrush="#1E354D" BorderThickness="1.5" CornerRadius="9" Padding="10,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="🇧🇭" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="مملكة البحرين" FontWeight="Bold" FontSize="13" Foreground="#F1F5F9"/>
                                                                <TextBlock Text="العملة: د.ب • ضريبة: 10% • BenefitPay" FontSize="10.5" Foreground="#7E99B5" Margin="0,1,0,0"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </RadioButton>
                                                <RadioButton x:Name="RbOman" Style="{StaticResource MaterialDesignTabRadioButton}" Margin="3" Checked="Country_Checked" Tag="OM">
                                                    <Border Background="#0B1B2B" BorderBrush="#1E354D" BorderThickness="1.5" CornerRadius="9" Padding="10,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="🇴🇲" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="سلطنة عُمان" FontWeight="Bold" FontSize="13" Foreground="#F1F5F9"/>
                                                                <TextBlock Text="العملة: ر.ع • ضريبة: 5% • عمان نت، ثواني" FontSize="10.5" Foreground="#7E99B5" Margin="0,1,0,0"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </RadioButton>
                                                <RadioButton x:Name="RbOther" Style="{StaticResource MaterialDesignTabRadioButton}" Margin="3" Checked="Country_Checked" Tag="OTHER">
                                                    <Border Background="#0B1B2B" BorderBrush="#1E354D" BorderThickness="1.5" CornerRadius="9" Padding="10,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="🌐" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="سوق عام / دول أخرى" FontWeight="Bold" FontSize="13" Foreground="#F1F5F9"/>
                                                                <TextBlock Text="العملة: $ • تخصيص يدوي حر" FontSize="10.5" Foreground="#7E99B5" Margin="0,1,0,0"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </RadioButton>
                                            </UniformGrid>
                                        </ScrollViewer>

                        <!-- Sector Selection & Currency Inputs (Fluent Style) -->
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                <TextBlock Text="نوع النشاط التجاري:" Style="{StaticResource FluentInputLabel}"/>
                                <ComboBox x:Name="CmbBusinessSector" Style="{StaticResource FluentComboBox}" Height="40" SelectedIndex="0">
                                    <ComboBoxItem Content="🛒 سوبرماركت وبقالة ومواد غذائية"/>
                                    <ComboBoxItem Content="👔 ملابس وأحذية ومتاجر تجزئة"/>
                                    <ComboBoxItem Content="☕ كافيه ومطعم ومخبوزات"/>
                                    <ComboBoxItem Content="💊 صيدلية ومستحضرات تجميل"/>
                                    <ComboBoxItem Content="📱 هواتف وإلكترونيات وكمبيوتر"/>
                                    <ComboBoxItem Content="🎮 بلايستيشن وألعاب وخدمات تأجير"/>
                                    <ComboBoxItem Content="🏢 نشاط تجاري عام / أخرى"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                <TextBlock Text="رمز العملة (مثال: ر.س أو ج.م):" Style="{StaticResource FluentInputLabel}"/>
                                <TextBox x:Name="TxtCurrencySymbol" Text="ر.س" FontWeight="Bold" Style="{StaticResource FluentTextBox}" Height="40"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="اسم العملة الكامل:" Style="{StaticResource FluentInputLabel}"/>
                                <TextBox x:Name="TxtCurrencyName" Text="ريال سعودي" Style="{StaticResource FluentTextBox}" Height="40"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- STEP 2: Store Information & Logo -->
                <Grid x:Name="Step2Panel" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="🏢 بيانات المتجر والشعار الرسمي للفواتير:" FontSize="17" FontWeight="Bold" Margin="0,0,0,4" Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}"/>
                        <TextBlock Text="ستظهر هذه البيانات على الفواتير المطبوعة ورؤوس التقارير وشاشات العملاء." FontSize="13" Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}" Margin="0,0,0,18"/>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                <TextBlock Text="اسم المتجر / الشركة *" Style="{StaticResource FluentInputLabel}"/>
                                <TextBox x:Name="TxtStoreName" Text="متجر الأتمتة الذكي" FontWeight="Bold" Style="{StaticResource FluentTextBox}" Height="40"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="رقم الهاتف للتواصل:" Style="{StaticResource FluentInputLabel}"/>
                                <TextBox x:Name="TxtStorePhone" Text="0500000000" Style="{StaticResource FluentTextBox}" Height="40"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                <TextBlock Text="الرقم الضريبي (اختياري):" Style="{StaticResource FluentInputLabel}"/>
                                <TextBox x:Name="TxtStoreTaxNumber" Text="" Style="{StaticResource FluentTextBox}" Height="40"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="نسبة الضريبة القيمة المضافة %:" Style="{StaticResource FluentInputLabel}"/>
                                <TextBox x:Name="TxtTaxPercentage" Text="15" Style="{StaticResource FluentTextBox}" Height="40"/>
                            </StackPanel>
                        </Grid>

                        <!-- Store Logo Picker -->
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="شعار الفاتورة الحرارية (Logo):" Style="{StaticResource FluentInputLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtStoreLogoPath" Style="{StaticResource FluentTextBox}" Height="40" Margin="0,0,10,0"/>
                                <Button Grid.Column="1" Content="🖼️ رفع الشعار" Click="SelectLogo_Click" Style="{StaticResource MaterialDesignOutlinedButton}" Height="40"/>
                            </Grid>
                        </StackPanel>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                <TextBlock Text="العنوان والمدينة:" Style="{StaticResource FluentInputLabel}"/>
                                <TextBox x:Name="TxtStoreAddress" Text="الفرع الرئيسي" Style="{StaticResource FluentTextBox}" Height="40"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="رسالة تذييل الفاتورة (Footer):" Style="{StaticResource FluentInputLabel}"/>
                                <TextBox x:Name="TxtFooterMessage" Text="شكراً لزيارتكم - نتمنى لكم يوماً سعيداً" Style="{StaticResource FluentTextBox}" Height="40"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- STEP 3: Multi-Branch & Synchronization Architecture -->
                <Grid x:Name="Step3Panel" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="🌐 إدارة الفروع وهيكلة الربط والمزامنة (Multi-Branch &amp; Sync):" FontSize="17" FontWeight="Bold" Margin="0,0,0,4" Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}"/>
                        <TextBlock Text="حدد دور هذا الجهاز في المنظومة (رئيسي / فرعي) وكيفية دمج ومزامنة الفروع الأخرى." FontSize="13" Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}" Margin="0,0,0,16"/>

                        <!-- Branch Role Cards -->
                        <UniformGrid Columns="3" Margin="0,0,0,16">
                            <RadioButton x:Name="RbRoleCentral" Style="{StaticResource MaterialDesignTabRadioButton}" Margin="4" IsChecked="True">
                                <Border Background="{DynamicResource AlAtmani.SurfaceBrush}" BorderBrush="{DynamicResource AlAtmani.BorderBrush}" BorderThickness="1.5" CornerRadius="12" Padding="14">
                                    <StackPanel>
                                        <materialDesign:PackIcon Kind="ServerNetwork" Width="30" Height="30" Foreground="#38BDF8" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                                        <TextBlock Text="السيرفر المركزي / الفرع الرئيسي" FontWeight="Bold" FontSize="13" TextAlignment="Center" Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}"/>
                                        <TextBlock Text="يستضيف قاعدة البيانات المركزية ويشغل سيرفر الربط (Port 7890) لمزامنة باقي الفروع والكاشيرات." FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </RadioButton>
                            <RadioButton x:Name="RbRoleSub" Style="{StaticResource MaterialDesignTabRadioButton}" Margin="4">
                                <Border Background="{DynamicResource AlAtmani.SurfaceBrush}" BorderBrush="{DynamicResource AlAtmani.BorderBrush}" BorderThickness="1.5" CornerRadius="12" Padding="14">
                                    <StackPanel>
                                        <materialDesign:PackIcon Kind="CashRegister" Width="30" Height="30" Foreground="#10B981" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                                        <TextBlock Text="كاشير فرعي / محطة تابعة" FontWeight="Bold" FontSize="13" TextAlignment="Center" Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}"/>
                                        <TextBlock Text="يرتبط بالسيرفر الرئيسي عبر الشبكة المحلية (LAN) أو الـ WMS QR لمزامنة المبيعات والمخزون." FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </RadioButton>
                            <RadioButton x:Name="RbRoleStandalone" Style="{StaticResource MaterialDesignTabRadioButton}" Margin="4">
                                <Border Background="{DynamicResource AlAtmani.SurfaceBrush}" BorderBrush="{DynamicResource AlAtmani.BorderBrush}" BorderThickness="1.5" CornerRadius="12" Padding="14">
                                    <StackPanel>
                                        <materialDesign:PackIcon Kind="Store" Width="30" Height="30" Foreground="#F59E0B" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                                        <TextBlock Text="متجر مستقل (فرع واحد)" FontWeight="Bold" FontSize="13" TextAlignment="Center" Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}"/>
                                        <TextBlock Text="يعمل بشكل مستقل تماماً مع النسخ الاحتياطي التلقائي وجسر WMS للهاتف." FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </RadioButton>
                        </UniformGrid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                <TextBlock Text="اسم هذا الفرع *" Style="{StaticResource FluentInputLabel}"/>
                                <TextBox x:Name="TxtBranchName" Text="الفرع الرئيسي" FontWeight="Bold" Style="{StaticResource FluentTextBox}" Height="40"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                <TextBlock Text="كود الفرع:" Style="{StaticResource FluentInputLabel}"/>
                                <TextBox x:Name="TxtBranchCode" Text="BR-01" Style="{StaticResource FluentTextBox}" Height="40"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="إجمالي الفروع المتوقعة:" Style="{StaticResource FluentInputLabel}"/>
                                <ComboBox x:Name="CmbBranchCount" Style="{StaticResource FluentComboBox}" Height="40" SelectedIndex="0">
                                    <ComboBoxItem Content="فرع واحد (Single Store)"/>
                                    <ComboBoxItem Content="فرعين إلى 5 فروع"/>
                                    <ComboBoxItem Content="6 إلى 15 فرع"/>
                                    <ComboBoxItem Content="سلسلة فروع كبرى (15+ فرع)"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Border Background="{DynamicResource AlAtmani.Surface2Brush}" CornerRadius="12" Padding="14" BorderBrush="{DynamicResource AlAtmani.BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="قنوات المزامنة والدمج النشطة:" FontWeight="Bold" FontSize="13" Margin="0,0,0,8" Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}"/>
                                <WrapPanel Orientation="Horizontal">
                                    <CheckBox x:Name="ChkEnableLanSync" Content="🔗 تفعيل سيرفر الربط المحلي LAN (Port 7890)" IsChecked="True" FontSize="12" Margin="6,3"/>
                                    <CheckBox x:Name="ChkEnableWmsBridge" Content="📱 تفعيل جسر تطبيق WMS للهواتف والجرد" IsChecked="True" FontSize="12" Margin="6,3"/>
                                    <CheckBox x:Name="ChkEnableDailyBackup" Content="💾 تفعيل النسخ الاحتياطي اليومي" IsChecked="True" FontSize="12" Margin="6,3"/>
                                    <CheckBox x:Name="ChkEnableSampleData" Content="📦 إضافة أصناف تجريبية" IsChecked="False" FontSize="12" Margin="6,3"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- STEP 4: Payment Methods Configuration -->
                <Grid x:Name="Step4Panel" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="💳 اختر طرق الدفع التي تريد إظهارها في الكاشير:" FontSize="17" FontWeight="Bold" Margin="0,0,0,4" Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}"/>
                        <TextBlock Text="يمكنك تفعيل أو إلغاء أي طريقة دفع بنقرة واحدة." FontSize="13" Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}" Margin="0,0,0,16"/>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="340">
                            <WrapPanel Orientation="Horizontal">
                                <!-- Global / Basic -->
                                <Border Background="{DynamicResource AlAtmani.Surface2Brush}" CornerRadius="10" Padding="10,6" Margin="4">
                                    <CheckBox x:Name="ChkCash" Content="💵 كاش (Cash)" IsChecked="True" FontSize="13" FontWeight="Bold"/>
                                </Border>
                                <Border Background="{DynamicResource AlAtmani.Surface2Brush}" CornerRadius="10" Padding="10,6" Margin="4">
                                    <CheckBox x:Name="ChkCard" Content="💳 بطاقة / فيزا / ماستر (Card)" IsChecked="True" FontSize="13" FontWeight="Bold"/>
                                </Border>
                                <Border Background="{DynamicResource AlAtmani.Surface2Brush}" CornerRadius="10" Padding="10,6" Margin="4">
                                    <CheckBox x:Name="ChkDeferred" Content="⏳ آجل (حساب العميل)" IsChecked="True" FontSize="13" FontWeight="Bold"/>
                                </Border>
                                <Border Background="{DynamicResource AlAtmani.Surface2Brush}" CornerRadius="10" Padding="10,6" Margin="4">
                                    <CheckBox x:Name="ChkApplePay" Content="🍎 Apple Pay" IsChecked="True" FontSize="13" FontWeight="Bold"/>
                                </Border>

                                <!-- Saudi Arabia -->
                                <Border Background="{DynamicResource AlAtmani.Surface2Brush}" CornerRadius="10" Padding="10,6" Margin="4">
                                    <CheckBox x:Name="ChkMada" Content="💳 مدى (Mada - السعودية)" IsChecked="True" FontSize="13" FontWeight="Bold"/>
                                </Border>
                                <Border Background="{DynamicResource AlAtmani.Surface2Brush}" CornerRadius="10" Padding="10,6" Margin="4">
                                    <CheckBox x:Name="ChkStcPay" Content="📱 STC Pay (السعودية)" IsChecked="True" FontSize="13" FontWeight="Bold"/>
                                </Border>
                                <Border Background="{DynamicResource AlAtmani.Surface2Brush}" CornerRadius="10" Padding="10,6" Margin="4">
                                    <CheckBox x:Name="ChkUrpay" Content="👛 Urpay (السعودية)" IsChecked="False" FontSize="13" FontWeight="Bold"/>
                                </Border>
                                <Border Background="{DynamicResource AlAtmani.Surface2Brush}" CornerRadius="10" Padding="10,6" Margin="4">
                                    <CheckBox x:Name="ChkAlRajhi" Content="🏦 تحويل الراجحي" IsChecked="False" FontSize="13" FontWeight="Bold"/>
                                </Border>
                                <Border Background="{DynamicResource AlAtmani.Surface2Brush}" CornerRadius="10" Padding="10,6" Margin="4">
                                    <CheckBox x:Name="ChkTamara" Content="🛍️ تمارا (تقسيط)" IsChecked="False" FontSize="13" FontWeight="Bold"/>
                                </Border>
                                <Border Background="{DynamicResource AlAtmani.Surface2Brush}" CornerRadius="10" Padding="10,6" Margin="4">
                                    <CheckBox x:Name="ChkTabby" Content="🛍️ تابي (تقسيط)" IsChecked="False" FontSize="13" FontWeight="Bold"/>
                                </Border>

                                <!-- UAE -->
                                <Border Background="{DynamicResource AlAtmani.Surface2Brush}" CornerRadius="10" Padding="10,6" Margin="4">
                                    <CheckBox x:Name="ChkSamsungPay" Content="📱 Samsung Pay" IsChecked="False" FontSize="13" FontWeight="Bold"/>
                                </Border>
                                <Border Background="{DynamicResource AlAtmani.Surface2Brush}" CornerRadius="10" Padding="10,6" Margin="4">
                                    <CheckBox x:Name="ChkPayBy" Content="💳 PayBy (الإمارات)" IsChecked="False" FontSize="13" FontWeight="Bold"/>
                                </Border>

                                <!-- Kuwait -->
                                <Border Background="{DynamicResource AlAtmani.Surface2Brush}" CornerRadius="10" Padding="10,6" Margin="4">
                                    <CheckBox x:Name="ChkKnet" Content="💳 كي نت (KNET - الكويت)" IsChecked="False" FontSize="13" FontWeight="Bold"/>
                                </Border>
                                <Border Background="{DynamicResource AlAtmani.Surface2Brush}" CornerRadius="10" Padding="10,6" Margin="4">
                                    <CheckBox x:Name="ChkBoubyan" Content="📱 Boubyan Pay (الكويت)" IsChecked="False" FontSize="13" FontWeight="Bold"/>
                                </Border>

                                <!-- Qatar, Bahrain, Oman -->
                                <Border Background="{DynamicResource AlAtmani.Surface2Brush}" CornerRadius="10" Padding="10,6" Margin="4">
                                    <CheckBox x:Name="ChkNaps" Content="💳 نابس (NAPS - قطر)" IsChecked="False" FontSize="13" FontWeight="Bold"/>
                                </Border>
                                <Border Background="{DynamicResource AlAtmani.Surface2Brush}" CornerRadius="10" Padding="10,6" Margin="4">
                                    <CheckBox x:Name="ChkBenefitPay" Content="📱 BenefitPay (البحرين)" IsChecked="False" FontSize="13" FontWeight="Bold"/>
                                </Border>
                                <Border Background="{DynamicResource AlAtmani.Surface2Brush}" CornerRadius="10" Padding="10,6" Margin="4">
                                    <CheckBox x:Name="ChkOmanNet" Content="💳 عمان نت (OmanNet)" IsChecked="False" FontSize="13" FontWeight="Bold"/>
                                </Border>
                                <Border Background="{DynamicResource AlAtmani.Surface2Brush}" CornerRadius="10" Padding="10,6" Margin="4">
                                    <CheckBox x:Name="ChkThawani" Content="📱 ثواني (Thawani - عمان)" IsChecked="False" FontSize="13" FontWeight="Bold"/>
                                </Border>

                                <!-- Egypt -->
                                <Border Background="{DynamicResource AlAtmani.Surface2Brush}" CornerRadius="10" Padding="10,6" Margin="4">
                                    <CheckBox x:Name="ChkInstaPay" Content="⚡ انستا باي (InstaPay - مصر)" IsChecked="False" FontSize="13" FontWeight="Bold"/>
                                </Border>
                                <Border Background="{DynamicResource AlAtmani.Surface2Brush}" CornerRadius="10" Padding="10,6" Margin="4">
                                    <CheckBox x:Name="ChkVodafone" Content="🔴 فودافون كاش (Vodafone Cash)" IsChecked="False" FontSize="13" FontWeight="Bold"/>
                                </Border>
                                <Border Background="{DynamicResource AlAtmani.Surface2Brush}" CornerRadius="10" Padding="10,6" Margin="4">
                                    <CheckBox x:Name="ChkMeeza" Content="💳 ميزة (Meeza - مصر)" IsChecked="False" FontSize="13" FontWeight="Bold"/>
                                </Border>
                                <Border Background="{DynamicResource AlAtmani.Surface2Brush}" CornerRadius="10" Padding="10,6" Margin="4">
                                    <CheckBox x:Name="ChkBankTransfer" Content="🏦 تحويل بنكي عام" IsChecked="False" FontSize="13" FontWeight="Bold"/>
                                </Border>
                            </WrapPanel>
                        </ScrollViewer>
                    </StackPanel>
                </Grid>

                <!-- STEP 5: Hardware & Printers & Test -->
                <Grid x:Name="Step5Panel" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="🖨️ إعدادات الطابعات وقارئ الباركود والجاهزية:" FontSize="17" FontWeight="Bold" Margin="0,0,0,4" Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}"/>
                        <TextBlock Text="اختر طابعة الفواتير ومقاس الورق، ويمكنك عمل تجربة طباعة فورية." FontSize="13" Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}" Margin="0,0,0,16"/>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                <TextBlock Text="طابعة الفواتير الحرارية:" Style="{StaticResource FluentInputLabel}"/>
                                <ComboBox x:Name="CmbPrinters" Style="{StaticResource FluentComboBox}" Height="40"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                <TextBlock Text="عرض الورق الحراري:" Style="{StaticResource FluentInputLabel}"/>
                                <ComboBox x:Name="CmbPaperWidth" Style="{StaticResource FluentComboBox}" Height="40" SelectedIndex="0">
                                    <ComboBoxItem Content="80 مم (80mm)"/>
                                    <ComboBoxItem Content="58 مم (58mm)"/>
                                </ComboBox>
                            </StackPanel>

                            <Button Grid.Column="2" Content="🖨️ تجربة طباعة" Click="TestPrint_Click" Style="{StaticResource MaterialDesignOutlinedButton}" Height="40" VerticalAlignment="Bottom"/>
                        </Grid>

                        <Border Background="#071A12" CornerRadius="14" Padding="20" Margin="0,12,0,0" BorderBrush="#10B981" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect Color="#10B981" BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
                            </Border.Effect>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <materialDesign:PackIcon Kind="CheckCircle" Width="28" Height="28" Foreground="#10B981" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="🎉 اكتملت كافة إعدادات التهيئة بنجاح!" FontWeight="Bold" FontSize="16" Foreground="#10B981" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="تم ضبط كافة الإعدادات الأساسية للنظام. يمكنك الآن النقر على 'بدء استخدام النظام' للتوجه مباشرة لشاشة الكاشير والبدء في البيع." FontSize="13" TextWrapping="Wrap" Foreground="#7E99B5" LineHeight="20"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>

    <!-- Bottom Navigation Glass Bar -->
    <Border Grid.Row="2" Background="#DD030911" Padding="36,14" BorderBrush="#1E3248" BorderThickness="0,1,0,0">
        <Grid>
            <Button x:Name="BtnPrev" Content="السابق ←" Click="Prev_Click" Style="{StaticResource SecondaryBtn}" Width="120" Height="44" HorizontalAlignment="Left" Visibility="Collapsed"/>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnNext" Content="التالي ⬅" Click="Next_Click" Style="{StaticResource PrimaryBtn}" Width="140" Height="44"/>
                <Button x:Name="BtnFinish" Content="🚀 بدء استخدام النظام" Click="Finish_Click" Style="{StaticResource FinishBtn}" Width="220" Height="44" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>
    </Border>
</Grid>
</Grid>
</Border>
</Grid>
</Window>

<Page x:Class="SmartPOS.WPF.Views.CategoriesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="Categories"
      FontFamily="Segoe UI, Tahoma"
      FlowDirection="RightToLeft">

    <Grid Background="{DynamicResource AlAtmani.BackgroundBrush}"
          Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource AlAtmani.AcrylicBrush}"
                BorderBrush="{DynamicResource AlAtmani.AcrylicBorderBrush}"
                BorderThickness="1"
                CornerRadius="24"
                Padding="16"
                Margin="0,0,0,24"
                Effect="{StaticResource MaterialDesignShadowDepth1}">
            <DockPanel>
                <Border Background="#E8EAF6"
                        CornerRadius="12"
                        Padding="12"
                        DockPanel.Dock="Right"
                        Margin="0,0,16,0">
                    <materialDesign:PackIcon Kind="Shape"
                                             Width="36"
                                             Height="36"
                                             Foreground="#3F51B5"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="إدارة الأقسام"
                               FontSize="24"
                               FontWeight="Bold"
                               Margin="0"/>
                    <TextBlock Text="تصنيف المنتجات وترتيب القائمة"
                               FontSize="13"
                               Foreground="#3F51B5"
                               Opacity="0.8"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Command="{Binding LoadCategoriesCommand}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="تحديث البيانات"
                            Margin="0,0,16,0"
                            Foreground="#3F51B5">
                        <materialDesign:PackIcon Kind="Refresh" Width="24" Height="24"/>
                    </Button>
                    <Button Command="{Binding ShowAddFormCommand}"
                            Content="إضافة قسم جديد"
                            Style="{StaticResource AlAtmani.SoftButton}"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Edit Form -->
        <Border Grid.Row="1"
                Background="{DynamicResource AlAtmani.AcrylicBrush}"
                BorderBrush="{DynamicResource AlAtmani.AcrylicBorderBrush}"
                BorderThickness="1"
                CornerRadius="24"
                Padding="24"
                Margin="0,0,0,24"
                Effect="{StaticResource MaterialDesignShadowDepth1}"
                Visibility="{Binding IsFormVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="بيانات القسم"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,16"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBox Grid.Row="0"
                             Grid.Column="0"
                             materialDesign:HintAssist.Hint="اسم القسم (مطلوب)"
                             Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0,0,8,16"/>

                    <ComboBox Grid.Row="0"
                              Grid.Column="1"
                              materialDesign:HintAssist.Hint="لون القسم"
                              SelectedValue="{Binding FormColorCode, UpdateSourceTrigger=PropertyChanged}"
                              SelectedValuePath="Tag"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              Margin="8,0,0,16">
                        <ComboBoxItem Tag="#3F51B5" Content="أزرق (افتراضي)"/>
                        <ComboBoxItem Tag="#E91E63" Content="وردي"/>
                        <ComboBoxItem Tag="#4CAF50" Content="أخضر"/>
                        <ComboBoxItem Tag="#FF9800" Content="برتقالي"/>
                        <ComboBoxItem Tag="#9C27B0" Content="بنفسجي"/>
                        <ComboBoxItem Tag="#F44336" Content="أحمر"/>
                        <ComboBoxItem Tag="#00BCD4" Content="سماوي"/>
                        <ComboBoxItem Tag="#795548" Content="بني"/>
                        <ComboBoxItem Tag="#607D8B" Content="رمادي مزرق"/>
                    </ComboBox>

                    <TextBox Grid.Row="1"
                             Grid.Column="0"
                             materialDesign:HintAssist.Hint="الوصف"
                             Text="{Binding FormDescription, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Height="80"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,0,8,16"/>

                    <CheckBox Grid.Row="1"
                              Grid.Column="1"
                              IsChecked="{Binding FormIsActive}"
                              Content="القسم نشط"
                              Style="{StaticResource MaterialDesignFilterChipPrimaryOutlineCheckBox}"
                              VerticalAlignment="Top"
                              Margin="8,0,0,16" Height="48"/>
                </Grid>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            Margin="0,8,0,0">
                    <Button Content="حفظ"
                            Command="{Binding SaveCategoryCommand}"
                            Style="{StaticResource AlAtmani.SoftButton}"
                            Width="120"
                            Margin="0,0,16,0"/>
                    <Button Content="إلغاء"
                            Command="{Binding CancelFormCommand}"
                            Style="{StaticResource AlAtmani.SoftButton}"
                            Width="100"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Data Grid -->
        <Border Grid.Row="2"
                Background="{DynamicResource AlAtmani.AcrylicBrush}"
                BorderBrush="{DynamicResource AlAtmani.AcrylicBorderBrush}"
                BorderThickness="1"
                CornerRadius="24"
                Padding="0"
                ClipToBounds="True"
                Effect="{StaticResource MaterialDesignShadowDepth1}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Search Bar -->
                <Grid Grid.Row="0"
                      Margin="16">
                    <TextBox materialDesign:HintAssist.Hint="بحث عن قسم..."
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Padding="8"
                             materialDesign:TextFieldAssist.HasClearButton="True"/>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <DataGrid ItemsSource="{Binding Categories}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="All"
                              SelectionMode="Single"
                              IsReadOnly="True"
                              MinHeight="400"
                              materialDesign:DataGridAssist.CellPadding="16">
                        <DataGrid.Columns>
                            <!-- Color Indicator -->
                            <DataGridTemplateColumn Header="اللون"
                                                    Width="85">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="22"
                                                Height="22"
                                                CornerRadius="11"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="{Binding ColorCode}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="الاسم"
                                                Binding="{Binding Name}"
                                                Width="2*"
                                                ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>
                            <DataGridTextColumn Header="الوصف"
                                                Binding="{Binding Description}"
                                                Width="3*"
                                                ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>

                            <!-- Status Indicator -->
                            <DataGridTemplateColumn Header="الحالة" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="12"
                                                Padding="12,4"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#E8F5E9"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Background" Value="#FFEBEE"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontWeight="SemiBold" FontSize="12">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="نشط"/>
                                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                <Setter Property="Text" Value="مخفي"/>
                                                                <Setter Property="Foreground" Value="#C62828"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="إجراءات"
                                                    Width="140"
                                                    Visibility="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                                    ToolTip="تعديل"
                                                    Width="34" Height="34" Margin="2,0"
                                                    Command="{Binding DataContext.EditCategoryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="Pencil" Width="20" Height="20"
                                                                         Foreground="{DynamicResource AlAtmani.AccentBrush}"/>
                                            </Button>
                                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                                    ToolTip="حذف"
                                                    Width="34" Height="34" Margin="2,0"
                                                    Command="{Binding DataContext.DeleteCategoryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="Delete" Width="20" Height="20"
                                                                         Foreground="#FB7185"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>

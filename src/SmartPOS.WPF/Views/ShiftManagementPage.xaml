<Page x:Class="SmartPOS.WPF.Views.ShiftManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      FlowDirection="RightToLeft"
      Loaded="Page_Loaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Background="{DynamicResource AlAtmani.BackgroundBrush}"
              TextElement.Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}"
              Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

        <!-- Header -->
        <materialDesign:Card Grid.Row="0"
                             Style="{StaticResource AlAtmani.GlassCard}"
                             Margin="0,0,0,24"
                             Padding="24">
            <DockPanel>
                <Border DockPanel.Dock="Right" Background="{DynamicResource AlAtmani.Surface2Brush}"
                        CornerRadius="12"
                        Padding="12"
                        Margin="0,0,16,0"
                        VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="ClockOutline"
                                             Width="32"
                                             Height="32"
                                             Foreground="{DynamicResource AlAtmani.AccentBrush}"/>
                </Border>
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Loc_6b9077f1}"
                               Style="{StaticResource AlAtmani.HeaderText}"/>
                    <TextBlock Text="{DynamicResource Loc_31794d17}"
                               FontSize="14"
                               Opacity="0.85"
                               Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>
                
                <!-- Toolbar -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Command="{Binding LoadShiftsCommand}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="{DynamicResource Loc_fd4458ee}"
                            Foreground="{DynamicResource AlAtmani.AccentBrush}">
                        <materialDesign:PackIcon Kind="Refresh" Width="24" Height="24"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </materialDesign:Card>

        <!-- Current Shift Status -->
        <materialDesign:Card Grid.Row="1"
                             Style="{StaticResource AlAtmani.GlassCard}"
                             Margin="0,0,0,24"
                             Padding="24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Loc_3a2f23e7}"
                               Style="{StaticResource AlAtmani.SubHeaderText}"
                               Margin="0,0,0,16"/>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,5">
                        <materialDesign:PackIcon Kind="Account"
                                                 Width="20"
                                                 Height="20"
                                                 Foreground="{DynamicResource AlAtmani.AccentBrush}"
                                                 Margin="0,0,10,0"/>
                        <TextBlock Text="{DynamicResource Loc_CashierPrefix}"
                                   FontSize="16"
                                   Opacity="0.85"/>
                        <TextBlock Text="{Binding CurrentShift.User.FullName}"
                                   FontSize="16"
                                   Opacity="0.85"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,5">
                        <materialDesign:PackIcon Kind="Clock"
                                                 Width="20"
                                                 Height="20"
                                                 Foreground="{DynamicResource AlAtmani.AccentBrush}"
                                                 Margin="0,0,10,0"/>
                        <TextBlock Text="{DynamicResource Loc_StartTimePrefix}"
                                   FontSize="16"
                                   Opacity="0.85"/>
                        <TextBlock Text="{Binding CurrentShift.StartTime, StringFormat='{}{0:hh:mm tt}'}"
                                   FontSize="16"
                                   Opacity="0.85"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,5">
                        <materialDesign:PackIcon Kind="CashMultiple"
                                                 Width="20"
                                                 Height="20"
                                                 Foreground="{DynamicResource AlAtmani.AccentBrush}"
                                                 Margin="0,0,10,0"/>
                        <TextBlock Text="{DynamicResource Loc_OpeningBalancePrefix}"
                                   FontSize="16"
                                   Opacity="0.85"/>
                        <TextBlock Text="{Binding CurrentShift.OpeningBalance, StringFormat='{}{0:F2}'}"
                                   FontSize="16"
                                   Opacity="0.85"/>
                        <TextBlock Text=" " />
                        <TextBlock Text="{DynamicResource Loc_CurrencySymbol}"
                                   FontSize="13"
                                   Opacity="0.85"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,2"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,15,0,0">
                        <TextBox Width="150"
                                 Margin="0,0,10,0"
                                 Text="{Binding OpeningBalanceInput, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="{DynamicResource Loc_h_8ce4f39a}"/>
                        <TextBox Width="160"
                                 Margin="0,0,10,0"
                                 Text="{Binding ClosingBalanceInput, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="{DynamicResource Loc_h_2cbb9025}"/>
                        <TextBox Width="200"
                                 Text="{Binding NotesInput, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="{DynamicResource Loc_h_c81514f7}"/>
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Height="40"
                                Margin="10,0,0,0"
                                Content="{DynamicResource Loc_061401dc}"
                                Command="{Binding LoadShiftsCommand}"
                                ToolTip="{DynamicResource Loc_002a8399}"/>
                    </StackPanel>

                    <!-- Expected Balance: ONLY visible to Admin/SuperAdmin (Blind Z-Report) -->
                    <Border Margin="0,12,0,0" Padding="8" CornerRadius="8"
                            Background="#1AEF4444">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCashier}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ShieldLockOutline" Width="20" Height="20" Foreground="#EF4444" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Loc_ExpectedBalancePrefix}"
                                       FontSize="14" FontWeight="SemiBold" Foreground="#EF4444" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ExpectedBalance, StringFormat='{}{0:N2}'}"
                                       FontSize="14" FontWeight="SemiBold" Foreground="#EF4444" VerticalAlignment="Center"/>
                            <TextBlock Text=" " VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Loc_CurrencySymbol}"
                                       FontSize="12" FontWeight="SemiBold" Foreground="#EF4444" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource AlAtmani.SoftButton}"
                            Height="54"
                            Padding="24,0"
                            Content="{DynamicResource Loc_5a9212f6}"
                            Margin="0,0,0,10"
                            Command="{Binding OpenShiftCommand}"
                            IsEnabled="{Binding IsShiftOpen, Converter={StaticResource BoolNegationConverter}}"/>
                    <Button Style="{StaticResource AlAtmani.SoftButton}"
                            Height="54"
                            Padding="24,0"
                            Content="{DynamicResource Loc_f1708be7}"
                            Command="{Binding CloseShiftCommand}"
                            IsEnabled="{Binding IsShiftOpen}"/>
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <!-- Shift Statistics -->
        <Grid Grid.Row="2">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCashier}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Stat Card 1: Total Sales -->
            <materialDesign:Card Grid.Column="0"
                                 Grid.Row="0"
                                 Style="{StaticResource AlAtmani.GlassCard}"
                                 Margin="0,0,8,16"
                                 Padding="20">
                <StackPanel>
                    <Border Background="{DynamicResource AlAtmani.Surface2Brush}"
                            CornerRadius="12"
                            Padding="10"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,12">
                        <materialDesign:PackIcon Kind="CashRegister"
                                                 Width="32"
                                                 Height="32"
                                                 Foreground="{DynamicResource AlAtmani.AccentBrush}"/>
                    </Border>
                    <TextBlock Text="{DynamicResource Loc_b94c9b2f}"
                               FontSize="14"
                               Opacity="0.7"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding CurrentShiftTotalSales, StringFormat={}{0:N2}}"
                                   FontSize="24"
                                   FontWeight="Bold"/>
                        <TextBlock Text=" " />
                        <TextBlock Text="{DynamicResource Loc_CurrencySymbol}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Opacity="0.7"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,3"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>

            <!-- Stat Card 2: Transactions -->
            <materialDesign:Card Grid.Column="1"
                                 Grid.Row="0"
                                 Style="{StaticResource AlAtmani.GlassCard}"
                                 Margin="8,0,8,16"
                                 Padding="20">
                <StackPanel>
                    <Border Background="{DynamicResource AlAtmani.Surface2Brush}"
                            CornerRadius="12"
                            Padding="10"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,12">
                        <materialDesign:PackIcon Kind="Receipt"
                                                 Width="32"
                                                 Height="32"
                                                 Foreground="{DynamicResource AlAtmani.AccentBrush}"/>
                    </Border>
                    <TextBlock Text="{DynamicResource Loc_f47efd01}"
                               FontSize="14"
                               Opacity="0.7"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding CurrentShiftTransactions}"
                                   FontSize="24"
                                   FontWeight="Bold"/>
                        <TextBlock Text=" " />
                        <TextBlock Text="{DynamicResource Loc_TransactionsCountSuffix}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Opacity="0.7"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,3"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>

            <!-- Stat Card 3: Cash -->
            <materialDesign:Card Grid.Column="2"
                                 Grid.Row="0"
                                 Style="{StaticResource AlAtmani.GlassCard}"
                                 Margin="8,0,8,16"
                                 Padding="20">
                <StackPanel>
                    <Border Background="{DynamicResource AlAtmani.Surface2Brush}"
                            CornerRadius="12"
                            Padding="10"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,12">
                        <materialDesign:PackIcon Kind="Cash"
                                                 Width="32"
                                                 Height="32"
                                                 Foreground="{DynamicResource AlAtmani.AccentBrush}"/>
                    </Border>
                    <TextBlock Text="{DynamicResource Loc_ac869787}"
                               FontSize="14"
                               Opacity="0.7"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding CurrentShiftSales, StringFormat={}{0:N2}}"
                                   FontSize="24"
                                   FontWeight="Bold"/>
                        <TextBlock Text=" " />
                        <TextBlock Text="{DynamicResource Loc_CurrencySymbol}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Opacity="0.7"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,3"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>

            <!-- Stat Card 4: Cards -->
            <materialDesign:Card Grid.Column="3"
                                 Grid.Row="0"
                                 Style="{StaticResource AlAtmani.GlassCard}"
                                 Margin="8,0,0,16"
                                 Padding="20">
                <StackPanel>
                    <Border Background="{DynamicResource AlAtmani.Surface2Brush}"
                            CornerRadius="12"
                            Padding="10"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,12">
                        <materialDesign:PackIcon Kind="CreditCard"
                                                 Width="32"
                                                 Height="32"
                                                 Foreground="#C2185B"/>
                    </Border>
                    <TextBlock Text="{DynamicResource Loc_d3cdbd4f}"
                               FontSize="14"
                               Opacity="0.7"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding TotalCardSales, StringFormat={}{0:N2}}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#C2185B"/>
                        <TextBlock Text=" " />
                        <TextBlock Text="{DynamicResource Loc_CurrencySymbol}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#C2185B"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,3"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>

            <!-- Stat Card 5: Vodafone Cash -->
            <materialDesign:Card Grid.Column="0"
                                 Grid.Row="1"
                                 Style="{StaticResource AlAtmani.GlassCard}"
                                 Margin="0,0,8,16"
                                 Padding="20">
                <StackPanel>
                    <Border Background="{DynamicResource AlAtmani.Surface2Brush}"
                            CornerRadius="12"
                            Padding="10"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,12">
                        <materialDesign:PackIcon Kind="CellphoneNfc"
                                                 Width="32"
                                                 Height="32"
                                                 Foreground="#E60000"/>
                    </Border>
                    <TextBlock Text="{DynamicResource Loc_bcf9bd9c}"
                               FontSize="14"
                               Opacity="0.7"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding TotalVodafoneCashSales, StringFormat={}{0:N2}}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#E60000"/>
                        <TextBlock Text=" " />
                        <TextBlock Text="{DynamicResource Loc_CurrencySymbol}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#E60000"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,3"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>

            <!-- Stat Card 6: InstaPay -->
            <materialDesign:Card Grid.Column="1"
                                 Grid.Row="1"
                                 Style="{StaticResource AlAtmani.GlassCard}"
                                 Margin="8,0,8,16"
                                 Padding="20">
                <StackPanel>
                    <Border Background="{DynamicResource AlAtmani.Surface2Brush}"
                            CornerRadius="12"
                            Padding="10"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,12">
                        <materialDesign:PackIcon Kind="BankTransfer"
                                                 Width="32"
                                                 Height="32"
                                                 Foreground="#1877F2"/>
                    </Border>
                    <TextBlock Text="{DynamicResource Loc_280a6ce9}"
                               FontSize="14"
                               Opacity="0.7"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding TotalInstaPaySales, StringFormat={}{0:N2}}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#1877F2"/>
                        <TextBlock Text=" " />
                        <TextBlock Text="{DynamicResource Loc_CurrencySymbol}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#1877F2"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,3"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>

            <!-- Stat Card 7: Deferred Sales (الآجل) -->
            <materialDesign:Card Grid.Column="2"
                                 Grid.Row="1"
                                 Style="{StaticResource AlAtmani.GlassCard}"
                                 Margin="8,0,8,16"
                                 Padding="20">
                <StackPanel>
                    <Border Background="{DynamicResource AlAtmani.Surface2Brush}"
                            CornerRadius="12"
                            Padding="10"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,12">
                        <materialDesign:PackIcon Kind="BookAccountOutline"
                                                 Width="32"
                                                 Height="32"
                                                 Foreground="#D97706"/>
                    </Border>
                    <TextBlock Text="{DynamicResource Loc_f89f50ee}"
                               FontSize="14"
                               Opacity="0.7"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding TotalDeferredSales, StringFormat={}{0:N2}}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#D97706"/>
                        <TextBlock Text=" " />
                        <TextBlock Text="{DynamicResource Loc_CurrencySymbol}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#D97706"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,3"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>

            <!-- Recent Shifts List (Moved outside the restricted grid so Cashiers can see it) -->
        </Grid>

        <!-- Recent Shifts List -->
        <materialDesign:Card Grid.Row="3"
                             Style="{StaticResource AlAtmani.GlassCard}"
                             Margin="0"
                             Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <DockPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="{DynamicResource Loc_3b07ee85}"
                                   Style="{StaticResource AlAtmani.SubHeaderText}"
                                   VerticalAlignment="Center"/>
                        
                        <TextBox materialDesign:HintAssist.Hint="{DynamicResource Loc_h_f7cc4607}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Padding="8,6"
                                 Width="250"
                                 HorizontalAlignment="Left"
                                 materialDesign:TextFieldAssist.HasClearButton="True"
                                 VerticalAlignment="Center"/>
                    </DockPanel>

                    <DataGrid Grid.Row="1"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              Background="Transparent"
                              BorderThickness="0"
                              HeadersVisibility="Column"
                              FontSize="14"
                              ItemsSource="{Binding Shifts}"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.CanContentScroll="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource Loc_8456f22b}"
                                                Binding="{Binding StartTime, StringFormat={}{0:yyyy-MM-dd}, Mode=OneWay}"
                                                Width="*"/>
                            <DataGridTextColumn Header="{DynamicResource Loc_1567b6bf}"
                                                Binding="{Binding User.FullName, Mode=OneWay}"
                                                Width="*"/>
                            <DataGridTextColumn Header="{DynamicResource Loc_0f23204f}"
                                                Binding="{Binding StartTime, StringFormat={}{0:hh:mm tt}, Mode=OneWay}"
                                                Width="*"/>
                            <DataGridTextColumn Header="{DynamicResource Loc_969f7774}"
                                                Binding="{Binding EndTime, StringFormat={}{0:hh:mm tt}, Mode=OneWay}"
                                                Width="*"/>
                            <DataGridTemplateColumn Header="{DynamicResource Loc_f155c092}" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TotalSales, StringFormat={}{0:N2}}" />
                                            <TextBlock Text=" " />
                                            <TextBlock Text="{DynamicResource Loc_CurrencySymbol}" FontSize="11" Foreground="Gray" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{DynamicResource Loc_78e58007}" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ClosingBalance, StringFormat={}{0:N2}}" />
                                            <TextBlock Text=" " />
                                            <TextBlock Text="{DynamicResource Loc_CurrencySymbol}" FontSize="11" Foreground="Gray" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{DynamicResource Loc_b7b13d66}" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Difference, StringFormat={}{0:N2}}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding Difference, Converter={StaticResource DifferenceToColorConverter}}"/>
                                            <TextBlock Text=" " />
                                            <TextBlock Text="{DynamicResource Loc_CurrencySymbol}"
                                                       FontWeight="SemiBold"
                                                       FontSize="11"
                                                       Foreground="{Binding Difference, Converter={StaticResource DifferenceToColorConverter}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{DynamicResource Loc_aa009f8e}"
                                                Binding="{Binding TransactionCount, Mode=OneWay}"
                                                Width="*"/>
                            <DataGridTemplateColumn Header="{DynamicResource Loc_1253eb56}" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Padding="12,4" CornerRadius="12" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#F3F4F6"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Open">
                                                            <Setter Property="Background" Value="#DCFCE7"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Closed">
                                                            <Setter Property="Background" Value="#FEE2E2"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Reconciled">
                                                            <Setter Property="Background" Value="#E0E7FF"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontWeight="SemiBold" FontSize="12">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#4B5563"/>
                                                        <Setter Property="Text" Value="غير محدد"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Open">
                                                                <Setter Property="Foreground" Value="#15803D"/>
                                                                <Setter Property="Text" Value="مفتوحة"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Closed">
                                                                <Setter Property="Foreground" Value="#B91C1C"/>
                                                                <Setter Property="Text" Value="مغلقة"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Reconciled">
                                                                <Setter Property="Foreground" Value="#4338CA"/>
                                                                <Setter Property="Text" Value="مُسواة"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </ScrollViewer>
</Page>

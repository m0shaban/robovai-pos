<Page x:Class="SmartPOS.WPF.Views.AuditLogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="سجل النشاط"
      FontFamily="Segoe UI, Tahoma"
      FlowDirection="RightToLeft">

    <Grid Background="{DynamicResource AlAtmani.BackgroundBrush}" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="History" Width="28" Height="28"
                                         Foreground="{DynamicResource AlAtmani.AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="سجل النشاط والعمليات" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource AlAtmani.AccentBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            <Button Grid.Column="1" Command="{Binding RefreshCommand}"
                    Style="{StaticResource AlAtmani.SoftButton}" Padding="12,8">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" Margin="0,0,6,0"/>
                    <TextBlock Text="تحديث"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Filters -->
        <materialDesign:Card Grid.Row="1" Style="{StaticResource AlAtmani.GlassCard}"
                             Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <DatePicker Grid.Column="0" materialDesign:HintAssist.Hint="من تاريخ"
                            SelectedDate="{Binding StartDate}"
                            Style="{StaticResource MaterialDesignOutlinedDatePicker}" Margin="0,0,8,0"/>
                <DatePicker Grid.Column="1" materialDesign:HintAssist.Hint="إلى تاريخ"
                            SelectedDate="{Binding EndDate}"
                            Style="{StaticResource MaterialDesignOutlinedDatePicker}" Margin="0,0,8,0"/>
                <ComboBox Grid.Column="2" materialDesign:HintAssist.Hint="المستخدم (الكل)"
                          ItemsSource="{Binding Users}"
                          SelectedItem="{Binding FilterUser}"
                          DisplayMemberPath="FullName"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,8,0"/>
                <TextBox Grid.Column="3" materialDesign:HintAssist.Hint="نوع الإجراء"
                         Text="{Binding FilterAction, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,8,0"/>
                <TextBox Grid.Column="4" materialDesign:HintAssist.Hint="🔍 بحث في التفاصيل"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,8,0"/>
                <Button Grid.Column="5" Content="بحث" Command="{Binding FilterCommand}"
                        Style="{StaticResource AlAtmani.SoftButton}" Padding="16,8"/>
            </Grid>
        </materialDesign:Card>

        <!-- Audit Log Grid -->
        <materialDesign:Card Grid.Row="2" Style="{StaticResource AlAtmani.GlassCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="12,8">
                    <TextBlock Text="إجمالي السجلات: " Foreground="Gray"/>
                    <TextBlock Text="{Binding AuditLogs.Count}" FontWeight="Bold"
                               Foreground="{DynamicResource AlAtmani.AccentBrush}"/>
                    <TextBlock Text=" سجل" Foreground="Gray"/>
                </StackPanel>
                <DataGrid Grid.Row="1" ItemsSource="{Binding AuditLogs}"
                          AutoGenerateColumns="False" CanUserAddRows="False"
                          IsReadOnly="True"
                          materialDesign:DataGridAssist.CellPadding="10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="التاريخ والوقت"
                                            Binding="{Binding Timestamp, StringFormat='dd/MM/yyyy HH:mm:ss'}" Width="*"/>
                        <DataGridTextColumn Header="المستخدم" Binding="{Binding User.FullName}" Width="*"/>
                        <DataGridTextColumn Header="نوع الإجراء" Binding="{Binding ActionType}" Width="*"/>
                        <DataGridTextColumn Header="التفاصيل" Binding="{Binding Details}" Width="3*"/>
                        <DataGridTextColumn Header="موافق من" Binding="{Binding AuthorizedByAdmin.FullName}" Width="*"/>
                    </DataGrid.Columns>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActionType}" Value="Delete">
                                    <Setter Property="Background" Value="#FEF2F2"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ActionType}" Value="VoidItem">
                                    <Setter Property="Background" Value="#FFFBEB"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </Grid>
        </materialDesign:Card>
    </Grid>
</Page>

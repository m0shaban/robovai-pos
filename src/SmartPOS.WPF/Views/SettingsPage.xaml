<Page x:Class="SmartPOS.WPF.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="{DynamicResource Loc_1f600209}"
      FontFamily="Segoe UI, Tahoma"
      FlowDirection="RightToLeft"
      Unloaded="Page_Unloaded">

    <Grid Background="{DynamicResource AlAtmani.BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <materialDesign:Card Grid.Row="0"
                             Style="{StaticResource AlAtmani.GlassCard}"
                             Margin="24,24,24,16"
                             Padding="24">
            <StackPanel Orientation="Horizontal">
                <Border Background="#E1F5FE"
                        CornerRadius="12"
                        Padding="12"
                        Margin="0,0,16,0"
                        VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Cog"
                                             Width="32"
                                             Height="32"
                                             Foreground="#0288D1"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Loc_16b24375}"
                               Style="{StaticResource AlAtmani.HeaderText}"
                               Margin="0,0,0,0"/>
                    <TextBlock Text="{DynamicResource Loc_3a498d1f}"
                               FontSize="14"
                               Opacity="0.7"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
        </materialDesign:Card>

        <!-- Settings Tabs - Top Placement to fix RTL overlap bugs -->
        <TabControl Grid.Row="1"
                    Margin="24,0,24,24"
                    Style="{StaticResource MaterialDesignTabControl}"
                    Background="Transparent"
                    BorderThickness="0">
            <TabControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </TabControl.ItemsPanel>

            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Disabled"
                                PanningMode="HorizontalOnly"
                                Grid.Row="0">
                            <TabPanel x:Name="HeaderPanel"
                                    Panel.ZIndex="1"
                                    KeyboardNavigation.TabIndex="1"
                                    IsItemsHost="true"
                                    Background="Transparent"/>
                        </ScrollViewer>
                        <Border x:Name="Border"
                                Grid.Row="1"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}"
                                KeyboardNavigation.TabNavigation="Local"
                                KeyboardNavigation.DirectionalNavigation="Contained"
                                KeyboardNavigation.TabIndex="2">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                    Margin="{TemplateBinding Padding}"
                                    ContentSource="SelectedContent"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>

            <!-- Tab 1: Company & Billing -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal"
                            Margin="8,4">
                        <materialDesign:PackIcon Kind="Domain"
                                Width="20"
                                Height="20"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Loc_6daf4275}"
                                VerticalAlignment="Center"
                                FontSize="14"
                                FontWeight="SemiBold"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Margin="0,16,0,0">
                    <StackPanel>
                        <!-- General Info -->
                        <materialDesign:Card Style="{StaticResource AlAtmani.GlassCard}"
                                Padding="32"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Loc_c13f6fac}"
                                        FontSize="20"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}"
                                        Margin="0,0,0,24"/>

                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                            materialDesign:HintAssist.Hint="{DynamicResource Loc_h_d9356042}"
                                            Text="{Binding StoreName}"
                                            Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                            FontSize="16"
                                            Margin="0,0,16,0"/>
                                    <TextBox Grid.Column="1"
                                            materialDesign:HintAssist.Hint="{DynamicResource Loc_h_0947ad57}"
                                            Text="{Binding StorePhone}"
                                            Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                            FontSize="16"/>
                                </Grid>

                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                            materialDesign:HintAssist.Hint="{DynamicResource Loc_h_d12cd958}"
                                            Text="{Binding StoreTaxNumber}"
                                            Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                            FontSize="16"
                                            Margin="0,0,16,0"/>
                                    <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Bottom">
                                        <TextBox materialDesign:HintAssist.Hint="{DynamicResource Loc_h_cb9c78bf}"
                                                Text="{Binding StoreLogoPath}"
                                                Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                                FontSize="16"
                                                Width="250"
                                                Margin="0,0,16,0"/>
                                        <Button Content="{DynamicResource Loc_5c1ceb6f}"
                                                Command="{Binding SelectStoreLogoCommand}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                Height="35"/>
                                    </StackPanel>
                                </Grid>

                                <TextBox materialDesign:HintAssist.Hint="{DynamicResource Loc_h_6dc65880}"
                                        Text="{Binding StoreAddress}"
                                        Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                        FontSize="16"
                                        Margin="0,0,0,20"/>

                                <TextBox materialDesign:HintAssist.Hint="{DynamicResource Loc_h_81e71e92}"
                                        Text="{Binding FooterMessage, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                        FontSize="16"
                                        Height="80"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Regional Market & Payment Methods Card -->
                        <materialDesign:Card Style="{StaticResource AlAtmani.GlassCard}"
                                Padding="32"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <materialDesign:PackIcon Kind="Earth" Width="24" Height="24" Foreground="#10B981" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Loc_6beebba5}"
                                            FontSize="20"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}"
                                            VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource Loc_f3f0e50a}"
                                           FontSize="13" Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}" Margin="0,0,0,20" TextWrapping="Wrap"/>

                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0"
                                              materialDesign:HintAssist.Hint="{DynamicResource Loc_h_8219b747}"
                                              ItemsSource="{Binding CountryCodeOptions}"
                                              SelectedItem="{Binding SelectedCountryCode, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                              FontSize="15"
                                              Margin="0,0,16,0"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBox materialDesign:HintAssist.Hint="{DynamicResource Loc_h_1917923a}"
                                                 Text="{Binding CurrencySymbol, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                                 FontSize="15" FontWeight="Bold"
                                                 Width="180" Margin="0,0,16,0"/>
                                        <TextBox materialDesign:HintAssist.Hint="{DynamicResource Loc_h_26e1e845}"
                                                 Text="{Binding CurrencyName, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                                 FontSize="15"
                                                 Width="200"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{DynamicResource Loc_cbd3d832}" FontWeight="SemiBold" FontSize="14" Margin="0,10,0,12" Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}"/>
                                
                                <ItemsControl ItemsSource="{Binding PaymentMethodSettings}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource AlAtmani.Surface2Brush}" CornerRadius="10" Padding="10,6" Margin="0,0,10,10"
                                                    BorderThickness="1" BorderBrush="{DynamicResource AlAtmani.BorderBrush}">
                                                <CheckBox Content="{Binding DisplayName}"
                                                          IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                          FontSize="13" FontWeight="SemiBold"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Financial -->
                        <materialDesign:Card Style="{StaticResource AlAtmani.GlassCard}"
                                Padding="32"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Loc_7c73eae4}"
                                        FontSize="20"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}"
                                        Margin="0,0,0,24"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                            materialDesign:HintAssist.Hint="{DynamicResource Loc_h_c162a198}"
                                            Text="{Binding TaxPercentage, StringFormat={}{0:0.##}}"
                                            Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                            FontSize="16"
                                            Margin="0,0,16,0"
                                            Width="150"
                                            HorizontalAlignment="Left"/>
                                </Grid>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Multi-Branch & Synchronization Architecture Card -->
                        <materialDesign:Card Style="{StaticResource AlAtmani.GlassCard}"
                                Padding="32"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <materialDesign:PackIcon Kind="SourceBranch" Width="24" Height="24" Foreground="#38BDF8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Loc_4fbe3bc0}"
                                            FontSize="20"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}"
                                            VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource Loc_04707eef}"
                                           FontSize="13" Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}" Margin="0,0,0,20"/>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             materialDesign:HintAssist.Hint="{DynamicResource Loc_h_ac849e58}"
                                             Text="{Binding BranchName, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                             FontSize="15" Margin="0,0,16,0"/>
                                    <TextBox Grid.Column="1"
                                             materialDesign:HintAssist.Hint="{DynamicResource Loc_h_649cc4a3}"
                                             Text="{Binding BranchCode, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                             FontSize="15" Margin="0,0,16,0"/>
                                    <TextBox Grid.Column="2"
                                             materialDesign:HintAssist.Hint="{DynamicResource Loc_h_0bbdf3d2}"
                                             Text="{Binding BranchRole, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                             FontSize="15"/>
                                </Grid>
                            </StackPanel>
                        </materialDesign:Card>

                        <Button Content="{DynamicResource Loc_02f31ae2}"
                                Command="{Binding SaveSettingsCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Height="50"
                                Width="220"
                                FontSize="16"
                                HorizontalAlignment="Left"
                                Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Margin="0,8,0,16"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab: Theme & UI Customization -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Margin="8,4">
                        <materialDesign:PackIcon Kind="PaletteOutline" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Loc_746ace62}" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Margin="0,16,0,0">
                    <StackPanel>
                        <!-- Language Selection Card (لغة واجهة البرنامج) -->
                        <materialDesign:Card Style="{StaticResource AlAtmani.GlassCard}" Padding="32" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <materialDesign:PackIcon Kind="Translate" Width="26" Height="26" Foreground="#3B82F6" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Loc_6a668f9b}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource Loc_33324697}" FontSize="14" Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}" Margin="0,0,0,20"/>

                                <WrapPanel Margin="0,0,0,10" HorizontalAlignment="Center" ItemWidth="180">
                                    <!-- Arabic -->
                                    <Button Style="{StaticResource MaterialDesignFlatButton}" Height="120" Padding="16" Margin="10" Command="{Binding SelectLanguageCommand}" CommandParameter="ar" Background="{DynamicResource AlAtmani.Surface2Brush}" BorderThickness="1" BorderBrush="{DynamicResource AlAtmani.BorderBrush}">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Translate" Width="32" Height="32" HorizontalAlignment="Center" Foreground="{DynamicResource AlAtmani.AccentBrush}" Margin="0,0,0,6"/>
                                            <TextBlock Text="العربية (AR)" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Right-to-Left (RTL)" FontSize="12" Opacity="0.75" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- English -->
                                    <Button Style="{StaticResource MaterialDesignFlatButton}" Height="120" Padding="16" Margin="10" Command="{Binding SelectLanguageCommand}" CommandParameter="en" Background="{DynamicResource AlAtmani.Surface2Brush}" BorderThickness="1" BorderBrush="{DynamicResource AlAtmani.BorderBrush}">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Earth" Width="32" Height="32" HorizontalAlignment="Center" Foreground="#3B82F6" Margin="0,0,0,6"/>
                                            <TextBlock Text="English (US/UK)" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Left-to-Right (LTR)" FontSize="12" Opacity="0.75" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- French -->
                                    <Button Style="{StaticResource MaterialDesignFlatButton}" Height="120" Padding="16" Margin="10" Command="{Binding SelectLanguageCommand}" CommandParameter="fr" Background="{DynamicResource AlAtmani.Surface2Brush}" BorderThickness="1" BorderBrush="{DynamicResource AlAtmani.BorderBrush}">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Earth" Width="32" Height="32" HorizontalAlignment="Center" Foreground="#EAB308" Margin="0,0,0,6"/>
                                            <TextBlock Text="Français (FR)" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Left-to-Right (LTR)" FontSize="12" Opacity="0.75" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Spanish -->
                                    <Button Style="{StaticResource MaterialDesignFlatButton}" Height="120" Padding="16" Margin="10" Command="{Binding SelectLanguageCommand}" CommandParameter="es" Background="{DynamicResource AlAtmani.Surface2Brush}" BorderThickness="1" BorderBrush="{DynamicResource AlAtmani.BorderBrush}">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Earth" Width="32" Height="32" HorizontalAlignment="Center" Foreground="#EF4444" Margin="0,0,0,6"/>
                                            <TextBlock Text="Español (ES)" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Left-to-Right (LTR)" FontSize="12" Opacity="0.75" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Turkish -->
                                    <Button Style="{StaticResource MaterialDesignFlatButton}" Height="120" Padding="16" Margin="10" Command="{Binding SelectLanguageCommand}" CommandParameter="tr" Background="{DynamicResource AlAtmani.Surface2Brush}" BorderThickness="1" BorderBrush="{DynamicResource AlAtmani.BorderBrush}">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Earth" Width="32" Height="32" HorizontalAlignment="Center" Foreground="#8B5CF6" Margin="0,0,0,6"/>
                                            <TextBlock Text="Türkçe (TR)" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Left-to-Right (LTR)" FontSize="12" Opacity="0.75" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Urdu -->
                                    <Button Style="{StaticResource MaterialDesignFlatButton}" Height="120" Padding="16" Margin="10" Command="{Binding SelectLanguageCommand}" CommandParameter="ur" Background="{DynamicResource AlAtmani.Surface2Brush}" BorderThickness="1" BorderBrush="{DynamicResource AlAtmani.BorderBrush}">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Translate" Width="32" Height="32" HorizontalAlignment="Center" Foreground="#10B981" Margin="0,0,0,6"/>
                                            <TextBlock Text="اردو (UR)" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Right-to-Left (RTL)" FontSize="12" Opacity="0.75" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Window Mode & Screen Display Card -->
                        <materialDesign:Card Style="{StaticResource AlAtmani.GlassCard}" Padding="32" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <materialDesign:PackIcon Kind="MonitorDashboard" Width="26" Height="26" Foreground="{DynamicResource AlAtmani.AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Loc_72258e6c}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource Loc_78debdc5}" FontSize="14" Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}" Margin="0,0,0,20"/>

                                <WrapPanel Margin="0,0,0,10" HorizontalAlignment="Center" ItemWidth="200">
                                    <!-- Fullscreen Kiosk -->
                                    <Button Style="{StaticResource MaterialDesignFlatButton}" Height="120" Padding="16" Margin="10" Command="{Binding SelectWindowModeCommand}" CommandParameter="Fullscreen" Background="{DynamicResource AlAtmani.Surface2Brush}" BorderThickness="1" BorderBrush="{DynamicResource AlAtmani.BorderBrush}">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Fullscreen" Width="34" Height="34" HorizontalAlignment="Center" Foreground="{DynamicResource AlAtmani.AccentBrush}" Margin="0,0,0,6"/>
                                            <TextBlock Text="{DynamicResource Loc_Settings_Kiosk}" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource Loc_Settings_Kiosk_Desc}" FontSize="11" Opacity="0.75" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Maximized -->
                                    <Button Style="{StaticResource MaterialDesignFlatButton}" Height="120" Padding="16" Margin="10" Command="{Binding SelectWindowModeCommand}" CommandParameter="Maximized" Background="{DynamicResource AlAtmani.Surface2Brush}" BorderThickness="1" BorderBrush="{DynamicResource AlAtmani.BorderBrush}">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="WindowMaximize" Width="34" Height="34" HorizontalAlignment="Center" Foreground="#3B82F6" Margin="0,0,0,6"/>
                                            <TextBlock Text="{DynamicResource Loc_Settings_Maximized}" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource Loc_Settings_Maximized_Desc}" FontSize="11" Opacity="0.75" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Windowed -->
                                    <Button Style="{StaticResource MaterialDesignFlatButton}" Height="120" Padding="16" Margin="10" Command="{Binding SelectWindowModeCommand}" CommandParameter="Windowed" Background="{DynamicResource AlAtmani.Surface2Brush}" BorderThickness="1" BorderBrush="{DynamicResource AlAtmani.BorderBrush}">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="WindowRestore" Width="34" Height="34" HorizontalAlignment="Center" Foreground="#10B981" Margin="0,0,0,6"/>
                                            <TextBlock Text="{DynamicResource Loc_Settings_Windowed}" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource Loc_Settings_Windowed_Desc}" FontSize="11" Opacity="0.75" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Base Theme Mode Card -->
                        <materialDesign:Card Style="{StaticResource AlAtmani.GlassCard}" Padding="32" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Loc_965f7f33}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}" Margin="0,0,0,8"/>
                                <TextBlock Text="{DynamicResource Loc_eac2f9c3}" FontSize="14" Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}" Margin="0,0,0,20"/>

                                <WrapPanel Margin="0,0,0,10" HorizontalAlignment="Center" ItemWidth="200">
                                    <!-- Dark Mode -->
                                    <Button Style="{StaticResource MaterialDesignFlatButton}" Height="120" Padding="16" Margin="10" Command="{Binding SelectThemeModeCommand}" CommandParameter="Dark" Background="{DynamicResource AlAtmani.Surface2Brush}" BorderThickness="1" BorderBrush="{DynamicResource AlAtmani.BorderBrush}">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="WeatherNight" Width="34" Height="34" HorizontalAlignment="Center" Foreground="#818CF8" Margin="0,0,0,6"/>
                                            <TextBlock Text="{DynamicResource Loc_Settings_DarkMode}" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource Loc_Settings_DarkMode_Desc}" FontSize="11" Opacity="0.75" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Light Mode -->
                                    <Button Style="{StaticResource MaterialDesignFlatButton}" Height="120" Padding="16" Margin="10" Command="{Binding SelectThemeModeCommand}" CommandParameter="Light" Background="{DynamicResource AlAtmani.Surface2Brush}" BorderThickness="1" BorderBrush="{DynamicResource AlAtmani.BorderBrush}">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="WhiteBalanceSunny" Width="34" Height="34" HorizontalAlignment="Center" Foreground="#F59E0B" Margin="0,0,0,6"/>
                                            <TextBlock Text="{DynamicResource Loc_Settings_LightMode}" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource Loc_Settings_LightMode_Desc}" FontSize="11" Opacity="0.75" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Color Palettes Card -->
                        <materialDesign:Card Style="{StaticResource AlAtmani.GlassCard}" Padding="32" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Loc_bc70ae72}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}" Margin="0,0,0,8"/>
                                <TextBlock Text="{DynamicResource Loc_5f20ea71}" FontSize="14" Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}" Margin="0,0,0,20"/>

                                <WrapPanel Margin="0,0,0,10">
                                    <!-- 1. Sky Cyan (Microsoft Sky) -->
                                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                                            Height="85" Width="240" Margin="0,0,16,16" Padding="12"
                                            Command="{Binding SelectColorPaletteCommand}" CommandParameter="CyanSky"
                                            Background="{DynamicResource AlAtmani.Surface2Brush}"
                                            BorderThickness="1" BorderBrush="#00B4D8">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="32" Height="32" CornerRadius="16" Background="#00B4D8" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{DynamicResource Loc_8b1877d1}" FontWeight="Bold" FontSize="14"/>
                                                <TextBlock Text="Microsoft Sky Cyan" FontSize="11" Opacity="0.75"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>

                                    <!-- 2. Fluent Azure -->

<Page x:Class="SmartPOS.WPF.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="الإعدادات"
      FontFamily="Segoe UI, Tahoma"
      FlowDirection="RightToLeft"
      Unloaded="Page_Unloaded">

    <Grid Background="{DynamicResource AlAtmani.BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <materialDesign:Card Grid.Row="0"
                             Style="{StaticResource AlAtmani.GlassCard}"
                             Margin="24,24,24,16"
                             Padding="24">
            <StackPanel Orientation="Horizontal">
                <Border Background="#E1F5FE"
                        CornerRadius="12"
                        Padding="12"
                        Margin="0,0,16,0"
                        VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Cog"
                                             Width="32"
                                             Height="32"
                                             Foreground="#0288D1"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="إعدادات النظام"
                               Style="{StaticResource AlAtmani.HeaderText}"
                               Margin="0,0,0,0"/>
                    <TextBlock Text="تخصيص كامل للنظام ليناسب أعمالك التجارية"
                               FontSize="14"
                               Opacity="0.7"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
        </materialDesign:Card>

        <!-- Settings Tabs - Top Placement to fix RTL overlap bugs -->
        <TabControl Grid.Row="1"
                    Margin="24,0,24,24"
                    Style="{StaticResource MaterialDesignTabControl}"
                    Background="Transparent"
                    BorderThickness="0">
            <TabControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </TabControl.ItemsPanel>

            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Disabled"
                                PanningMode="HorizontalOnly"
                                Grid.Row="0">
                            <TabPanel x:Name="HeaderPanel"
                                    Panel.ZIndex="1"
                                    KeyboardNavigation.TabIndex="1"
                                    IsItemsHost="true"
                                    Background="Transparent"/>
                        </ScrollViewer>
                        <Border x:Name="Border"
                                Grid.Row="1"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}"
                                KeyboardNavigation.TabNavigation="Local"
                                KeyboardNavigation.DirectionalNavigation="Contained"
                                KeyboardNavigation.TabIndex="2">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                    Margin="{TemplateBinding Padding}"
                                    ContentSource="SelectedContent"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>

            <!-- Tab 1: Company & Billing -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal"
                            Margin="8,4">
                        <materialDesign:PackIcon Kind="Domain"
                                Width="20"
                                Height="20"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"/>
                        <TextBlock Text="الشركة والفواتير"
                                VerticalAlignment="Center"
                                FontSize="14"
                                FontWeight="SemiBold"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Margin="0,16,0,0">
                    <StackPanel>
                        <!-- General Info -->
                        <materialDesign:Card Style="{StaticResource AlAtmani.GlassCard}"
                                Padding="32"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="بيانات الفاتورة"
                                        FontSize="20"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}"
                                        Margin="0,0,0,24"/>

                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                            materialDesign:HintAssist.Hint="اسم المتجر"
                                            Text="{Binding StoreName}"
                                            Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                            FontSize="16"
                                            Margin="0,0,16,0"/>
                                    <TextBox Grid.Column="1"
                                            materialDesign:HintAssist.Hint="رقم الهاتف"
                                            Text="{Binding StorePhone}"
                                            Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                            FontSize="16"/>
                                </Grid>

                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                            materialDesign:HintAssist.Hint="الرقم الضريبي (اختياري)"
                                            Text="{Binding StoreTaxNumber}"
                                            Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                            FontSize="16"
                                            Margin="0,0,16,0"/>
                                    <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Bottom">
                                        <TextBox materialDesign:HintAssist.Hint="شعار الفاتورة الحرارية"
                                                Text="{Binding StoreLogoPath}"
                                                Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                                FontSize="16"
                                                Width="250"
                                                Margin="0,0,16,0"/>
                                        <Button Content="تصفح"
                                                Command="{Binding SelectStoreLogoCommand}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                Height="35"/>
                                    </StackPanel>
                                </Grid>

                                <TextBox materialDesign:HintAssist.Hint="العنوان"
                                        Text="{Binding StoreAddress}"
                                        Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                        FontSize="16"
                                        Margin="0,0,0,20"/>

                                <TextBox materialDesign:HintAssist.Hint="رسالة تذييل الفاتورة (تظهر أسفل الفاتورة)"
                                        Text="{Binding FooterMessage, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                        FontSize="16"
                                        Height="80"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Regional Market & Payment Methods Card -->
                        <materialDesign:Card Style="{StaticResource AlAtmani.GlassCard}"
                                Padding="32"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <materialDesign:PackIcon Kind="Earth" Width="24" Height="24" Foreground="#10B981" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="تخصيص السوق الإقليمي والعملة وطرق الدفع"
                                            FontSize="20"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}"
                                            VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="حدد الدولة المناسبة ليقوم النظام بتهيئة العملة الرسمية وطرق الدفع التلقائية (مثل مدى و STC Pay للسوق السعودي، أو انستاباي وفودافون كاش للسوق المصري)."
                                           FontSize="13" Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}" Margin="0,0,0,20" TextWrapping="Wrap"/>

                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0"
                                              materialDesign:HintAssist.Hint="الدولة / السوق التجاري"
                                              ItemsSource="{Binding CountryCodeOptions}"
                                              SelectedItem="{Binding SelectedCountryCode, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                              FontSize="15"
                                              Margin="0,0,16,0"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBox materialDesign:HintAssist.Hint="رمز العملة (مثال: ر.س أو ج.م)"
                                                 Text="{Binding CurrencySymbol, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                                 FontSize="15" FontWeight="Bold"
                                                 Width="180" Margin="0,0,16,0"/>
                                        <TextBox materialDesign:HintAssist.Hint="اسم العملة"
                                                 Text="{Binding CurrencyName, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                                 FontSize="15"
                                                 Width="200"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="طرق الدفع المفعلة في شاشة نقطة البيع (POS):" FontWeight="SemiBold" FontSize="14" Margin="0,10,0,12" Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}"/>
                                
                                <ItemsControl ItemsSource="{Binding PaymentMethodSettings}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource AlAtmani.Surface2Brush}" CornerRadius="10" Padding="10,6" Margin="0,0,10,10"
                                                    BorderThickness="1" BorderBrush="{DynamicResource AlAtmani.BorderBrush}">
                                                <CheckBox Content="{Binding DisplayName}"
                                                          IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                          FontSize="13" FontWeight="SemiBold"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Financial -->
                        <materialDesign:Card Style="{StaticResource AlAtmani.GlassCard}"
                                Padding="32"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="الإعدادات المالية"
                                        FontSize="20"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}"
                                        Margin="0,0,0,24"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                            materialDesign:HintAssist.Hint="نسبة الضريبة %"
                                            Text="{Binding TaxPercentage, StringFormat={}{0:0.##}}"
                                            Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                            FontSize="16"
                                            Margin="0,0,16,0"
                                            Width="150"
                                            HorizontalAlignment="Left"/>
                                </Grid>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Multi-Branch & Synchronization Architecture Card -->
                        <materialDesign:Card Style="{StaticResource AlAtmani.GlassCard}"
                                Padding="32"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <materialDesign:PackIcon Kind="SourceBranch" Width="24" Height="24" Foreground="#38BDF8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="إدارة الفروع والربط والمزامنة المركزية"
                                            FontSize="20"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}"
                                            VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="تحديد بيانات الفرع الحالي ونمط الربط والمزامنة بين الفروع وسيرفر الشبكة المحلية (Port 7890)."
                                           FontSize="13" Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}" Margin="0,0,0,20"/>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             materialDesign:HintAssist.Hint="اسم الفرع"
                                             Text="{Binding BranchName, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                             FontSize="15" Margin="0,0,16,0"/>
                                    <TextBox Grid.Column="1"
                                             materialDesign:HintAssist.Hint="كود الفرع"
                                             Text="{Binding BranchCode, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                             FontSize="15" Margin="0,0,16,0"/>
                                    <TextBox Grid.Column="2"
                                             materialDesign:HintAssist.Hint="دور الجهاز (سيرفر / كاشير)"
                                             Text="{Binding BranchRole, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                             FontSize="15"/>
                                </Grid>
                            </StackPanel>
                        </materialDesign:Card>

                        <Button Content="حفظ التغييرات"
                                Command="{Binding SaveSettingsCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Height="50"
                                Width="220"
                                FontSize="16"
                                HorizontalAlignment="Left"
                                Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Margin="0,8,0,16"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab: Theme & UI Customization -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Margin="8,4">
                        <materialDesign:PackIcon Kind="PaletteOutline" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="المظهر والتخصيص" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Margin="0,16,0,0">
                    <StackPanel>
                        <!-- Window Mode & Screen Display Card -->
                        <materialDesign:Card Style="{StaticResource AlAtmani.GlassCard}" Padding="32" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <materialDesign:PackIcon Kind="MonitorDashboard" Width="26" Height="26" Foreground="{DynamicResource AlAtmani.AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="وضع عرض الشاشة والنوافذ (Display &amp; Window Mode)" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="اختر كيفية ظهور نافذة البرنامج: شاشة كاملة بدون حواف مخصصة لنقاط البيع، أو نافذة مكبرة مع أزرار التحكم (تصغير/تكبير/إغلاق)، أو نافذة عادية قابلة للتحريك." FontSize="14" Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}" Margin="0,0,0,20"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 1. Fullscreen / Kiosk Mode -->
                                    <Button Grid.Column="0"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Height="120"
                                            Padding="16"
                                            Command="{Binding SelectWindowModeCommand}"
                                            CommandParameter="Fullscreen"
                                            Background="{DynamicResource AlAtmani.Surface2Brush}"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource AlAtmani.BorderBrush}">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Fullscreen" Width="36" Height="36" HorizontalAlignment="Center" Foreground="{DynamicResource AlAtmani.AccentBrush}" Margin="0,0,0,8"/>
                                            <TextBlock Text="شاشة كاملة (Kiosk Mode)" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center"/>
                                            <TextBlock Text="تعبئة كامل الشاشة بدون أشرطة إضافية" FontSize="11" Opacity="0.75" HorizontalAlignment="Center" Margin="0,2,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- 2. Maximized with Controls -->
                                    <Button Grid.Column="2"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Height="120"
                                            Padding="16"
                                            Command="{Binding SelectWindowModeCommand}"
                                            CommandParameter="Maximized"
                                            Background="{DynamicResource AlAtmani.Surface2Brush}"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource AlAtmani.BorderBrush}">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="WindowMaximize" Width="36" Height="36" HorizontalAlignment="Center" Foreground="#10B981" Margin="0,0,0,8"/>
                                            <TextBlock Text="نافذة مكبرة (Maximized)" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center"/>
                                            <TextBlock Text="ملء الشاشة مع أزرار تصغير/تكبير/إغلاق" FontSize="11" Opacity="0.75" HorizontalAlignment="Center" Margin="0,2,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- 3. Windowed Frame Mode -->
                                    <Button Grid.Column="4"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Height="120"
                                            Padding="16"
                                            Command="{Binding SelectWindowModeCommand}"
                                            CommandParameter="Windowed"
                                            Background="{DynamicResource AlAtmani.Surface2Brush}"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource AlAtmani.BorderBrush}">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="WindowRestore" Width="36" Height="36" HorizontalAlignment="Center" Foreground="#3B82F6" Margin="0,0,0,8"/>
                                            <TextBlock Text="نافذة حرة (Windowed)" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center"/>
                                            <TextBlock Text="قابلة للتحريك والتصغير بجانب البرامج الأخرى" FontSize="11" Opacity="0.75" HorizontalAlignment="Center" Margin="0,2,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Base Theme Mode Card -->
                        <materialDesign:Card Style="{StaticResource AlAtmani.GlassCard}" Padding="32" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="نمط المظهر (Base Theme)" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}" Margin="0,0,0,8"/>
                                <TextBlock Text="اختر نمط الإضاءة المناسب لبيئة العمل (الوضع الليلي الفخم أو النهاري الناصع أو مطابقة الويندوز)" FontSize="14" Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}" Margin="0,0,0,20"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Dark Mode Card -->
                                    <Button Grid.Column="0"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Height="110"
                                            Padding="16"
                                            Command="{Binding SelectThemeModeCommand}"
                                            CommandParameter="Dark"
                                            Background="{DynamicResource AlAtmani.Surface2Brush}"
                                            BorderThickness="2"
                                            BorderBrush="{DynamicResource AlAtmani.AccentBrush}">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="WeatherNight" Width="36" Height="36" HorizontalAlignment="Center" Foreground="{DynamicResource AlAtmani.AccentBrush}" Margin="0,0,0,8"/>
                                            <TextBlock Text="الوضع الليلي (Dark)" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center"/>
                                            <TextBlock Text="داكن فخم ومريح للعين" FontSize="11" Opacity="0.75" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Light Mode Card -->
                                    <Button Grid.Column="2"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Height="110"
                                            Padding="16"
                                            Command="{Binding SelectThemeModeCommand}"
                                            CommandParameter="Light"
                                            Background="{DynamicResource AlAtmani.Surface2Brush}"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource AlAtmani.BorderBrush}">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="WhiteBalanceSunny" Width="36" Height="36" HorizontalAlignment="Center" Foreground="#F59E0B" Margin="0,0,0,8"/>
                                            <TextBlock Text="الوضع النهاري (Light)" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center"/>
                                            <TextBlock Text="ناصع بإضاءة عالية وألوان نقية" FontSize="11" Opacity="0.75" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- System Mode Card -->
                                    <Button Grid.Column="4"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Height="110"
                                            Padding="16"
                                            Command="{Binding SelectThemeModeCommand}"
                                            CommandParameter="System"
                                            Background="{DynamicResource AlAtmani.Surface2Brush}"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource AlAtmani.BorderBrush}">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Laptop" Width="36" Height="36" HorizontalAlignment="Center" Foreground="#3B82F6" Margin="0,0,0,8"/>
                                            <TextBlock Text="مطابقة الويندوز (System)" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center"/>
                                            <TextBlock Text="يتبع سمة نظام Windows تلقائياً" FontSize="11" Opacity="0.75" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Color Palettes Card -->
                        <materialDesign:Card Style="{StaticResource AlAtmani.GlassCard}" Padding="32" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="لوحة الألوان والسمات الشاملة (Immersive Color Themes)" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}" Margin="0,0,0,8"/>
                                <TextBlock Text="اختر الطابع اللوني لتغيير خلفيات وأسطح وبطاقات وأزرار النظام بالكامل بنمط لوني متكامل" FontSize="14" Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}" Margin="0,0,0,20"/>

                                <WrapPanel Margin="0,0,0,10">
                                    <!-- 1. Sky Cyan (Microsoft Sky) -->
                                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                                            Height="85" Width="240" Margin="0,0,16,16" Padding="12"
                                            Command="{Binding SelectColorPaletteCommand}" CommandParameter="CyanSky"
                                            Background="{DynamicResource AlAtmani.Surface2Brush}"
                                            BorderThickness="1" BorderBrush="#00B4D8">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="32" Height="32" CornerRadius="16" Background="#00B4D8" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="السماوي الفيروزي" FontWeight="Bold" FontSize="14"/>
                                                <TextBlock Text="Microsoft Sky Cyan" FontSize="11" Opacity="0.75"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>

                                    <!-- 2. Fluent Azure -->
                                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                                            Height="85" Width="240" Margin="0,0,16,16" Padding="12"
                                            Command="{Binding SelectColorPaletteCommand}" CommandParameter="FluentAzure"
                                            Background="{DynamicResource AlAtmani.Surface2Brush}"
                                            BorderThickness="1" BorderBrush="#0078D4">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="32" Height="32" CornerRadius="16" Background="#0078D4" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="ميكروسوفت فلوينت" FontWeight="Bold" FontSize="14"/>
                                                <TextBlock Text="Microsoft Fluent Azure" FontSize="11" Opacity="0.75"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>

                                    <!-- 3. Deep Space -->
                                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                                            Height="85" Width="240" Margin="0,0,16,16" Padding="12"
                                            Command="{Binding SelectColorPaletteCommand}" CommandParameter="DeepSpace"
                                            Background="{DynamicResource AlAtmani.Surface2Brush}"
                                            BorderThickness="1" BorderBrush="#3B82F6">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="32" Height="32" CornerRadius="16" Background="#3B82F6" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="الفضاء الكوني" FontWeight="Bold" FontSize="14"/>
                                                <TextBlock Text="Deep Space Blue" FontSize="11" Opacity="0.75"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>

                                    <!-- 4. Emerald Green -->

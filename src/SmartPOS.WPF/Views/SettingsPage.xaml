                                                <ColumnDefinition Width="2.2*"/>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="اسم الجهاز / الكاشير" FontWeight="Bold" Foreground="#475569"/>
                                            <TextBlock Grid.Column="1" Text="عنوان الـ IP" FontWeight="Bold" Foreground="#475569"/>
                                            <TextBlock Grid.Column="2" Text="الدور بالنظام" FontWeight="Bold" Foreground="#475569"/>
                                            <TextBlock Grid.Column="3" Text="الحالة" FontWeight="Bold" Foreground="#475569"/>
                                            <TextBlock Grid.Column="4" Text="آخر مزامنة" FontWeight="Bold" Foreground="#475569"/>
                                        </Grid>
                                        <Separator Margin="0,0,0,8"/>
                                        <!-- Main Terminal Row -->
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2.2*"/>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="🖥️ الكاشير الرئيسي (Master Host)" FontWeight="SemiBold" Foreground="#1E293B"/>
                                            <TextBlock Grid.Column="1" Text="192.168.1.100" Foreground="#64748B"/>
                                            <TextBlock Grid.Column="2" Text="Master Hub Server" Foreground="#4F46E5" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="3" Text="🟢 نشط الآن" Foreground="#16A34A" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="4" Text="الآن" Foreground="#64748B"/>
                                        </Grid>
                                        <!-- Additional Mobile / Secondary Cashier Row -->
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2.2*"/>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="📱 كاشير الفرعي / الموبايل #2" FontWeight="SemiBold" Foreground="#1E293B"/>
                                            <TextBlock Grid.Column="1" Text="192.168.1.105" Foreground="#64748B"/>
                                            <TextBlock Grid.Column="2" Text="Secondary POS Client" Foreground="#0288D1" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="3" Text="🟢 متصل" Foreground="#16A34A" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="4" Text="منذ 30 ثانية" Foreground="#64748B"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </materialDesign:Card>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab: Local Web Services, Dashboard & WMS Hub -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Margin="8,4">
                        <materialDesign:PackIcon Kind="CloudSyncOutline" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#6366F1"/>
                        <TextBlock Text="🌐 المنظومة الرقمية والربط الشبكي (Web &amp; WMS)" VerticalAlignment="Center" FontSize="14" FontWeight="Bold"/>
                        <Border Background="#6366F1" CornerRadius="8" Padding="6,2" Margin="8,0,0,0">
                            <TextBlock Text="v6.0 🚀" Foreground="White" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Margin="0,16,0,0">
                    <StackPanel>
                        <!-- Server Status Banner -->
                        <materialDesign:Card Style="{StaticResource AlAtmani.GlassCard}" Padding="20" Margin="0,0,0,16" Background="#0F172A">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Grid.Column="0" Kind="ServerNetwork" Width="36" Height="36" Foreground="#10B981" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="سيرفر الربط والخدمات الرقمية المحلية (Local LAN Engine - Port 7890)" FontSize="17" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="{Binding LanServerStatus}" FontSize="13" Foreground="#94A3B8" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="📖 فتح دليل الاستخدام الشامل"
                                        Click="OpenUserGuide_Click"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Background="#3B82F6" BorderBrush="#3B82F6" Height="38"/>
                            </Grid>
                        </materialDesign:Card>

                        <!-- Service 1: Web Dashboard -->
                        <materialDesign:Card Style="{StaticResource AlAtmani.GlassCard}" Padding="24" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <materialDesign:PackIcon Kind="ChartBoxOutline" Width="26" Height="26" Foreground="#2563EB" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="1. لوحة معلومات الإدارة والتحكم (Web Dashboard &amp; Analytics)" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}"/>
                                        <TextBlock Text="متابعة حية للمبيعات، الأرباح، ساعات الذروة، والنواقص من أي متصفح في المكان" FontSize="13" Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             materialDesign:HintAssist.Hint="رابط لوحة التحكم الإدارية بالمتصفح"
                                             Text="{Binding LanServerUrl, Mode=OneWay}"
                                             IsReadOnly="True"
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                             FontSize="15" Margin="0,0,12,0"/>
                                    <Button Grid.Column="1" Content="📋 نسخ الرابط"
                                            Click="CopyDashboardUrl_Click"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Height="40" Margin="0,0,8,0"/>
                                    <Button Grid.Column="2" Content="🚀 فتح بالمتصفح"
                                            Click="OpenDashboardBrowser_Click"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Height="40" Background="#2563EB" BorderBrush="#2563EB"/>
                                </Grid>

                                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,4">
                                    <TextBlock Text="💡 لوحة التحكم تتحدث تلقائياً كل 30 ثانية وتعرض إحصائيات المبيعات، الفواتير، الأجهزة المتصلة، وتنبيهات نواقص المخزون لحظياً." Foreground="#1E40AF" FontSize="12" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Service 2: WMS Web App -->
                        <materialDesign:Card Style="{StaticResource AlAtmani.GlassCard}" Padding="24" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <materialDesign:PackIcon Kind="PackageVariantClosed" Width="26" Height="26" Foreground="#6366F1" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="2. منصة إدارة المخازن والجرد المحمولة (Smart WMS PWA Platform)" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}"/>
                                        <TextBlock Text="تطبيق الويب التقدمي لأمين المخزن لمسح الباركود بالكاميرا وإجراء الجرد والوارد والصادر" FontSize="13" Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             materialDesign:HintAssist.Hint="رابط تشغيل منصة WMS بالمتصفح (محلياً وشبكياً)"
                                             Text="{Binding WmsWebUrl, Mode=OneWay}"
                                             IsReadOnly="True"
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                             FontSize="15" Margin="0,0,12,0"/>
                                    <Button Grid.Column="1" Content="📋 نسخ الرابط"
                                            Click="CopyWmsUrl_Click"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Height="40" Margin="0,0,8,0"/>
                                    <Button Grid.Column="2" Content="🚀 فتح بالمتصفح"
                                            Click="OpenWmsBrowser_Click"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Height="42" Background="#6366F1" BorderBrush="#6366F1"/>
                                </Grid>

                                <Border Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                                    <TextBlock Text="🔑 بيانات الدخول الافتراضية لمنصة WMS: اسم المستخدم: [ admin ] | كلمة المرور: [ 123456 ] (أو كلمة المرور الخاصة بالحساب في النظام)" Foreground="#3730A3" FontWeight="Bold" FontSize="13"/>
                                </Border>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Client Mobile & Connection Guide -->
                        <materialDesign:Card Style="{StaticResource AlAtmani.GlassCard}" Padding="24" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <materialDesign:PackIcon Kind="CellphoneLink" Width="26" Height="26" Foreground="#0D9488" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="📱 دليل خطوات ربط وتشغيل الهواتف والتابلت للعملاء (بدون إنترنت)" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}"/>
                                        <TextBlock Text="اتبع الخطوات الأربع التالية لتشغيل المنصة على أي هاتف متصل بنفس شبكة المحل" FontSize="13" Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <UniformGrid Columns="4" Margin="0,4,0,8">
                                    <!-- Step 1 -->
                                    <Border Background="{DynamicResource AlAtmani.CardBackgroundBrush}" BorderBrush="{DynamicResource AlAtmani.CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="4">
                                        <StackPanel>
                                            <TextBlock Text="1️⃣ شبكة الواي فاي" FontWeight="Bold" FontSize="14" Foreground="#0D9488" Margin="0,0,0,6"/>
                                            <TextBlock Text="تأكد من اتصال الموبايل بنفس شبكة الواي فاي (WiFi) المتصل بها جهاز الكاشير." FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Step 2 -->
                                    <Border Background="{DynamicResource AlAtmani.CardBackgroundBrush}" BorderBrush="{DynamicResource AlAtmani.CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="4">
                                        <StackPanel>
                                            <TextBlock Text="2️⃣ فتح الرابط" FontWeight="Bold" FontSize="14" Foreground="#0D9488" Margin="0,0,0,6"/>
                                            <TextBlock Text="افتح متصفح الموبايل واكتب الرابط الشبكي الظاهر أعلاه أو امسح كود QR." FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Step 3 -->
                                    <Border Background="{DynamicResource AlAtmani.CardBackgroundBrush}" BorderBrush="{DynamicResource AlAtmani.CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="4">
                                        <StackPanel>
                                            <TextBlock Text="3️⃣ تسجيل الدخول" FontWeight="Bold" FontSize="14" Foreground="#0D9488" Margin="0,0,0,6"/>
                                            <TextBlock Text="سجل الدخول بحساب الكاشير الافتراضي (admin / 123456) أو حسابك المخصص." FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Step 4 -->
                                    <Border Background="{DynamicResource AlAtmani.CardBackgroundBrush}" BorderBrush="{DynamicResource AlAtmani.CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="4">
                                        <StackPanel>
                                            <TextBlock Text="4️⃣ تثبيت كتطبيق (PWA)" FontWeight="Bold" FontSize="14" Foreground="#0D9488" Margin="0,0,0,6"/>
                                            <TextBlock Text="من خيارات المتصفح (⋮) اضغط 'إضافة للشاشة الرئيسية' لتثبيته كـ تطبيق سريع." FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- QR Pairing Bridge Card -->
                        <materialDesign:Card Style="{StaticResource AlAtmani.GlassCard}" Padding="28" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <materialDesign:PackIcon Kind="QrcodeScan" Width="28" Height="28" Foreground="#059669" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="ربط ومزامنة الأجهزة بكود QR (WMS QR Bridge)" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}"/>
                                        <TextBlock Text="اقرأ كود QR بكاميرا الموبايل لربط الجهاز فوراً وإتاحة الجرد الأوفلاين" FontSize="13" Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <WrapPanel Margin="0,0,0,16">
                                    <Button Content="⚡ توليد كود QR للربط المباشر"
                                            Command="{Binding GeneratePairingQrCommand}"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Background="#059669" BorderBrush="#059669"
                                            Height="42" Margin="0,0,12,12"/>
                                    <Button Content="💾 حفظ صورة QR"
                                            Command="{Binding SavePairingQrCommand}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Height="42" Margin="0,0,12,12"/>
                                    <Button Content="📤 تصدير بيانات المخزن (JSON)"
                                            Command="{Binding ExportWmsPayloadJsonCommand}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Height="42" Margin="0,0,12,12"/>
                                    <Button Content="📥 استيراد جرد المخزن (JSON)"
                                            Command="{Binding ImportWmsPayloadJsonCommand}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Height="42" Margin="0,0,12,12"/>
                                </WrapPanel>

                                <Image Source="{Binding PairingQrImageSource}" MaxHeight="220" HorizontalAlignment="Right" Margin="0,8,0,8" Visibility="{Binding PairingQrVisibility}"/>
                                <TextBlock Text="{Binding PairingQrInfoText}" Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}" FontSize="13" Margin="0,4,0,0"/>
                            </StackPanel>
                        </materialDesign:Card>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</Page>

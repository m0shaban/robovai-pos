                                    <TextBlock Text="F2" FontWeight="Bold" Foreground="White"/>
                                </Border>
                                <TextBlock Text="{DynamicResource Loc_ab2b7e65}" VerticalAlignment="Center" Grid.Row="0" Grid.Column="3" Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}"/>

                                <!-- Shortcut 3 -->
                                <Border Background="{DynamicResource AlAtmani.SurfaceBrush}" BorderBrush="{DynamicResource AlAtmani.BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,4,12,4" Grid.Row="1" Grid.Column="0">
                                    <TextBlock Text="F7" FontWeight="Bold" Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}"/>
                                </Border>
                                <TextBlock Text="{DynamicResource Loc_69d72a8c}" VerticalAlignment="Center" Grid.Row="1" Grid.Column="1" Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}" Margin="0,0,16,0"/>

                                <!-- Shortcut 4 -->
                                <Border Background="{DynamicResource AlAtmani.SurfaceBrush}" BorderBrush="{DynamicResource AlAtmani.BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,4,12,4" Grid.Row="1" Grid.Column="2">

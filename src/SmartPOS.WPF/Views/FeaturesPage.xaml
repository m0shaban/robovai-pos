                            <TextBlock Text="{DynamicResource Loc_4d5ef5b2}" TextWrapping="Wrap" Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}" FontSize="13" LineHeight="18"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Feature 7: Shifts & Z-Report -->
                    <materialDesign:Card Style="{StaticResource AlAtmani.GlassCard}" Margin="6" Padding="20">
                        <StackPanel>
                            <Border Background="#153B82F6" CornerRadius="10" Padding="10" HorizontalAlignment="Left" Margin="0,0,0,12">
                                <materialDesign:PackIcon Kind="ClockTimeEightOutline" Width="32" Height="32" Foreground="#3B82F6"/>
                            </Border>
                            <TextBlock Text="{DynamicResource Loc_92a3af0c}" FontSize="17" FontWeight="Bold" Margin="0,0,0,6" Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource Loc_8b75f5da}" TextWrapping="Wrap" Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}" FontSize="13" LineHeight="18"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Feature 8: Customer Loyalty -->
                    <materialDesign:Card Style="{StaticResource AlAtmani.GlassCard}" Margin="6" Padding="20">
                        <StackPanel>
                            <Border Background="#15EC4899" CornerRadius="10" Padding="10" HorizontalAlignment="Left" Margin="0,0,0,12">
                                <materialDesign:PackIcon Kind="StarShooting" Width="32" Height="32" Foreground="#EC4899"/>
                            </Border>
                            <TextBlock Text="{DynamicResource Loc_53bc7a84}" FontSize="17" FontWeight="Bold" Margin="0,0,0,6" Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource Loc_b5e76142}" TextWrapping="Wrap" Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}" FontSize="13" LineHeight="18"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Feature 9: Suppliers & Purchases -->
                    <materialDesign:Card Style="{StaticResource AlAtmani.GlassCard}" Margin="6" Padding="20">
                        <StackPanel>
                            <Border Background="#15EF4444" CornerRadius="10" Padding="10" HorizontalAlignment="Left" Margin="0,0,0,12">
                                <materialDesign:PackIcon Kind="TruckDeliveryOutline" Width="32" Height="32" Foreground="#EF4444"/>
                            </Border>
                            <TextBlock Text="{DynamicResource Loc_a6cc947c}" FontSize="17" FontWeight="Bold" Margin="0,0,0,6" Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource Loc_9dd3e44d}" TextWrapping="Wrap" Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}" FontSize="13" LineHeight="18"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Feature 10: Returns & Tax Refunds -->
                    <materialDesign:Card Style="{StaticResource AlAtmani.GlassCard}" Margin="6" Padding="20">
                        <StackPanel>
                            <Border Background="#156366F1" CornerRadius="10" Padding="10" HorizontalAlignment="Left" Margin="0,0,0,12">
                                <materialDesign:PackIcon Kind="KeyboardReturn" Width="32" Height="32" Foreground="#6366F1"/>
                            </Border>
                            <TextBlock Text="{DynamicResource Loc_576d8a05}" FontSize="17" FontWeight="Bold" Margin="0,0,0,6" Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource Loc_a50c8970}" TextWrapping="Wrap" Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}" FontSize="13" LineHeight="18"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Feature 11: Security & Audit Logs -->
                    <materialDesign:Card Style="{StaticResource AlAtmani.GlassCard}" Margin="6" Padding="20">
                        <StackPanel>
                            <Border Background="#1514B8A6" CornerRadius="10" Padding="10" HorizontalAlignment="Left" Margin="0,0,0,12">
                                <materialDesign:PackIcon Kind="ShieldLockOutline" Width="32" Height="32" Foreground="#14B8A6"/>
                            </Border>
                            <TextBlock Text="{DynamicResource Loc_c1d9cdc1}" FontSize="17" FontWeight="Bold" Margin="0,0,0,6" Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource Loc_73ce4e3b}" TextWrapping="Wrap" Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}" FontSize="13" LineHeight="18"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Feature 12: Customer Secondary Display -->
                    <materialDesign:Card Style="{StaticResource AlAtmani.GlassCard}" Margin="6" Padding="20">
                        <StackPanel>
                            <Border Background="#150284C7" CornerRadius="10" Padding="10" HorizontalAlignment="Left" Margin="0,0,0,12">
                                <materialDesign:PackIcon Kind="MonitorMultiple" Width="32" Height="32" Foreground="#0284C7"/>
                            </Border>
                            <TextBlock Text="{DynamicResource Loc_8d0e04e0}" FontSize="17" FontWeight="Bold" Margin="0,0,0,6" Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource Loc_e041fe8d}" TextWrapping="Wrap" Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}" FontSize="13" LineHeight="18"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Feature 13: Staff Meals -->
                    <materialDesign:Card Style="{StaticResource AlAtmani.GlassCard}" Margin="6" Padding="20">
                        <StackPanel>
                            <Border Background="#15F97316" CornerRadius="10" Padding="10" HorizontalAlignment="Left" Margin="0,0,0,12">
                                <materialDesign:PackIcon Kind="FoodForkDrink" Width="32" Height="32" Foreground="#F97316"/>
                            </Border>
                            <TextBlock Text="{DynamicResource Loc_c2f61c9c}" FontSize="17" FontWeight="Bold" Margin="0,0,0,6" Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource Loc_ba51dcba}" TextWrapping="Wrap" Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}" FontSize="13" LineHeight="18"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Feature 14: Telegram Notifications -->
                    <materialDesign:Card Style="{StaticResource AlAtmani.GlassCard}" Margin="6" Padding="20">
                        <StackPanel>
                            <Border Background="#150EA5E9" CornerRadius="10" Padding="10" HorizontalAlignment="Left" Margin="0,0,0,12">
                                <materialDesign:PackIcon Kind="Send" Width="32" Height="32" Foreground="#0EA5E9"/>
                            </Border>
                            <TextBlock Text="{DynamicResource Loc_5f3fd567}" FontSize="17" FontWeight="Bold" Margin="0,0,0,6" Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource Loc_e085c443}" TextWrapping="Wrap" Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}" FontSize="13" LineHeight="18"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Feature 15: Safe Backups & Factory Reset -->
                    <materialDesign:Card Style="{StaticResource AlAtmani.GlassCard}" Margin="6" Padding="20">
                        <StackPanel>
                            <Border Background="#1510B981" CornerRadius="10" Padding="10" HorizontalAlignment="Left" Margin="0,0,0,12">
                                <materialDesign:PackIcon Kind="BackupRestore" Width="32" Height="32" Foreground="#10B981"/>
                            </Border>
                            <TextBlock Text="{DynamicResource Loc_3838e58e}" FontSize="17" FontWeight="Bold" Margin="0,0,0,6" Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource Loc_e8289fc1}" TextWrapping="Wrap" Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}" FontSize="13" LineHeight="18"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Feature 16: Setup Wizard & Country Engine -->
                    <materialDesign:Card Style="{StaticResource AlAtmani.GlassCard}" Margin="6" Padding="20">
                        <StackPanel>
                            <Border Background="#156366F1" CornerRadius="10" Padding="10" HorizontalAlignment="Left" Margin="0,0,0,12">
                                <materialDesign:PackIcon Kind="Earth" Width="32" Height="32" Foreground="#6366F1"/>
                            </Border>
                            <TextBlock FontSize="17" FontWeight="Bold" Margin="0,0,0,6" Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}">
                                <Run Text="{DynamicResource Loc_debe1ced}"/>
                                <Run Text=" 🆕" Foreground="#6366F1" FontSize="13"/>
                            </TextBlock>
                            <TextBlock Text="{DynamicResource Loc_cff2f020}" TextWrapping="Wrap" Foreground="{DynamicResource AlAtmani.TextSecondaryBrush}" FontSize="13" LineHeight="18"/>
                        </StackPanel>
                    </materialDesign:Card>
                </UniformGrid>

                <!-- Technical Architecture Card -->
                <materialDesign:Card Padding="24" Margin="0,0,0,28" Style="{StaticResource AlAtmani.GlassCard}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc_f0df6179}" FontSize="20" FontWeight="Bold" Margin="0,0,0,16" Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="{DynamicResource Loc_a1754f6c}" Margin="0,5" FontSize="13.5" Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}"/>
                                <TextBlock Text="{DynamicResource Loc_64f9e26b}" Margin="0,5" FontSize="13.5" Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}"/>
                                <TextBlock Text="{DynamicResource Loc_eb2c16ed}" Margin="0,5" FontSize="13.5" Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}"/>
                                <TextBlock Text="{DynamicResource Loc_ed247d33}" Margin="0,5" FontSize="13.5" Foreground="{DynamicResource AlAtmani.AccentBrush}"/>
                                <TextBlock Text="{DynamicResource Loc_e704670f}" Margin="0,5" FontSize="13.5" Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{DynamicResource Loc_85981058}" Margin="0,5" FontSize="13.5" Foreground="{DynamicResource AlAtmani.AccentBrush}"/>
                                <TextBlock Text="{DynamicResource Loc_91f9faea}" Margin="0,5" FontSize="13.5" Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}"/>
                                <TextBlock Text="{DynamicResource Loc_5801ab06}" Margin="0,5" FontSize="13.5" Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}"/>
                                <TextBlock Text="{DynamicResource Loc_d4815783}" Margin="0,5" FontSize="13.5" Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}"/>
                                <TextBlock Text="{DynamicResource Loc_6a1cfbe6}" Margin="0,5" FontSize="13.5" Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Professional User Manual & Shortcuts Guide -->
                <materialDesign:Card Padding="24" Margin="0,0,0,24" Style="{StaticResource AlAtmani.GlassCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <materialDesign:PackIcon Kind="BookOpenPageVariant" Width="28" Height="28" Foreground="{DynamicResource AlAtmani.AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{DynamicResource Loc_46115950}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Shortcuts Grid -->
                        <Border Background="{DynamicResource AlAtmani.Surface2Brush}" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Shortcut 1 -->
                                <Border Background="{DynamicResource AlAtmani.AccentBrush}" CornerRadius="6" Padding="8,3" Margin="0,4,12,4" Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="F1" FontWeight="Bold" Foreground="White"/>
                                </Border>
                                <TextBlock Text="{DynamicResource Loc_96d924a7}" VerticalAlignment="Center" Grid.Row="0" Grid.Column="1" Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}" Margin="0,0,16,0"/>

                                <!-- Shortcut 2 -->

                                </Border>
                                <TextBlock Text="{DynamicResource Loc_236e1a3d}" VerticalAlignment="Center" Grid.Row="2" Grid.Column="1" Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}" Margin="0,0,16,0"/>

                                <!-- Shortcut 6 -->
                                <Border Background="{DynamicResource AlAtmani.SurfaceBrush}" BorderBrush="{DynamicResource AlAtmani.BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,4,12,4" Grid.Row="2" Grid.Column="2">
                                    <TextBlock Text="-" FontWeight="Bold" Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}"/>
                                </Border>
                                <TextBlock Text="{DynamicResource Loc_21e4f0a5}" VerticalAlignment="Center" Grid.Row="2" Grid.Column="3" Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}"/>

                                <!-- Shortcut 7 -->
                                <Border Background="#EF4444" CornerRadius="6" Padding="8,3" Margin="0,4,12,4" Grid.Row="3" Grid.Column="0">
                                    <TextBlock Text="Del" FontWeight="Bold" Foreground="White"/>
                                </Border>
                                <TextBlock Text="{DynamicResource Loc_ef7dc4f2}" VerticalAlignment="Center" Grid.Row="3" Grid.Column="1" Foreground="{DynamicResource AlAtmani.TextPrimaryBrush}" Margin="0,0,16,0"/>

                                <!-- Shortcut 8 -->

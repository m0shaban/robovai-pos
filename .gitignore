## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Executables and large binaries
*.exe
*.dll
*.pdb
publish-linux/
publish/
dist/
installer/Output/
installer/*.exe

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
node_modules/
_Backups/
scratch/
TestLC/
*.log

# Visual Studio cache/options directory
.vs/

# NuGet Packages
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/

# Database files
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Rider
.idea/

# User-specific files
*.rsuser

# Auto Generated Files
StyleCopReport.xml

# Windows image file caches
Thumbs.db
ehthumbs.db

# Recycle Bin
$RECYCLE.BIN/

# VS Code
.vscode/

# Added by code-review-graph
.code-review-graph/
